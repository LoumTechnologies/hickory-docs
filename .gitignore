/target
node_modules/
dist/
dist-site/
.env
.env.*
!.env.example
.hick-cache/
*.t
*.t.err
.DS_Store
*.tsbuildinfo
.dev/
.dev-env.local
# A local scratch directory, anchored to the repository root. It used to be
# the unanchored `data/`, which matches at ANY depth — and so silently
# swallowed `examples/receipts/*/data/`, the export two shipped example
# documents read. The result was an example that could not run on any clone:
# the same mistake `from=` made by building a durable claim on a gitignored
# artifact. Anchor the rule, or it ignores files you did not mean.
/data/

.claude/worktrees/

# Agent session transcripts from demo runs (records, not sources)
docs/todo-app/sessions/

# Terraform: provider binaries and any local state/plan artefacts. State lives
# in R2 and holds credentials; a stray local copy is a leak.
terraform/**/.terraform/
terraform/**/*.tfstate
terraform/**/*.tfstate.*
terraform/**/tfplan
terraform/**/plan.txt
terraform/**/.terraform.lock.hcl.bak

# Copied from scripts/install.sh by `just site` so the static site can serve
# it; the script itself is tracked once, at scripts/install.sh.
apps/web/public/install.sh

# Playwright MCP scratch output from browser-driven verification.
.playwright-mcp/
/apps/web/test-results/
/apps/web/playwright-report/

# The probes under experiments/ build in place; their Cargo.lock files are kept.
experiments/*/target/
experiments/*/*/target/

# Release archives staged for a VM run. Built by CI (or by hand) and copied to
# the paths vmkit.conf names; never a source file.
vmtest/.artifacts/

# .NET build output (code-models/)
**/obj/
**/bin/

# Code model servers: Node deps and Go build output
code-models/*/node_modules/
