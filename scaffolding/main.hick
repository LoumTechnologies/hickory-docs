<hick:cut id="gitignore-common"># IDE
.idea/
.vscode/
*.swp
*.swo
*~

# OS
.DS_Store
Thumbs.db

# Build outputs
dist/
build/
out/
</hick:cut>

<!-- ================================================================== -->
<!-- Root Project Files                                                 -->
<!-- ================================================================== -->

<hick:file path="LICENSE"><hick:paste select="#license-header" /></hick:file>

<hick:file path="README.md"># <hick:val name="project_name" />

A cross-platform application by <hick:val name="organization" />.

## Platforms

<hick:when test="swiftui">
### Apple Platforms (SwiftUI)
- iOS <hick:val name="min_ios_version" />+
- iPadOS <hick:val name="min_ios_version" />+
- macOS <hick:val name="min_ios_version" />+

```bash
cd apple
open <hick:val name="project_name" />.xcodeproj
```
</hick:when>
<hick:when test="compose">
### Android (Jetpack Compose)
- Minimum SDK: <hick:val name="min_android_sdk" />
- Target SDK: <hick:val name="target_android_sdk" />

```bash
cd android
./gradlew assembleDebug
```
</hick:when>
<hick:when test="avalonia">
### Desktop (Avalonia)
- Windows
- macOS
- Linux

```bash
cd desktop
dotnet run
```
</hick:when>
<hick:when test="spa">
### Web Application (React)

```bash
cd web
npm install
npm run dev
```
</hick:when>
<hick:when test="extension">
### Browser Extension

```bash
cd extension
npm install
npm run build
# Load dist/ as unpacked extension in your browser
```
</hick:when>
<hick:when test="backend">
### Backend (Rust)

```bash
cd backend
cargo run
```
</hick:when>

## License

MIT License - see [LICENSE](LICENSE) for details.
</hick:file>

<hick:file path=".gitignore"><hick:paste select="#gitignore-common" />
<hick:when test="swiftui">
# Apple
*.xcuserstate
xcuserdata/
DerivedData/
*.ipa
*.dSYM.zip
*.dSYM
</hick:when>
<hick:when test="compose">
# Android
*.apk
*.aab
*.ap_
local.properties
.gradle/
</hick:when>
<hick:when test="avalonia">
# .NET
bin/
obj/
*.user
*.suo
</hick:when>
<hick:when test="spa || extension">
# Node
node_modules/
.env.local
.env.*.local
</hick:when>
<hick:when test="backend">
# Rust
target/
Cargo.lock
</hick:when>
</hick:file>

</hick:doc>
