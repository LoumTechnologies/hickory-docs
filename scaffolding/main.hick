<?xml version="1.0" encoding="UTF-8"?>
<!--
  Cross-Platform Project Scaffolding

  This template generates a multi-platform project with:
  - SwiftUI (iOS, iPadOS, macOS)
  - Jetpack Compose (Android)
  - Avalonia (Windows, macOS, Linux)
  - React TypeScript SPA
  - Browser Extension (React TypeScript)
  - Rust Backend

  All platforms are hidden behind feature flags.

  Usage:
    hick --param project_name=MyApp --features swiftui,backend scaffolding/
    hick --param project_name=MyApp --features all scaffolding/
-->
<hick:doc xmlns:hick="http://www.hickorydocs.com/1.0">

<!-- ================================================================== -->
<!-- Variables                                                          -->
<!-- ================================================================== -->

<!-- Project metadata (can be overridden via --param) -->
<hick:var name="project_name">MyProject</hick:var>
<hick:var name="bundle_id">com.example.myproject</hick:var>
<hick:var name="organization">Example Inc</hick:var>
<hick:var name="min_ios_version">17.0</hick:var>
<hick:var name="min_android_sdk">26</hick:var>
<hick:var name="target_android_sdk">34</hick:var>
<hick:var name="dotnet_version">8.0</hick:var>
<hick:var name="rust_edition">2024</hick:var>
<hick:var name="node_version">20</hick:var>

<!-- ================================================================== -->
<!-- Feature Definitions                                                -->
<!-- ================================================================== -->

<!-- Core platform features -->
<hick:feature name="swiftui" description="SwiftUI app for iOS, iPadOS, and macOS" />
<hick:feature name="compose" description="Jetpack Compose app for Android" />
<hick:feature name="avalonia" description="Avalonia app for Windows, macOS, and Linux" />
<hick:feature name="spa" description="React TypeScript single-page application" />
<hick:feature name="extension" description="Browser extension with React TypeScript" />
<hick:feature name="backend" description="Rust backend API server" />

<!-- Convenience meta-feature -->
<hick:feature name="all" description="Enable all platforms" requires="swiftui compose avalonia spa extension backend" />

<!-- Platform groupings -->
<hick:feature name="mobile" description="Mobile platforms" requires="swiftui compose" />
<hick:feature name="desktop" description="Desktop platforms" requires="swiftui avalonia" />
<hick:feature name="web" description="Web platforms" requires="spa extension" />

<!-- ================================================================== -->
<!-- Substitution Rules                                                 -->
<!-- ================================================================== -->

<!-- Project name substitution with case variants -->
<hick:substitute name="project_name" pattern="MyProject" value="{{project_name}}" variants="true" />

<!-- ================================================================== -->
<!-- Shared Content Blocks                                              -->
<!-- ================================================================== -->

<hick:cut id="license-header">MIT License

