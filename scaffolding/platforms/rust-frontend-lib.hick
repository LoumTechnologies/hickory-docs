<hick:when test="decentralized-auth && iroh">
### Iroh + Auth Integration

When both `decentralized-auth` and `iroh` features are enabled, this module provides
additional integration for P2P peer authentication using Iroh's node identity.

<hick:file path="rust-lib/src/auth_iroh.rs">//! Iroh integration for decentralized authentication
//!
//! When both `decentralized-auth` and `iroh` features are enabled, this module
//! provides integration between Iroh's node identity and the auth system.

use std::sync::Arc;
use crate::auth::{Identity, AuthError, AuthTokenClaims, VerifiedToken, generate_challenge, verify_auth_token};
use crate::networking::{IrohNode, IrohError};

/// An authenticated peer connection
#[derive(Debug, Clone)]
pub struct AuthenticatedPeer {
    pub peer_did: String,
    pub peer_node_id: String,
    pub capabilities: Vec<String>,
}

/// Create an Identity from an Iroh node's secret key
///
/// This reuses Iroh's ed25519 key for authentication, ensuring the node ID
/// and DID are cryptographically linked.
pub fn identity_from_iroh_node(node: &IrohNode) -> Result<Arc<Identity>, AuthError> {
    // Iroh uses ed25519, same as our auth system
    // We need to extract the secret key from the node
    // Note: This requires the IrohNode to expose its secret key
    let secret_key_bytes = node.secret_key_bytes()
        .ok_or_else(|| AuthError::InvalidKey("Cannot extract secret key from Iroh node".to_string()))?;

    crate::auth::load_identity_from_bytes(secret_key_bytes)
}

/// Authenticate a remote peer using challenge-response
///
/// This performs a challenge-response authentication with a remote peer
/// over Iroh's QUIC connection, verifying their identity.
pub fn authenticate_peer(
    node: &IrohNode,
    identity: &Identity,
    peer_node_id: String,
) -> Result<AuthenticatedPeer, AuthError> {
    // Generate a challenge
    let challenge = generate_challenge();

    // Send challenge to peer via Iroh
    let alpn = "<hick:val name="project_name" />/auth/1";

    // Create challenge request
    let request = serde_json::json!({
        "type": "challenge",
        "challenge": challenge,
        "requester_did": identity.did(),
    });

    let request_bytes = serde_json::to_vec(&request)
        .map_err(|e| AuthError::SignatureFailed(e.to_string()))?;

    // Send challenge and wait for response
    // Note: This is a simplified implementation. In production, you'd want
    // proper bidirectional communication with timeout handling.
    node.send(peer_node_id.clone(), alpn.to_string(), request_bytes)
        .map_err(|e| match e {
            IrohError::ConnectionFailed(s) => AuthError::VerificationFailed(s),
            IrohError::SendFailed(s) => AuthError::VerificationFailed(s),
            _ => AuthError::VerificationFailed(e.to_string()),
        })?;

    // In a real implementation, you would:
    // 1. Wait for the peer's signed response
    // 2. Verify the signature against the challenge
    // 3. Extract the peer's DID and capabilities from their token

    // For now, return a placeholder indicating authentication was initiated
    // The actual verification would happen asynchronously
    Ok(AuthenticatedPeer {
        peer_did: format!("pending:challenge:{}", peer_node_id),
        peer_node_id,
        capabilities: vec![],
    })
}

/// Verify an authentication request from a peer
///
/// Call this when receiving a challenge request from a remote peer.
pub fn respond_to_auth_challenge(
    identity: &Identity,
    challenge: String,
    capabilities: Vec<String>,
) -> Result<String, AuthError> {
    // Create a short-lived token as the response
    let claims = AuthTokenClaims {
        audience: None,
        subject: Some(challenge), // Include the challenge as subject for binding
        expires_at: crate::auth::current_timestamp_pub() + 60, // 1 minute validity
        capabilities,
    };

    identity.create_token(claims)
}

/// Verify a peer's authentication response
pub fn verify_peer_response(
    expected_challenge: String,
    response_token: String,
) -> Result<AuthenticatedPeer, AuthError> {
    // Verify the token
    let verified = verify_auth_token(response_token, None)?;

    // Check that the challenge matches
    if verified.subject != Some(expected_challenge) {
        return Err(AuthError::VerificationFailed("Challenge mismatch".to_string()));
    }

    // Extract node ID from DID (the last part after the multicodec prefix)
    // In a real implementation, you'd map DIDs to node IDs properly
    let peer_node_id = did_to_node_id_hint(&verified.issuer);

    Ok(AuthenticatedPeer {
        peer_did: verified.issuer,
        peer_node_id,
        capabilities: verified.capabilities,
    })
}

/// Extract a hint for the node ID from a DID
/// This is a best-effort mapping; proper verification requires the actual node ID
fn did_to_node_id_hint(did: &str) -> String {
    // DIDs and Iroh node IDs both use ed25519, but have different encodings
    // This extracts the base58 portion as a hint
    if did.starts_with("did:key:z") {
        did[9..].to_string() // Skip "did:key:z"
    } else {
        did.to_string()
    }
}

#[cfg(test)]
mod tests {
    use super::*;
    use crate::auth::create_identity;

    #[test]
    fn test_challenge_response_flow() {
        let identity = create_identity().expect("should create identity");
        let challenge = generate_challenge();

        // Simulate responding to a challenge
        let response = respond_to_auth_challenge(
            &identity,
            challenge.clone(),
            vec!["read".to_string()],
        ).expect("should create response");

        // Verify the response
        let peer = verify_peer_response(challenge, response)
            .expect("should verify response");

        assert_eq!(peer.peer_did, identity.did());
        assert_eq!(peer.capabilities, vec!["read"]);
    }
}
