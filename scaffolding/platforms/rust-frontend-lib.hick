### Core Library Implementation

The main library file contains the shared business logic. Functions are exposed to both
WASM (via wasm-bindgen) and native platforms (via UniFFI):

<hick:file path="rust-lib/src/lib.rs">//! <hick:val name="project_name" /> Core Library
//!
//! Shared business logic that compiles to WebAssembly and native FFI bindings.

mod error;
<hick:when test="sqlite">mod database;
</hick:when>
<hick:when test="iroh">#[cfg(not(target_arch = "wasm32"))]
mod networking;
</hick:when>
<hick:when test="decentralized-auth">mod auth;
</hick:when>
pub use error::CoreError;
<hick:when test="sqlite">pub use database::{Database, DatabaseError, TodoItem, open_database};
</hick:when>
<hick:when test="iroh">#[cfg(not(target_arch = "wasm32"))]
pub use networking::{IrohNode, IrohError, NodeInfo, create_iroh_node, get_node_id};
</hick:when>
<hick:when test="decentralized-auth">pub use auth::{
    Identity, AuthError, AuthTokenClaims, VerifiedToken,
    create_identity, load_identity, load_or_create_identity, save_identity,
    verify_auth_token, generate_challenge, verify_challenge,
};
</hick:when>
<hick:when test="decentralized-auth && iroh">#[cfg(not(target_arch = "wasm32"))]
mod auth_iroh;
#[cfg(not(target_arch = "wasm32"))]
pub use auth_iroh::{
    AuthenticatedPeer, identity_from_iroh_node, authenticate_peer,
    respond_to_auth_challenge, verify_peer_response,
};
</hick:when>

use serde::{Deserialize, Serialize};

// Include UniFFI scaffolding for native targets
#[cfg(not(target_arch = "wasm32"))]
uniffi::include_scaffolding!("core");

// WASM bindings
#[cfg(target_arch = "wasm32")]
use wasm_bindgen::prelude::*;

/// Result type for greeting operations
#[derive(Debug, Clone, Serialize, Deserialize)]
pub struct GreetingResult {
    pub message: String,
    pub timestamp: u64,
}

/// Generate a personalized greeting
///
/// # Arguments
/// * `name` - The name to greet
///
/// # Returns
/// A greeting string
#[cfg_attr(target_arch = "wasm32", wasm_bindgen)]
pub fn greet(name: String) -> String {
    if name.is_empty() {
        "Hello, World!".to_string()
    } else {
        format!("Hello, {}!", name)
    }
}

/// Calculate the nth Fibonacci number
///
/// Uses an iterative approach for efficiency.
///
/// # Arguments
/// * `n` - The index of the Fibonacci number to calculate
///
/// # Returns
/// The nth Fibonacci number
#[cfg_attr(target_arch = "wasm32", wasm_bindgen)]
pub fn fibonacci(n: u32) -> u64 {
    match n {
        0 => 0,
        1 => 1,
        _ => {
            let mut a = 0u64;
            let mut b = 1u64;
            for _ in 2..=n {
                let temp = a + b;
                a = b;
                b = temp;
            }
            b
        }
    }
}

/// Process JSON input and return transformed JSON output
///
/// This demonstrates more complex data handling across the FFI boundary.
///
/// # Arguments
/// * `json_input` - A JSON string containing input data
///
/// # Returns
/// A JSON string with processed results
#[cfg_attr(target_arch = "wasm32", wasm_bindgen)]
pub fn process_data(json_input: String) -> String {
    let json_input = json_input.as_str();
    #[derive(Deserialize)]
    struct Input {
        values: Vec<i32>,
    }

    #[derive(Serialize)]
    struct Output {
        sum: i64,
        count: usize,
        average: f64,
        sorted: Vec<i32>,
    }

    let result: Result<Output, serde_json::Error> = (|| {
        let input: Input = serde_json::from_str(json_input)?;
        let sum: i64 = input.values.iter().map(|&x| x as i64).sum();
        let count = input.values.len();
        let average = if count > 0 {
            sum as f64 / count as f64
        } else {
            0.0
        };
        let mut sorted = input.values.clone();
        sorted.sort();

        Ok(Output {
            sum,
            count,
            average,
            sorted,
        })
    })();

    match result {
        Ok(output) => serde_json::to_string(&output).unwrap_or_else(|_| "{}".to_string()),
        Err(_) => r#"{"error": "Failed to process input"}"#.to_string(),
    }
}

#[cfg(test)]
mod tests {
    use super::*;

    #[test]
    fn test_greet_with_name() {
        assert_eq!(greet("Alice".to_string()), "Hello, Alice!");
    }

    #[test]
    fn test_greet_empty_name() {
        assert_eq!(greet(String::new()), "Hello, World!");
    }

    #[test]
    fn test_fibonacci() {
        assert_eq!(fibonacci(0), 0);
        assert_eq!(fibonacci(1), 1);
        assert_eq!(fibonacci(10), 55);
        assert_eq!(fibonacci(20), 6765);
    }

    #[test]
    fn test_process_data() {
        let input = r#"{"values": [3, 1, 4, 1, 5, 9, 2, 6]}"#.to_string();
        let output = process_data(input);
        let parsed: serde_json::Value = serde_json::from_str(&output).unwrap();

        assert_eq!(parsed["sum"], 31);
        assert_eq!(parsed["count"], 8);
        assert_eq!(parsed["sorted"], serde_json::json!([1, 1, 2, 3, 4, 5, 6, 9]));
    }
}
</hick:file>

### Error Types

Error handling that works across FFI boundaries:

<hick:file path="rust-lib/src/error.rs">//! Error types for the core library

use thiserror::Error;

/// Errors that can occur in core library operations
#[derive(Error, Debug)]
pub enum CoreError {
    #[error("Invalid input: {0}")]
    InvalidInput(String),

    #[error("Processing failed: {0}")]
    ProcessingFailed(String),
}
</hick:file>

<hick:when test="sqlite">
### Database Module

The database module provides SQLite-backed storage for all platforms:
- Native: Uses rusqlite with bundled SQLite
- WASM: Uses sqlite-wasm-rs with precompiled SQLite for WebAssembly

<hick:file path="rust-lib/src/database.rs">//! Database module with SQLite support for all platforms
//!
//! - Native: Uses rusqlite with bundled SQLite
//! - WASM: Uses sqlite-wasm-rs with precompiled SQLite

use serde::{Deserialize, Serialize};
use thiserror::Error;
use uuid::Uuid;
use chrono::Utc;
use std::sync::Arc;

#[cfg(not(target_arch = "wasm32"))]
use rusqlite::{Connection, params};
#[cfg(not(target_arch = "wasm32"))]
use std::sync::Mutex;

#[cfg(target_arch = "wasm32")]
use sqlite_wasm_rs as ffi;
#[cfg(target_arch = "wasm32")]
use std::ffi::CString;
#[cfg(target_arch = "wasm32")]
use std::cell::RefCell;

/// Database errors
#[derive(Error, Debug)]
pub enum DatabaseError {
    #[error("Connection failed: {0}")]
    ConnectionFailed(String),

    #[error("Query failed: {0}")]
    QueryFailed(String),

    #[error("Not found")]
    NotFound,

    #[error("Invalid data: {0}")]
    InvalidData(String),
}

/// A todo item stored in the database
#[derive(Debug, Clone, Serialize, Deserialize)]
pub struct TodoItem {
    pub id: String,
    pub title: String,
    pub completed: bool,
    pub created_at: String,
}

// ============================================================================
// Native Implementation (SQLite)
// ============================================================================

#[cfg(not(target_arch = "wasm32"))]
pub struct Database {
    conn: Arc<Mutex<Connection>>,
}

#[cfg(not(target_arch = "wasm32"))]
impl Database {
    fn new(conn: Connection) -> Self {
        Self {
            conn: Arc::new(Mutex::new(conn)),
        }
    }

    /// Create a new todo item (returns JSON string)
    pub fn create_todo(&self, title: String) -> Result<String, DatabaseError> {
        let id = Uuid::new_v4().to_string();
        let created_at = Utc::now().to_rfc3339();

        let conn = self.conn.lock().map_err(|e| DatabaseError::QueryFailed(e.to_string()))?;
        conn.execute(
            "INSERT INTO todos (id, title, completed, created_at) VALUES (?1, ?2, ?3, ?4)",
            params![id, title, false, created_at],
        ).map_err(|e| DatabaseError::QueryFailed(e.to_string()))?;

        let item = TodoItem {
            id,
            title,
            completed: false,
            created_at,
        };
        serde_json::to_string(&item).map_err(|e| DatabaseError::InvalidData(e.to_string()))
    }

    /// List all todos (returns JSON array string)
    pub fn list_todos(&self) -> Result<String, DatabaseError> {
        let conn = self.conn.lock().map_err(|e| DatabaseError::QueryFailed(e.to_string()))?;
        let mut stmt = conn
            .prepare("SELECT id, title, completed, created_at FROM todos ORDER BY created_at DESC")
            .map_err(|e| DatabaseError::QueryFailed(e.to_string()))?;

        let rows = stmt
            .query_map([], |row| {
                Ok(TodoItem {
                    id: row.get(0)?,
                    title: row.get(1)?,
                    completed: row.get(2)?,
                    created_at: row.get(3)?,
                })
            })
            .map_err(|e| DatabaseError::QueryFailed(e.to_string()))?;

        let mut todos = Vec::new();
        for row in rows {
            todos.push(row.map_err(|e| DatabaseError::QueryFailed(e.to_string()))?);
        }
        serde_json::to_string(&todos).map_err(|e| DatabaseError::InvalidData(e.to_string()))
    }

    /// Get a specific todo by ID (returns JSON string or None)
    pub fn get_todo(&self, id: String) -> Result<Option<String>, DatabaseError> {
        let conn = self.conn.lock().map_err(|e| DatabaseError::QueryFailed(e.to_string()))?;
        let mut stmt = conn
            .prepare("SELECT id, title, completed, created_at FROM todos WHERE id = ?1")
            .map_err(|e| DatabaseError::QueryFailed(e.to_string()))?;

        let mut rows = stmt
            .query_map(params![id], |row| {
                Ok(TodoItem {
                    id: row.get(0)?,
                    title: row.get(1)?,
                    completed: row.get(2)?,
                    created_at: row.get(3)?,
                })
            })
            .map_err(|e| DatabaseError::QueryFailed(e.to_string()))?;

        match rows.next() {
            Some(row) => {
                let item = row.map_err(|e| DatabaseError::QueryFailed(e.to_string()))?;
                let json = serde_json::to_string(&item).map_err(|e| DatabaseError::InvalidData(e.to_string()))?;
                Ok(Some(json))
            },
            None => Ok(None),
        }
    }

    /// Internal: Get a specific todo by ID as struct (for update operations)
    fn get_todo_internal(&self, id: String) -> Result<Option<TodoItem>, DatabaseError> {
        let conn = self.conn.lock().map_err(|e| DatabaseError::QueryFailed(e.to_string()))?;
        let mut stmt = conn
            .prepare("SELECT id, title, completed, created_at FROM todos WHERE id = ?1")
            .map_err(|e| DatabaseError::QueryFailed(e.to_string()))?;

        let mut rows = stmt
            .query_map(params![id], |row| {
                Ok(TodoItem {
                    id: row.get(0)?,
                    title: row.get(1)?,
                    completed: row.get(2)?,
                    created_at: row.get(3)?,
                })
            })
            .map_err(|e| DatabaseError::QueryFailed(e.to_string()))?;

        match rows.next() {
            Some(row) => Ok(Some(row.map_err(|e| DatabaseError::QueryFailed(e.to_string()))?)),
            None => Ok(None),
        }
    }

    /// Update a todo item (returns JSON string)
    pub fn update_todo(
        &self,
        id: String,
        title: Option<String>,
        completed: Option<bool>,
    ) -> Result<String, DatabaseError> {
        let existing = self.get_todo_internal(id.clone())?.ok_or(DatabaseError::NotFound)?;

        let new_title = title.unwrap_or(existing.title);
        let new_completed = completed.unwrap_or(existing.completed);

        let conn = self.conn.lock().map_err(|e| DatabaseError::QueryFailed(e.to_string()))?;
        conn.execute(
            "UPDATE todos SET title = ?1, completed = ?2 WHERE id = ?3",
            params![new_title, new_completed, id],
        ).map_err(|e| DatabaseError::QueryFailed(e.to_string()))?;

        let item = TodoItem {
            id,
            title: new_title,
            completed: new_completed,
            created_at: existing.created_at,
        };
        serde_json::to_string(&item).map_err(|e| DatabaseError::InvalidData(e.to_string()))
    }

    /// Delete a todo item
    pub fn delete_todo(&self, id: String) -> Result<(), DatabaseError> {
        let conn = self.conn.lock().map_err(|e| DatabaseError::QueryFailed(e.to_string()))?;
        let rows = conn
            .execute("DELETE FROM todos WHERE id = ?1", params![id])
            .map_err(|e| DatabaseError::QueryFailed(e.to_string()))?;

        if rows == 0 {
            return Err(DatabaseError::NotFound);
        }
        Ok(())
    }

    /// Close the database connection
    pub fn close(&self) {
        // Connection is closed when dropped
    }
}

/// Open a database connection
#[cfg(not(target_arch = "wasm32"))]
pub fn open_database(path: String) -> Result<Arc<Database>, DatabaseError> {
    let conn = Connection::open(&path)
        .map_err(|e| DatabaseError::ConnectionFailed(e.to_string()))?;

    // Create tables if they don't exist
    conn.execute(
        "CREATE TABLE IF NOT EXISTS todos (
            id TEXT PRIMARY KEY,
            title TEXT NOT NULL,
            completed INTEGER NOT NULL DEFAULT 0,
            created_at TEXT NOT NULL
        )",
        [],
    ).map_err(|e| DatabaseError::QueryFailed(e.to_string()))?;

    Ok(Arc::new(Database::new(conn)))
}

// ============================================================================
// WASM Implementation (sqlite-wasm-rs)
// ============================================================================

#[cfg(target_arch = "wasm32")]
pub struct Database {
    db: RefCell<*mut ffi::sqlite3>,
}

// Safety: Database is only used single-threaded in WASM
#[cfg(target_arch = "wasm32")]
unsafe impl Send for Database {}
#[cfg(target_arch = "wasm32")]
unsafe impl Sync for Database {}

#[cfg(target_arch = "wasm32")]
impl Database {
    fn new(db: *mut ffi::sqlite3) -> Self {
        Self { db: RefCell::new(db) }
    }

    fn exec(&self, sql: &str) -> Result<(), DatabaseError> {
        let c_sql = CString::new(sql).map_err(|e| DatabaseError::InvalidData(e.to_string()))?;
        let db = *self.db.borrow();
        let ret = unsafe {
            ffi::sqlite3_exec(db, c_sql.as_ptr(), None, std::ptr::null_mut(), std::ptr::null_mut())
        };
        if ret != ffi::SQLITE_OK {
            return Err(DatabaseError::QueryFailed(format!("sqlite error: {}", ret)));
        }
        Ok(())
    }

    pub fn create_todo(&self, title: String) -> Result<String, DatabaseError> {
        let id = Uuid::new_v4().to_string();
        let created_at = Utc::now().to_rfc3339();

        let sql = format!(
            "INSERT INTO todos (id, title, completed, created_at) VALUES ('{}', '{}', 0, '{}')",
            id.replace("'", "''"),
            title.replace("'", "''"),
            created_at.replace("'", "''")
        );
        self.exec(&sql)?;

        let item = TodoItem {
            id,
            title,
            completed: false,
            created_at,
        };
        serde_json::to_string(&item).map_err(|e| DatabaseError::InvalidData(e.to_string()))
    }

    pub fn list_todos(&self) -> Result<String, DatabaseError> {
        let db = *self.db.borrow();
        let sql = CString::new("SELECT id, title, completed, created_at FROM todos ORDER BY created_at DESC")
            .map_err(|e| DatabaseError::InvalidData(e.to_string()))?;

        let mut stmt: *mut ffi::sqlite3_stmt = std::ptr::null_mut();
        let ret = unsafe {
            ffi::sqlite3_prepare_v2(db, sql.as_ptr(), -1, &mut stmt, std::ptr::null_mut())
        };
        if ret != ffi::SQLITE_OK {
            return Err(DatabaseError::QueryFailed(format!("prepare error: {}", ret)));
        }

        let mut todos = Vec::new();
        loop {
            let step = unsafe { ffi::sqlite3_step(stmt) };
            if step == ffi::SQLITE_DONE {
                break;
            }
            if step != ffi::SQLITE_ROW {
                unsafe { ffi::sqlite3_finalize(stmt); }
                return Err(DatabaseError::QueryFailed(format!("step error: {}", step)));
            }

            let id = unsafe {
                let ptr = ffi::sqlite3_column_text(stmt, 0);
                if ptr.is_null() { String::new() } else {
                    std::ffi::CStr::from_ptr(ptr as *const i8).to_string_lossy().into_owned()
                }
            };
            let title = unsafe {
                let ptr = ffi::sqlite3_column_text(stmt, 1);
                if ptr.is_null() { String::new() } else {
                    std::ffi::CStr::from_ptr(ptr as *const i8).to_string_lossy().into_owned()
                }
            };
            let completed = unsafe { ffi::sqlite3_column_int(stmt, 2) != 0 };
            let created_at = unsafe {
                let ptr = ffi::sqlite3_column_text(stmt, 3);
                if ptr.is_null() { String::new() } else {
                    std::ffi::CStr::from_ptr(ptr as *const i8).to_string_lossy().into_owned()
                }
            };

            todos.push(TodoItem { id, title, completed, created_at });
        }
        unsafe { ffi::sqlite3_finalize(stmt); }

        serde_json::to_string(&todos).map_err(|e| DatabaseError::InvalidData(e.to_string()))
    }

    pub fn get_todo(&self, id: String) -> Result<Option<String>, DatabaseError> {
        let db = *self.db.borrow();
        let sql = CString::new("SELECT id, title, completed, created_at FROM todos WHERE id = ?")
            .map_err(|e| DatabaseError::InvalidData(e.to_string()))?;

        let mut stmt: *mut ffi::sqlite3_stmt = std::ptr::null_mut();
        let ret = unsafe {
            ffi::sqlite3_prepare_v2(db, sql.as_ptr(), -1, &mut stmt, std::ptr::null_mut())
        };
        if ret != ffi::SQLITE_OK {
            return Err(DatabaseError::QueryFailed(format!("prepare error: {}", ret)));
        }

        let c_id = CString::new(id).map_err(|e| DatabaseError::InvalidData(e.to_string()))?;
        unsafe { ffi::sqlite3_bind_text(stmt, 1, c_id.as_ptr(), -1, ffi::SQLITE_TRANSIENT()); }

        let step = unsafe { ffi::sqlite3_step(stmt) };
        if step == ffi::SQLITE_DONE {
            unsafe { ffi::sqlite3_finalize(stmt); }
            return Ok(None);
        }
        if step != ffi::SQLITE_ROW {
            unsafe { ffi::sqlite3_finalize(stmt); }
            return Err(DatabaseError::QueryFailed(format!("step error: {}", step)));
        }

        let item = TodoItem {
            id: unsafe {
                let ptr = ffi::sqlite3_column_text(stmt, 0);
                if ptr.is_null() { String::new() } else {
                    std::ffi::CStr::from_ptr(ptr as *const i8).to_string_lossy().into_owned()
                }
            },
            title: unsafe {
                let ptr = ffi::sqlite3_column_text(stmt, 1);
                if ptr.is_null() { String::new() } else {
                    std::ffi::CStr::from_ptr(ptr as *const i8).to_string_lossy().into_owned()
                }
            },
            completed: unsafe { ffi::sqlite3_column_int(stmt, 2) != 0 },
            created_at: unsafe {
                let ptr = ffi::sqlite3_column_text(stmt, 3);
                if ptr.is_null() { String::new() } else {
                    std::ffi::CStr::from_ptr(ptr as *const i8).to_string_lossy().into_owned()
                }
            },
        };
        unsafe { ffi::sqlite3_finalize(stmt); }

        let json = serde_json::to_string(&item).map_err(|e| DatabaseError::InvalidData(e.to_string()))?;
        Ok(Some(json))
    }

    pub fn update_todo(
        &self,
        id: String,
        title: Option<String>,
        completed: Option<bool>,
    ) -> Result<String, DatabaseError> {
        // First get the existing todo
        let existing_json = self.get_todo(id.clone())?.ok_or(DatabaseError::NotFound)?;
        let existing: TodoItem = serde_json::from_str(&existing_json)
            .map_err(|e| DatabaseError::InvalidData(e.to_string()))?;

        let new_title = title.unwrap_or(existing.title);
        let new_completed = completed.unwrap_or(existing.completed);

        let sql = format!(
            "UPDATE todos SET title = '{}', completed = {} WHERE id = '{}'",
            new_title.replace("'", "''"),
            if new_completed { 1 } else { 0 },
            id.replace("'", "''")
        );
        self.exec(&sql)?;

        let item = TodoItem {
            id,
            title: new_title,
            completed: new_completed,
            created_at: existing.created_at,
        };
        serde_json::to_string(&item).map_err(|e| DatabaseError::InvalidData(e.to_string()))
    }

    pub fn delete_todo(&self, id: String) -> Result<(), DatabaseError> {
        let sql = format!("DELETE FROM todos WHERE id = '{}'", id.replace("'", "''"));
        self.exec(&sql)?;
        // Note: We don't check if the row existed, matching rusqlite behavior
        Ok(())
    }

    pub fn close(&self) {
        let db = *self.db.borrow();
        if !db.is_null() {
            unsafe { ffi::sqlite3_close(db); }
        }
    }
}

#[cfg(target_arch = "wasm32")]
impl Drop for Database {
    fn drop(&mut self) {
        self.close();
    }
}

#[cfg(target_arch = "wasm32")]
pub fn open_database(_path: String) -> Result<Arc<Database>, DatabaseError> {
    // WASM uses in-memory SQLite database
    let c_path = CString::new(":memory:").unwrap();
    let mut db: *mut ffi::sqlite3 = std::ptr::null_mut();

    let ret = unsafe {
        ffi::sqlite3_open_v2(
            c_path.as_ptr(),
            &mut db,
            ffi::SQLITE_OPEN_READWRITE | ffi::SQLITE_OPEN_CREATE,
            std::ptr::null()
        )
    };

    if ret != ffi::SQLITE_OK {
        return Err(DatabaseError::ConnectionFailed(format!("sqlite open error: {}", ret)));
    }

    let database = Database::new(db);

    // Create tables
    database.exec(
        "CREATE TABLE IF NOT EXISTS todos (
            id TEXT PRIMARY KEY,
            title TEXT NOT NULL,
            completed INTEGER NOT NULL DEFAULT 0,
            created_at TEXT NOT NULL
        )"
    )?;

    Ok(Arc::new(database))
}

#[cfg(test)]
mod tests {
    use super::*;

    #[test]
    fn test_todo_crud() {
        let db = open_database(":memory:".to_string()).unwrap();

        // Create
        let todo_json = db.create_todo("Test task".to_string()).unwrap();
        let todo: TodoItem = serde_json::from_str(&todo_json).unwrap();
        assert_eq!(todo.title, "Test task");
        assert!(!todo.completed);

        // Read
        let todos_json = db.list_todos().unwrap();
        let todos: Vec<TodoItem> = serde_json::from_str(&todos_json).unwrap();
        assert_eq!(todos.len(), 1);

        // Update
        let updated_json = db.update_todo(todo.id.clone(), None, Some(true)).unwrap();
        let updated: TodoItem = serde_json::from_str(&updated_json).unwrap();
        assert!(updated.completed);

        // Delete
        db.delete_todo(todo.id).unwrap();
        let todos_json = db.list_todos().unwrap();
        let todos: Vec<TodoItem> = serde_json::from_str(&todos_json).unwrap();
        assert_eq!(todos.len(), 0);
    }
}
</hick:file>
</hick:when>

<hick:when test="iroh">
### Networking Module (Iroh)

The networking module provides peer-to-peer connectivity using Iroh. This is only
available on native platforms (not WASM) due to Iroh's networking requirements.

<hick:file path="rust-lib/src/networking.rs">//! Iroh P2P networking module
//!
//! Provides peer-to-peer connectivity using Iroh for native platforms.
//! Iroh handles NAT traversal, hole punching, and relay fallback automatically.

use std::sync::Arc;
use thiserror::Error;
use iroh::{Endpoint, NodeAddr, NodeId, SecretKey};
use iroh_base::key::PublicKey;
use tokio::runtime::Runtime;
use std::str::FromStr;

/// Errors that can occur in Iroh networking operations
#[derive(Error, Debug)]
pub enum IrohError {
    #[error("Initialization failed: {0}")]
    InitFailed(String),

    #[error("Connection failed: {0}")]
    ConnectionFailed(String),

    #[error("Invalid node ID: {0}")]
    InvalidNodeId(String),

    #[error("Send failed: {0}")]
    SendFailed(String),

    #[error("Receive failed: {0}")]
    ReceiveFailed(String),
}

/// Information about a node for sharing with peers
#[derive(Debug, Clone)]
pub struct NodeInfo {
    pub node_id: String,
    pub relay_url: Option<String>,
    pub direct_addresses: Vec<String>,
}

/// An Iroh networking node
pub struct IrohNode {
    endpoint: Endpoint,
    runtime: Arc<Runtime>,
    secret_key: SecretKey,
}

impl IrohNode {
    /// Get this node's public identifier (NodeId)
    pub fn node_id(&self) -> String {
        self.endpoint.node_id().to_string()
    }

    /// Get the relay URL this node is connected to
    pub fn relay_url(&self) -> Option<String> {
        self.runtime.block_on(async {
            self.endpoint.home_relay().map(|url| url.to_string())
        })
    }

    /// Get node addressing info for sharing with peers
    pub fn node_info(&self) -> Result<NodeInfo, IrohError> {
        self.runtime.block_on(async {
            let node_addr = self.endpoint.node_addr().await
                .map_err(|e| IrohError::InitFailed(e.to_string()))?;

            Ok(NodeInfo {
                node_id: node_addr.node_id.to_string(),
                relay_url: node_addr.relay_url.map(|u| u.to_string()),
                direct_addresses: node_addr.direct_addresses
                    .iter()
                    .map(|a| a.to_string())
                    .collect(),
            })
        })
    }

    /// Connect to a peer by their node ID
    pub fn connect(&self, node_id: String, relay_url: Option<String>) -> Result<(), IrohError> {
        let node_id = NodeId::from_str(&node_id)
            .map_err(|e| IrohError::InvalidNodeId(e.to_string()))?;

        let relay_url = relay_url
            .map(|url| url.parse())
            .transpose()
            .map_err(|e: url::ParseError| IrohError::ConnectionFailed(e.to_string()))?;

        let node_addr = NodeAddr {
            node_id,
            relay_url,
            direct_addresses: Default::default(),
        };

        self.runtime.block_on(async {
            // Use a default ALPN for the connection
            let alpn = b"<hick:val name="project_name" />/1";
            self.endpoint.connect(node_addr, alpn)
                .await
                .map_err(|e| IrohError::ConnectionFailed(e.to_string()))?;
            Ok(())
        })
    }

    /// Send data to a connected peer
    pub fn send(&self, node_id: String, alpn: String, data: Vec<u8>) -> Result<(), IrohError> {
        let node_id = NodeId::from_str(&node_id)
            .map_err(|e| IrohError::InvalidNodeId(e.to_string()))?;

        let node_addr = NodeAddr {
            node_id,
            relay_url: None,
            direct_addresses: Default::default(),
        };

        self.runtime.block_on(async {
            let conn = self.endpoint.connect(node_addr, alpn.as_bytes())
                .await
                .map_err(|e| IrohError::ConnectionFailed(e.to_string()))?;

            let mut send_stream = conn.open_uni()
                .await
                .map_err(|e| IrohError::SendFailed(e.to_string()))?;

            send_stream.write_all(&data)
                .await
                .map_err(|e| IrohError::SendFailed(e.to_string()))?;

            send_stream.finish()
                .map_err(|e| IrohError::SendFailed(e.to_string()))?;

            Ok(())
        })
    }

    /// Shutdown the node
    pub fn shutdown(&self) {
        self.runtime.block_on(async {
            self.endpoint.close().await;
        });
    }

    /// Get the secret key bytes (for auth integration)
    /// Returns None if the key cannot be extracted
    pub fn secret_key_bytes(&self) -> Option<[u8; 32]> {
        Some(self.secret_key.to_bytes())
    }
}

/// Create a new Iroh node
///
/// # Arguments
/// * `relay_url` - Optional custom relay server URL. If None, uses Iroh's default relays.
pub fn create_iroh_node(relay_url: Option<String>) -> Result<Arc<IrohNode>, IrohError> {
    let runtime = Runtime::new()
        .map_err(|e| IrohError::InitFailed(e.to_string()))?;

    let secret_key = SecretKey::generate(rand::rngs::OsRng);

    let endpoint = runtime.block_on(async {
        let mut builder = Endpoint::builder()
            .secret_key(secret_key.clone());

        // If a custom relay URL is provided, configure it
        if let Some(url) = relay_url {
            let relay_url: iroh::RelayUrl = url.parse()
                .map_err(|e: url::ParseError| IrohError::InitFailed(e.to_string()))?;
            builder = builder.relay_mode(iroh::RelayMode::Custom(
                iroh::RelayMap::from_iter([iroh::RelayNode {
                    url: relay_url,
                    quic: None,
                }])
            ));
        }

        builder.bind()
            .await
            .map_err(|e| IrohError::InitFailed(e.to_string()))
    })?;

    Ok(Arc::new(IrohNode {
        endpoint,
        runtime: Arc::new(runtime),
        secret_key,
    }))
}

/// Get the node ID from an IrohNode (convenience function for FFI)
pub fn get_node_id(node: &IrohNode) -> String {
    node.node_id()
}

#[cfg(test)]
mod tests {
    use super::*;

    #[test]
    fn test_create_node() {
        let node = create_iroh_node(None).expect("should create node");
        let node_id = node.node_id();
        assert!(!node_id.is_empty());
        node.shutdown();
    }

    #[test]
    fn test_node_info() {
        let node = create_iroh_node(None).expect("should create node");
        let info = node.node_info().expect("should get node info");
        assert!(!info.node_id.is_empty());
        node.shutdown();
    }
}
</hick:file>
</hick:when>

<hick:when test="decentralized-auth">
### Authentication Module

The auth module provides decentralized identity and authentication using ed25519 key pairs:
- Generate identity key pairs
- Sign and verify arbitrary data
- Create and verify JWT-like auth tokens
- DID-compatible identifiers (`did:key:z6Mk...`)
- Challenge-response authentication
- Encrypted key storage with age (native) or localStorage (WASM)

<hick:file path="rust-lib/src/auth.rs">//! Decentralized authentication module
//!
//! Provides offline-first, peer-to-peer authentication using Ed25519 key pairs.
//! Supports both native platforms (with age-encrypted storage) and WASM
//! (with localStorage).

use serde::{Deserialize, Serialize};
use thiserror::Error;
use std::sync::Arc;
use ed25519_dalek::{SigningKey, VerifyingKey, Signature, Signer, Verifier};

#[cfg(not(target_arch = "wasm32"))]
use std::io::{Read, Write};
#[cfg(not(target_arch = "wasm32"))]
use std::fs;
#[cfg(not(target_arch = "wasm32"))]
use directories::ProjectDirs;

#[cfg(target_arch = "wasm32")]
use wasm_bindgen::prelude::*;

/// Errors that can occur in authentication operations
#[derive(Error, Debug)]
pub enum AuthError {
    #[error("Key generation failed: {0}")]
    KeyGenerationFailed(String),

    #[error("Invalid key: {0}")]
    InvalidKey(String),

    #[error("Signature failed: {0}")]
    SignatureFailed(String),

    #[error("Verification failed: {0}")]
    VerificationFailed(String),

    #[error("Token expired")]
    TokenExpired,

    #[error("Invalid token: {0}")]
    InvalidToken(String),

    #[error("Storage error: {0}")]
    StorageError(String),
}

/// Claims for an auth token
#[derive(Debug, Clone, Serialize, Deserialize)]
pub struct AuthTokenClaims {
    pub audience: Option<String>,
    pub subject: Option<String>,
    pub expires_at: u64,
    pub capabilities: Vec<String>,
}

/// A verified auth token
#[derive(Debug, Clone, Serialize, Deserialize)]
pub struct VerifiedToken {
    pub issuer: String,
    pub audience: Option<String>,
    pub subject: Option<String>,
    pub expires_at: u64,
    pub issued_at: u64,
    pub capabilities: Vec<String>,
}

/// Internal token structure for serialization
#[derive(Debug, Serialize, Deserialize)]
struct TokenPayload {
    iss: String,           // issuer (DID)
    aud: Option<String>,   // audience
    sub: Option<String>,   // subject
    exp: u64,              // expires at (unix timestamp)
    iat: u64,              // issued at (unix timestamp)
    cap: Vec<String>,      // capabilities
}

/// An ed25519 identity for signing and verification
pub struct Identity {
    signing_key: SigningKey,
}

impl Identity {
    fn new(signing_key: SigningKey) -> Self {
        Self { signing_key }
    }

    /// Get the public key as base64
    pub fn public_key(&self) -> String {
        use base64::Engine;
        base64::engine::general_purpose::STANDARD.encode(self.signing_key.verifying_key().as_bytes())
    }

    /// Get the DID identifier (did:key:z6Mk...)
    ///
    /// Uses the did:key method with multicodec prefix for ed25519-pub (0xed01)
    pub fn did(&self) -> String {
        let pub_bytes = self.signing_key.verifying_key().as_bytes();
        // Multicodec prefix for ed25519-pub is 0xed 0x01
        let mut multicodec = vec![0xed, 0x01];
        multicodec.extend_from_slice(pub_bytes);
        format!("did:key:z{}", bs58::encode(&multicodec).into_string())
    }

    /// Sign arbitrary data, returns base64 signature
    pub fn sign(&self, data: Vec<u8>) -> Result<String, AuthError> {
        use base64::Engine;
        let signature = self.signing_key.sign(&data);
        Ok(base64::engine::general_purpose::STANDARD.encode(signature.to_bytes()))
    }

    /// Verify a signature from any public key
    pub fn verify(&self, public_key: String, data: Vec<u8>, signature: String) -> Result<bool, AuthError> {
        use base64::Engine;

        let pub_bytes = base64::engine::general_purpose::STANDARD
            .decode(&public_key)
            .map_err(|e| AuthError::InvalidKey(e.to_string()))?;

        let pub_key_array: [u8; 32] = pub_bytes
            .try_into()
            .map_err(|_| AuthError::InvalidKey("Invalid public key length".to_string()))?;

        let verifying_key = VerifyingKey::from_bytes(&pub_key_array)
            .map_err(|e| AuthError::InvalidKey(e.to_string()))?;

        let sig_bytes = base64::engine::general_purpose::STANDARD
            .decode(&signature)
            .map_err(|e| AuthError::VerificationFailed(e.to_string()))?;

        let sig_array: [u8; 64] = sig_bytes
            .try_into()
            .map_err(|_| AuthError::VerificationFailed("Invalid signature length".to_string()))?;

        let sig = Signature::from_bytes(&sig_array);

        Ok(verifying_key.verify(&data, &sig).is_ok())
    }

    /// Create a signed auth token
    pub fn create_token(&self, claims: AuthTokenClaims) -> Result<String, AuthError> {
        use base64::Engine;

        let now = current_timestamp();
        let payload = TokenPayload {
            iss: self.did(),
            aud: claims.audience,
            sub: claims.subject,
            exp: claims.expires_at,
            iat: now,
            cap: claims.capabilities,
        };

        let payload_json = serde_json::to_string(&payload)
            .map_err(|e| AuthError::SignatureFailed(e.to_string()))?;

        let payload_b64 = base64::engine::general_purpose::URL_SAFE_NO_PAD.encode(payload_json.as_bytes());
        let signature = self.signing_key.sign(payload_b64.as_bytes());
        let sig_b64 = base64::engine::general_purpose::URL_SAFE_NO_PAD.encode(signature.to_bytes());

        // Format: payload.signature (JWT-like but simpler)
        Ok(format!("{}.{}", payload_b64, sig_b64))
    }

    /// Sign a challenge for authentication
    pub fn sign_challenge(&self, challenge: String) -> Result<String, AuthError> {
        self.sign(challenge.into_bytes())
    }

    /// Get the raw signing key bytes (for internal use/storage)
    fn secret_key_bytes(&self) -> [u8; 32] {
        self.signing_key.to_bytes()
    }
}

/// Create a new random identity
pub fn create_identity() -> Result<Arc<Identity>, AuthError> {
    let mut rng = rand_rng();
    let signing_key = SigningKey::generate(&mut rng);
    Ok(Arc::new(Identity::new(signing_key)))
}

/// Load an identity from base64-encoded private key
pub fn load_identity(private_key_base64: String) -> Result<Arc<Identity>, AuthError> {
    use base64::Engine;

    let key_bytes = base64::engine::general_purpose::STANDARD
        .decode(&private_key_base64)
        .map_err(|e| AuthError::InvalidKey(e.to_string()))?;

    let key_array: [u8; 32] = key_bytes
        .try_into()
        .map_err(|_| AuthError::InvalidKey("Invalid key length".to_string()))?;

    let signing_key = SigningKey::from_bytes(&key_array);
    Ok(Arc::new(Identity::new(signing_key)))
}

/// Verify an auth token and return its claims
///
/// # Arguments
/// * `token` - The token string (payload.signature format)
/// * `expected_issuer` - Optional DID to verify the issuer against
pub fn verify_auth_token(token: String, expected_issuer: Option<String>) -> Result<VerifiedToken, AuthError> {
    use base64::Engine;

    let parts: Vec<&str> = token.split('.').collect();
    if parts.len() != 2 {
        return Err(AuthError::InvalidToken("Invalid token format".to_string()));
    }

    let payload_b64 = parts[0];
    let sig_b64 = parts[1];

    // Decode payload
    let payload_json = base64::engine::general_purpose::URL_SAFE_NO_PAD
        .decode(payload_b64)
        .map_err(|e| AuthError::InvalidToken(e.to_string()))?;

    let payload: TokenPayload = serde_json::from_slice(&payload_json)
        .map_err(|e| AuthError::InvalidToken(e.to_string()))?;

    // Verify issuer if expected
    if let Some(expected) = expected_issuer {
        if payload.iss != expected {
            return Err(AuthError::InvalidToken("Issuer mismatch".to_string()));
        }
    }

    // Extract public key from DID
    let pub_key = did_to_public_key(&payload.iss)?;

    // Verify signature
    let sig_bytes = base64::engine::general_purpose::URL_SAFE_NO_PAD
        .decode(sig_b64)
        .map_err(|e| AuthError::VerificationFailed(e.to_string()))?;

    let sig_array: [u8; 64] = sig_bytes
        .try_into()
        .map_err(|_| AuthError::VerificationFailed("Invalid signature length".to_string()))?;

    let signature = Signature::from_bytes(&sig_array);

    pub_key.verify(payload_b64.as_bytes(), &signature)
        .map_err(|e| AuthError::VerificationFailed(e.to_string()))?;

    // Check expiration (with 60s clock drift tolerance)
    let now = current_timestamp();
    if payload.exp + 60 < now {
        return Err(AuthError::TokenExpired);
    }

    Ok(VerifiedToken {
        issuer: payload.iss,
        audience: payload.aud,
        subject: payload.sub,
        expires_at: payload.exp,
        issued_at: payload.iat,
        capabilities: payload.cap,
    })
}

/// Generate a cryptographic challenge (nonce)
pub fn generate_challenge() -> String {
    use base64::Engine;
    let mut nonce = [0u8; 32];
    fill_random(&mut nonce);
    base64::engine::general_purpose::STANDARD.encode(nonce)
}

/// Verify a signed challenge
///
/// # Arguments
/// * `identity` - The identity to use for verification context (unused, kept for FFI consistency)
/// * `challenge` - The original challenge
/// * `signature` - The base64 signature
/// * `signer_public_key` - The base64 public key of the signer
pub fn verify_challenge(
    _identity: &Identity,
    challenge: String,
    signature: String,
    signer_public_key: String,
) -> Result<bool, AuthError> {
    use base64::Engine;

    let pub_bytes = base64::engine::general_purpose::STANDARD
        .decode(&signer_public_key)
        .map_err(|e| AuthError::InvalidKey(e.to_string()))?;

    let pub_key_array: [u8; 32] = pub_bytes
        .try_into()
        .map_err(|_| AuthError::InvalidKey("Invalid public key length".to_string()))?;

    let verifying_key = VerifyingKey::from_bytes(&pub_key_array)
        .map_err(|e| AuthError::InvalidKey(e.to_string()))?;

    let sig_bytes = base64::engine::general_purpose::STANDARD
        .decode(&signature)
        .map_err(|e| AuthError::VerificationFailed(e.to_string()))?;

    let sig_array: [u8; 64] = sig_bytes
        .try_into()
        .map_err(|_| AuthError::VerificationFailed("Invalid signature length".to_string()))?;

    let sig = Signature::from_bytes(&sig_array);

    Ok(verifying_key.verify(challenge.as_bytes(), &sig).is_ok())
}

/// Public wrapper for current_timestamp (used by iroh integration)
pub fn current_timestamp_pub() -> u64 {
    current_timestamp()
}

/// Load an identity from raw key bytes (used by iroh integration)
pub fn load_identity_from_bytes(key_bytes: [u8; 32]) -> Result<Arc<Identity>, AuthError> {
    let signing_key = SigningKey::from_bytes(&key_bytes);
    Ok(Arc::new(Identity::new(signing_key)))
}

/// Extract public key from a did:key identifier
fn did_to_public_key(did: &str) -> Result<VerifyingKey, AuthError> {
    if !did.starts_with("did:key:z") {
        return Err(AuthError::InvalidKey("Invalid DID format".to_string()));
    }

    let multibase = &did[8..]; // Skip "did:key:"
    if !multibase.starts_with('z') {
        return Err(AuthError::InvalidKey("Invalid multibase prefix".to_string()));
    }

    let decoded = bs58::decode(&multibase[1..])
        .into_vec()
        .map_err(|e| AuthError::InvalidKey(e.to_string()))?;

    // Check ed25519-pub multicodec prefix (0xed 0x01)
    if decoded.len() < 34 || decoded[0] != 0xed || decoded[1] != 0x01 {
        return Err(AuthError::InvalidKey("Invalid multicodec prefix".to_string()));
    }

    let pub_bytes: [u8; 32] = decoded[2..34]
        .try_into()
        .map_err(|_| AuthError::InvalidKey("Invalid key length".to_string()))?;

    VerifyingKey::from_bytes(&pub_bytes)
        .map_err(|e| AuthError::InvalidKey(e.to_string()))
}

// ============================================================================
// Platform-specific implementations
// ============================================================================

#[cfg(not(target_arch = "wasm32"))]
fn rand_rng() -> rand::rngs::OsRng {
    rand::rngs::OsRng
}

#[cfg(target_arch = "wasm32")]
fn rand_rng() -> getrandom::Rng {
    getrandom::Rng
}

#[cfg(not(target_arch = "wasm32"))]
fn fill_random(buf: &mut [u8]) {
    use rand::RngCore;
    rand::rngs::OsRng.fill_bytes(buf);
}

#[cfg(target_arch = "wasm32")]
fn fill_random(buf: &mut [u8]) {
    getrandom::fill(buf).expect("getrandom failed");
}

#[cfg(not(target_arch = "wasm32"))]
fn current_timestamp() -> u64 {
    std::time::SystemTime::now()
        .duration_since(std::time::UNIX_EPOCH)
        .unwrap()
        .as_secs()
}

#[cfg(target_arch = "wasm32")]
fn current_timestamp() -> u64 {
    (js_sys::Date::now() / 1000.0) as u64
}

// ============================================================================
// Native storage with age encryption
// ============================================================================

#[cfg(not(target_arch = "wasm32"))]
pub fn load_or_create_identity(storage_path: String) -> Result<Arc<Identity>, AuthError> {
    use std::path::Path;

    let path = Path::new(&storage_path);

    if path.exists() {
        // Load existing identity
        let encrypted = fs::read(path)
            .map_err(|e| AuthError::StorageError(e.to_string()))?;

        let decrypted = decrypt_with_age(&encrypted)?;
        load_identity(decrypted)
    } else {
        // Create new identity and save it
        let identity = create_identity()?;
        save_identity(&identity, storage_path)?;
        Ok(identity)
    }
}

#[cfg(not(target_arch = "wasm32"))]
pub fn save_identity(identity: &Identity, storage_path: String) -> Result<(), AuthError> {
    use std::path::Path;
    use base64::Engine;

    let path = Path::new(&storage_path);

    // Create parent directories if needed
    if let Some(parent) = path.parent() {
        fs::create_dir_all(parent)
            .map_err(|e| AuthError::StorageError(e.to_string()))?;
    }

    let key_b64 = base64::engine::general_purpose::STANDARD.encode(identity.secret_key_bytes());
    let encrypted = encrypt_with_age(&key_b64)?;

    fs::write(path, encrypted)
        .map_err(|e| AuthError::StorageError(e.to_string()))?;

    Ok(())
}

#[cfg(not(target_arch = "wasm32"))]
fn encrypt_with_age(plaintext: &str) -> Result<Vec<u8>, AuthError> {
    use age::secrecy::ExposeSecret;

    // Generate a passphrase for this identity (derived from system entropy)
    // In production, this would use platform keychain
    let passphrase = get_or_create_passphrase()?;

    let encryptor = age::Encryptor::with_user_passphrase(passphrase.expose_secret().into());

    let mut encrypted = vec![];
    let mut writer = encryptor.wrap_output(&mut encrypted)
        .map_err(|e| AuthError::StorageError(e.to_string()))?;

    writer.write_all(plaintext.as_bytes())
        .map_err(|e| AuthError::StorageError(e.to_string()))?;

    writer.finish()
        .map_err(|e| AuthError::StorageError(e.to_string()))?;

    Ok(encrypted)
}

#[cfg(not(target_arch = "wasm32"))]
fn decrypt_with_age(ciphertext: &[u8]) -> Result<String, AuthError> {
    use age::secrecy::ExposeSecret;

    let passphrase = get_or_create_passphrase()?;

    let decryptor = match age::Decryptor::new(ciphertext)
        .map_err(|e| AuthError::StorageError(e.to_string()))? {
        age::Decryptor::Passphrase(d) => d,
        _ => return Err(AuthError::StorageError("Unexpected decryptor type".to_string())),
    };

    let mut decrypted = vec![];
    let mut reader = decryptor.decrypt(&passphrase, None)
        .map_err(|e| AuthError::StorageError(e.to_string()))?;

    reader.read_to_end(&mut decrypted)
        .map_err(|e| AuthError::StorageError(e.to_string()))?;

    String::from_utf8(decrypted)
        .map_err(|e| AuthError::StorageError(e.to_string()))
}

#[cfg(not(target_arch = "wasm32"))]
fn get_or_create_passphrase() -> Result<age::secrecy::SecretString, AuthError> {
    use age::secrecy::SecretString;
    use base64::Engine;

    // Get project-specific config directory
    let proj_dirs = ProjectDirs::from("com", "<hick:val name="organization" />", "<hick:val name="project_name" />")
        .ok_or_else(|| AuthError::StorageError("Cannot determine config directory".to_string()))?;

    let config_dir = proj_dirs.config_dir();
    let passphrase_path = config_dir.join(".passphrase");

    if passphrase_path.exists() {
        let passphrase = fs::read_to_string(&passphrase_path)
            .map_err(|e| AuthError::StorageError(e.to_string()))?;
        Ok(SecretString::from(passphrase))
    } else {
        // Generate new passphrase
        let mut entropy = [0u8; 32];
        fill_random(&mut entropy);
        let passphrase = base64::engine::general_purpose::STANDARD.encode(entropy);

        fs::create_dir_all(config_dir)
            .map_err(|e| AuthError::StorageError(e.to_string()))?;

        fs::write(&passphrase_path, &passphrase)
            .map_err(|e| AuthError::StorageError(e.to_string()))?;

        // Set restrictive permissions on Unix
        #[cfg(unix)]
        {
            use std::os::unix::fs::PermissionsExt;
            let mut perms = fs::metadata(&passphrase_path)
                .map_err(|e| AuthError::StorageError(e.to_string()))?
                .permissions();
            perms.set_mode(0o600);
            fs::set_permissions(&passphrase_path, perms)
                .map_err(|e| AuthError::StorageError(e.to_string()))?;
        }

        Ok(SecretString::from(passphrase))
    }
}

// ============================================================================
// WASM storage with localStorage
// ============================================================================

#[cfg(target_arch = "wasm32")]
pub fn load_or_create_identity(storage_path: String) -> Result<Arc<Identity>, AuthError> {
    let storage = web_sys::window()
        .and_then(|w| w.local_storage().ok())
        .flatten()
        .ok_or_else(|| AuthError::StorageError("localStorage not available".to_string()))?;

    let key = format!("{}_identity", storage_path);

    if let Ok(Some(value)) = storage.get_item(&key) {
        // Load existing identity
        load_identity(value)
    } else {
        // Create new identity and save it
        let identity = create_identity()?;
        save_identity(&identity, storage_path)?;
        Ok(identity)
    }
}

#[cfg(target_arch = "wasm32")]
pub fn save_identity(identity: &Identity, storage_path: String) -> Result<(), AuthError> {
    use base64::Engine;

    let storage = web_sys::window()
        .and_then(|w| w.local_storage().ok())
        .flatten()
        .ok_or_else(|| AuthError::StorageError("localStorage not available".to_string()))?;

    let key = format!("{}_identity", storage_path);
    let value = base64::engine::general_purpose::STANDARD.encode(identity.secret_key_bytes());

    storage.set_item(&key, &value)
        .map_err(|_| AuthError::StorageError("Failed to save to localStorage".to_string()))?;

    Ok(())
}

#[cfg(test)]
mod tests {
    use super::*;

    #[test]
    fn test_create_identity() {
        let identity = create_identity().expect("should create identity");
        assert!(!identity.public_key().is_empty());
        assert!(identity.did().starts_with("did:key:z"));
    }

    #[test]
    fn test_sign_and_verify() {
        let identity = create_identity().expect("should create identity");
        let data = b"hello world".to_vec();

        let signature = identity.sign(data.clone()).expect("should sign");
        let verified = identity.verify(identity.public_key(), data, signature).expect("should verify");

        assert!(verified);
    }

    #[test]
    fn test_sign_verify_fails_with_wrong_key() {
        let identity1 = create_identity().expect("should create identity");
        let identity2 = create_identity().expect("should create identity");
        let data = b"hello world".to_vec();

        let signature = identity1.sign(data.clone()).expect("should sign");
        let verified = identity1.verify(identity2.public_key(), data, signature).expect("should verify");

        assert!(!verified);
    }

    #[test]
    fn test_create_and_verify_token() {
        let identity = create_identity().expect("should create identity");

        let claims = AuthTokenClaims {
            audience: Some("test-audience".to_string()),
            subject: Some("test-subject".to_string()),
            expires_at: current_timestamp() + 3600,
            capabilities: vec!["read".to_string(), "write".to_string()],
        };

        let token = identity.create_token(claims).expect("should create token");
        let verified = verify_auth_token(token, Some(identity.did())).expect("should verify");

        assert_eq!(verified.issuer, identity.did());
        assert_eq!(verified.audience, Some("test-audience".to_string()));
        assert_eq!(verified.subject, Some("test-subject".to_string()));
        assert_eq!(verified.capabilities, vec!["read", "write"]);
    }

    #[test]
    fn test_expired_token() {
        let identity = create_identity().expect("should create identity");

        let claims = AuthTokenClaims {
            audience: None,
            subject: None,
            expires_at: current_timestamp() - 3600, // Expired
            capabilities: vec![],
        };

        let token = identity.create_token(claims).expect("should create token");
        let result = verify_auth_token(token, None);

        assert!(matches!(result, Err(AuthError::TokenExpired)));
    }

    #[test]
    fn test_challenge_response() {
        let identity = create_identity().expect("should create identity");

        let challenge = generate_challenge();
        let signature = identity.sign_challenge(challenge.clone()).expect("should sign challenge");

        let verified = verify_challenge(&identity, challenge, signature, identity.public_key())
            .expect("should verify challenge");

        assert!(verified);
    }

    #[test]
    fn test_did_roundtrip() {
        let identity = create_identity().expect("should create identity");
        let did = identity.did();

        let pub_key = did_to_public_key(&did).expect("should parse DID");
        assert_eq!(pub_key.as_bytes(), identity.signing_key.verifying_key().as_bytes());
    }

    #[test]
    fn test_load_identity() {
        use base64::Engine;

        let identity = create_identity().expect("should create identity");
        let key_b64 = base64::engine::general_purpose::STANDARD.encode(identity.secret_key_bytes());

        let loaded = load_identity(key_b64).expect("should load identity");
        assert_eq!(loaded.public_key(), identity.public_key());
        assert_eq!(loaded.did(), identity.did());
    }
}
