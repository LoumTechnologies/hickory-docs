    // Shutdown the node
    void shutdown();
};
</hick:when>
<hick:when test="decentralized-auth">
[Error]
enum AuthError {
    "KeyGenerationFailed",
    "InvalidKey",
    "SignatureFailed",
    "VerificationFailed",
    "TokenExpired",
    "InvalidToken",
    "StorageError",
};

dictionary AuthTokenClaims {
    string? audience;
    string? subject;
    u64 expires_at;
    sequence<string> capabilities;
};

dictionary VerifiedToken {
    string issuer;
    string? audience;
    string? subject;
    u64 expires_at;
    u64 issued_at;
    sequence<string> capabilities;
};

interface Identity {
    // Get the public key as base64
    string public_key();

    // Get the DID identifier (did:key:z6Mk...)
    string did();

    // Sign arbitrary data, returns base64 signature
    [Throws=AuthError]
    string sign(bytes data);

    // Verify a signature from any public key
    [Throws=AuthError]
    boolean verify(string public_key, bytes data, string signature);

    // Create a signed auth token
    [Throws=AuthError]
    string create_token(AuthTokenClaims claims);

    // Sign a challenge for authentication
    [Throws=AuthError]
    string sign_challenge(string challenge);
};
</hick:when>
<hick:when test="decentralized-auth && iroh">
dictionary AuthenticatedPeer {
    string peer_did;
    string peer_node_id;
    sequence<string> capabilities;
};
</hick:when>
<hick:when test="sqlite">
dictionary TodoItem {
    string id;
