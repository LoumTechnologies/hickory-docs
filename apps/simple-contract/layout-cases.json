{
  "cases": [
    {
      "name": "split and move preserve one tab identity",
      "steps": [
        {
          "op": "open",
          "group": 1,
          "tab": "notes.md"
        },
        {
          "op": "split",
          "group": 1,
          "axis": "vertical",
          "id": "lower"
        },
        {
          "op": "move",
          "group": 2,
          "tab": "notes.md"
        },
        {
          "op": "open",
          "group": 1,
          "tab": "agent"
        }
      ],
      "expected": [
        [
          "files"
        ],
        [
          "agent"
        ],
        [
          "notes.md"
        ]
      ]
    },
    {
      "name": "closing the active tab selects the remaining tab",
      "steps": [
        {
          "op": "open",
          "group": 1,
          "tab": "a.md"
        },
        {
          "op": "open",
          "group": 1,
          "tab": "b.txt"
        },
        {
          "op": "remove",
          "tab": "b.txt"
        }
      ],
      "expected": [
        [
          "files"
        ],
        [
          "a.md"
        ]
      ]
    },
    {
      "name": "opening an existing tab does not duplicate it",
      "steps": [
        {
          "op": "open",
          "group": 1,
          "tab": "notes.md"
        },
        {
          "op": "open",
          "group": 1,
          "tab": "notes.md"
        },
        {
          "op": "move",
          "group": 0,
          "tab": "notes.md"
        }
      ],
      "expected": [
        [
          "files",
          "notes.md"
        ],
        []
      ]
    },
    {
      "name": "terminal tabs move without changing session identity",
      "steps": [
        {
          "op": "open",
          "group": 1,
          "tab": "terminal"
        },
        {
          "op": "split",
          "group": 1,
          "axis": "horizontal",
          "id": "terminal-right"
        },
        {
          "op": "move",
          "group": 2,
          "tab": "terminal"
        }
      ],
      "expected": [
        [
          "files"
        ],
        [],
        [
          "terminal"
        ]
      ]
    }
  ]
}
