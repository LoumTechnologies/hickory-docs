<?xml version="1.0" encoding="UTF-8"?>
<!-- WiX v3 fragment: preserve Tauri's installer while adding a user PATH choice. -->
<Wix xmlns="http://schemas.microsoft.com/wix/2006/wi">
  <Fragment>
    <Property Id="ADDHICKPATH" Value="1" Secure="yes" />
    <DirectoryRef Id="INSTALLDIR">
      <Component Id="HickoryUserPath" Guid="{109C1B93-C535-40E2-8BDE-FCA048F87FB0}">
        <Condition>ADDHICKPATH = "1"</Condition>
        <RegistryValue Root="HKCU" Key="Software\Hickory Docs" Name="CommandPath" Type="string" Value="[INSTALLDIR]" KeyPath="yes" />
        <Environment Id="HickoryPath" Name="PATH" Value="[INSTALLDIR]" Action="set" Part="last" System="no" Permanent="no" />
      </Component>
    </DirectoryRef>
    <UI>
      <Dialog Id="HickoryPathDlg" Width="370" Height="270" Title="Hickory Docs command">
        <Control Id="Title" Type="Text" X="20" Y="20" Width="330" Height="30" Text="Use Hickory Docs from a terminal" />
        <Control Id="PathChoice" Type="CheckBox" X="20" Y="65" Width="330" Height="20" Property="ADDHICKPATH" CheckBoxValue="1" Text="Add hick to my user PATH" />
        <Control Id="Description" Type="Text" X="20" Y="95" Width="330" Height="60" Text="Use hick to open the app, hick . to open a folder, and hick run or hick test for CLI work. Open a new terminal after installation." />
        <Control Id="Back" Type="PushButton" X="180" Y="243" Width="56" Height="17" Text="Back">
          <Publish Event="NewDialog" Value="InstallDirDlg">1</Publish>
        </Control>
        <Control Id="Next" Type="PushButton" X="236" Y="243" Width="56" Height="17" Default="yes" Text="Next">
          <Publish Event="NewDialog" Value="VerifyReadyDlg">1</Publish>
        </Control>
        <Control Id="Cancel" Type="PushButton" X="304" Y="243" Width="56" Height="17" Cancel="yes" Text="Cancel">
          <Publish Event="SpawnDialog" Value="CancelDlg">1</Publish>
        </Control>
      </Dialog>
      <Publish Dialog="InstallDirDlg" Control="Next" Event="NewDialog" Value="HickoryPathDlg" Order="5">NOT Installed</Publish>
      <Publish Dialog="VerifyReadyDlg" Control="Back" Event="NewDialog" Value="HickoryPathDlg" Order="5">NOT Installed</Publish>
    </UI>
  </Fragment>
</Wix>
