    "/api/docs/{id}/outputs/nav": {
      "post": {
        "tags": [
          "outputs"
        ],
        "summary": "`{path, offset, kind: \"definition\"|\"references\"}` →\n`{targets: [{uri, range: {start, end}}]}` (byte offsets).",
        "description": "The output byte offset is mapped through the last run's provenance into\nsource-document coordinates, a short-lived hick-lsp session answers the\nrequest over the seeded checkout, and results are mapped back: locations\nin `.hick` docs become `hick:///<doc-path>` byte ranges; locations that\nstay inside generated outputs are re-mapped through provenance where\npossible, else returned as `hick-output:///<output-path>` byte ranges.\nRead access follows doc visibility, like every other doc read.",
        "operationId": "outputs_nav",
        "parameters": [
          {
            "name": "id",
            "in": "path",
            "description": "doc id",
            "required": true,
            "schema": {
              "type": "string",
