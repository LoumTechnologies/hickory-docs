  },
  "components": {
    "schemas": {
      "AgentRequest": {
        "type": "object",
        "required": [
          "prompt"
        ],
        "properties": {
          "parent_id": {
            "type": [
              "string",
              "null"
            ],
            "format": "uuid",
            "description": "Turn this message continues from. Omitted starts a new conversation;\nnaming an OLDER turn forks a branch from there (rewind), leaving the\nturns that followed it in place on their own branch."
          },
          "prompt": {
            "type": "string"
          }
        }
      },
      "CheckoutRequest": {
        "type": "object",
        "required": [
          "price_key"
        ],
        "properties": {
          "price_key": {
            "type": "string"
          }
        }
      },
      "CreateDoc": {
        "type": "object",
        "required": [
          "path",
          "source"
        ],
        "properties": {
          "path": {
            "type": "string"
          },
          "source": {
            "type": "string"
          }
        }
      },
      "CreateProject": {
        "type": "object",
        "required": [
          "name",
          "visibility"
        ],
        "properties": {
          "name": {
            "type": "string"
          },
          "visibility": {
            "type": "string"
          }
        }
      },
      "Credentials": {
        "type": "object",
        "required": [
          "email",
          "password"
        ],
        "properties": {
          "email": {
            "type": "string"
          },
          "password": {
            "type": "string"
          }
        }
      },
      "EditRequest": {
        "type": "object",
        "required": [
          "path",
          "edits"
        ],
        "properties": {
          "edits": {
            "type": "array",
            "items": {
              "type": "object"
            },
            "description": "`hickory_lineage::OutputEdit` — an external crate type with no\n`ToSchema` impl, so it's documented as a generic JSON array rather\nthan pulling utoipa into `hickory-lineage`."
          },
          "path": {
            "type": "string"
          }
        }
      },
      "EmailBody": {
        "type": "object",
        "required": [
          "email"
        ],
        "properties": {
          "email": {
            "type": "string"
          }
        }
      },
      "NavRequest": {
        "type": "object",
        "required": [
          "path",
          "offset",
          "kind"
        ],
        "properties": {
          "kind": {
            "type": "string"
          },
          "offset": {
            "type": "integer",
            "minimum": 0
          },
          "path": {
            "type": "string"
          }
        }
      },
      "PlanOut": {
        "type": "object",
        "required": [
          "key",
          "name",
          "description",
          "prices",
          "features"
        ],
        "properties": {
          "description": {
            "type": "string"
          },
          "features": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "highlight": {
            "type": [
              "boolean",
              "null"
            ]
          },
          "key": {
            "type": "string"
          },
          "name": {
            "type": "string"
          },
          "prices": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/PlanPriceOut"
            }
          },
          "trial_days": {
            "type": [
              "integer",
              "null"
            ],
            "format": "int32",
            "minimum": 0
          }
        }
      },
      "PlanPriceOut": {
        "type": "object",
        "required": [
          "key",
          "interval",
          "amount_cents",
          "currency"
        ],
        "properties": {
          "amount_cents": {
            "type": "integer",
            "format": "int64"
          },
          "currency": {
            "type": "string"
          },
          "interval": {
            "type": "string"
          },
          "key": {
            "type": "string"
          },
          "per_seat": {
            "type": [
              "boolean",
              "null"
            ]
          }
        }
      },
      "PlansOut": {
        "type": "object",
        "required": [
          "plans"
        ],
        "properties": {
          "enterprise": {
            "type": "object"
          },
          "plans": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/PlanOut"
            }
          }
        }
      },
      "ResetBody": {
        "type": "object",
        "required": [
          "token",
          "password"
        ],
        "properties": {
          "password": {
            "type": "string"
          },
          "token": {
            "type": "string"
          }
        }
      },
      "RunRequest": {
        "type": "object",
        "properties": {
          "cells": {
            "type": [
              "array",
              "null"
            ],
            "items": {
              "type": "string"
            },
            "description": "Requested cell subset. v0 executes the whole document regardless:\nexec blocks form a dependency DAG, so partial runs need a dependency\nclosure the pipeline does not expose yet. Accepted for forward\ncompatibility."
          }
        }
      },
      "SaveDoc": {
        "type": "object",
        "required": [
          "source"
