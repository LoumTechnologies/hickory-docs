    "/api/docs/{id}/outputs/nav": {
      "post": {
        "tags": [
          "outputs"
        ],
        "summary": "`{path, offset, kind: \"definition\"|\"references\"}` →\n`{targets: [{uri, range: {start, end}}]}` (byte offsets).",
        "description": "The output byte offset is mapped through the last run's provenance into\nsource-document coordinates, a short-lived hick-lsp session answers the\nrequest over the seeded checkout, and results are mapped back: locations\nin `.hick` docs become `hick:///<doc-path>` byte ranges; locations that\nstay inside generated outputs are re-mapped through provenance where\npossible, else returned as `hick-output:///<output-path>` byte ranges.\nRead access follows doc visibility, like every other doc read.",
        "operationId": "outputs_nav",
        "parameters": [
          {
            "name": "id",
            "in": "path",
            "description": "doc id",
            "required": true,
            "schema": {
              "type": "string",
              "format": "uuid"
            }
          }
        ],
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/NavRequest"
              }
            }
          },
          "required": true
        },
        "responses": {
          "200": {
            "description": "definition/reference targets",
            "content": {
              "application/json": {
                "schema": {}
              }
            }
          }
        }
      }
    },
    "/api/docs/{id}/render": {
      "get": {
        "tags": [
          "docs"
        ],
        "summary": "Render the block model for the doc's current source, overlaying the last\nfinished run's per-exec status + transcript. Blocks whose source changed\nafter that run (doc updated later) are marked `stale`.",
        "description": "The weave is served from `AppState::renders` when nothing it depends on\nhas changed (see `crate::render_cache`); the run overlay below is always\nrecomputed, so statuses and transcripts are never cached.",
        "operationId": "render_doc",
        "parameters": [
          {
            "name": "id",
            "in": "path",
            "description": "doc id",
            "required": true,
            "schema": {
              "type": "string",
              "format": "uuid"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "rendered block model",
            "content": {
              "application/json": {
                "schema": {}
              }
            }
          }
        }
      }
    },
