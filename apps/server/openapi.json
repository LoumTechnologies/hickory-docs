  "components": {
    "schemas": {
      "AgentRequest": {
        "type": "object",
        "required": [
          "prompt"
        ],
        "properties": {
          "parent_id": {
            "type": [
              "string",
              "null"
            ],
            "format": "uuid",
            "description": "Turn this message continues from. Omitted starts a new conversation;\nnaming an OLDER turn forks a branch from there (rewind), leaving the\nturns that followed it in place on their own branch."
          },
          "prompt": {
            "type": "string"
          }
        }
      },
      "AgentStartOut": {
        "type": "object",
        "required": [
          "session_id"
        ],
        "properties": {
          "session_id": {
            "type": "string",
            "format": "uuid"
          }
        }
      },
      "AuthOut": {
        "type": "object",
        "required": [
          "token",
          "user"
        ],
        "properties": {
          "token": {
            "type": "string"
          },
          "user": {
            "$ref": "#/components/schemas/UserOut"
          }
        }
      },
      "CaptureOut": {
        "type": "object",
        "required": [
          "accepted"
        ],
        "properties": {
          "accepted": {
            "type": "boolean",
            "description": "`true` once the event is queued for forwarding. Also `true` when\nPostHog is unconfigured: capture is a no-op then, and a caller that\ntreated that as failure would retry forever against a working server."
          }
        }
      },
      "CaptureRequest": {
        "type": "object",
        "required": [
          "distinct_id",
          "event"
        ],
        "properties": {
          "distinct_id": {
            "type": "string",
            "description": "Anonymous id generated in the browser and stable for that browser.\nNever an account id — this endpoint predates the visitor having one."
          },
          "event": {
            "type": "string",
            "description": "One of `ALLOWED_EVENTS`."
          },
          "properties": {
            "type": "object",
            "description": "Flat property bag. Values are scalars only (string, number, bool);\na nested object or array is rejected rather than silently flattened,\nbecause PostHog would store a shape no query here expects.",
            "additionalProperties": {},
            "propertyNames": {
              "type": "string"
            }
          }
        }
      },
      "CheckoutOut": {
        "type": "object",
        "required": [
          "checkout_url"
        ],
        "properties": {
          "checkout_url": {
            "type": "string"
          }
        }
      },
      "CheckoutRequest": {
        "type": "object",
        "required": [
          "price_key"
        ],
        "properties": {
          "price_key": {
            "type": "string"
          }
        }
      },
      "CreateDoc": {
        "type": "object",
        "required": [
          "path",
          "source"
        ],
        "properties": {
          "path": {
            "type": "string"
          },
          "source": {
