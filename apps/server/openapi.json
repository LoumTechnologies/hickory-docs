        "description": "The weave is served from `AppState::renders` when nothing it depends on\nhas changed (see `crate::render_cache`); the run overlay below is always\nrecomputed, so statuses and transcripts are never cached.",
        "operationId": "render_doc",
        "parameters": [
          {
            "name": "id",
            "in": "path",
            "description": "doc id",
            "required": true,
            "schema": {
