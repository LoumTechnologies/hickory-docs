{"$schema": "https://json-schema.org/draft/2020-12/schema", "$id": "https://hickory.dev/protocol/context/v1", "$ref": "#/$defs/Bundle",
"$defs": {
"ErrorCode": {"type": "string", "enum": ["invalid_schema", "version_skew", "capability_missing", "frame_limit", "missing_reference", "digest_mismatch", "invalid_mapping", "uncovered_bytes", "modified_bytes", "invalid_offset", "cursor_expired", "invalid_page", "idempotency_conflict", "invalid_delivery", "stale_handle", "cancelled", "mismatched_response"]},
"Operation": {"type": "string", "enum": ["context.capture", "context.derive", "context.changes", "context.compare", "context.resolve", "inference"]},
"DerivationKind": {"type": "string", "enum": ["root", "selection", "normalization", "concatenation", "redaction", "rendering", "summary", "model_output", "tool_output", "opaque"]},
"DeliveryState": {"type": "string", "enum": ["prepared", "transport_started", "provider_confirmed", "failed", "cancelled_uncertain"]},
"HandleKind": {"type": "string", "enum": ["location", "stop", "frame", "invocation"]},
"AnnotationKind": {"type": "string", "enum": ["log", "stdout", "exception", "breakpoint_requested", "breakpoint_bound", "paused", "values", "expression", "profile", "external_review"]},
"Precision": {"type": "string", "enum": ["exact", "span", "block", "unknown"]},
"ComparisonState": {"type": "string", "enum": ["unchanged", "moved", "changed", "ambiguous", "unavailable", "cannot_check", "invalidated"]},
"Coverage": {"type": "string", "enum": ["complete", "partial", "opaque"]},
"Span": {"type": "object", "additionalProperties": false, "properties": {"start": {"type": "integer", "minimum": 0, "maximum": 9007199254740991}, "end": {"type": "integer", "minimum": 0, "maximum": 9007199254740991}, "unit": {"type": "string", "const": "utf8_bytes"}}, "required": ["start", "end", "unit"]},
"Source": {"type": "object", "additionalProperties": false, "properties": {"id": {"type": "string", "minLength": 1}, "revision": {"type": "string", "minLength": 1}, "locator": {"type": "string"}, "kind": {"type": "string", "minLength": 1}}, "required": ["id", "revision", "locator", "kind"]},
"Artifact": {"type": "object", "additionalProperties": false, "properties": {"digest": {"type": "string", "pattern": "^[0-9a-f]{64}$"}, "media_type": {"type": "string", "minLength": 1}, "byte_length": {"type": "integer", "minimum": 0, "maximum": 9007199254740991}, "locator": {"type": "string", "minLength": 1}}, "required": ["digest", "media_type", "byte_length", "locator"]},
"Mapping": {"type": "object", "additionalProperties": false, "properties": {"parent": {"type": "string", "minLength": 1}, "input": {"$ref": "#/$defs/Span"}, "output": {"$ref": "#/$defs/Span"}}, "required": ["parent", "input", "output"]},
"Node": {"type": "object", "additionalProperties": false, "properties": {"id": {"type": "string", "minLength": 1}, "digest": {"type": "string", "pattern": "^[0-9a-f]{64}$"}, "text": {"type": "string"}, "artifact": {"$ref": "#/$defs/Artifact"}, "source": {"$ref": "#/$defs/Source"}, "source_span": {"$ref": "#/$defs/Span"}, "parents": {"type": "array", "items": {"type": "string", "minLength": 1}}, "derivation": {"$ref": "#/$defs/DerivationKind"}, "coverage": {"$ref": "#/$defs/Coverage"}, "mappings": {"type": "array", "items": {"$ref": "#/$defs/Mapping"}}, "receipt": {"type": "string", "minLength": 1}}, "required": ["id", "digest", "parents", "derivation", "coverage", "mappings"]},
"Segment": {"type": "object", "additionalProperties": false, "properties": {"span": {"$ref": "#/$defs/Span"}, "node": {"type": "string", "minLength": 1}, "node_span": {"$ref": "#/$defs/Span"}}, "required": ["span", "node", "node_span"]},
"RequestPart": {"type": "object", "additionalProperties": false, "properties": {"slot": {"type": "string", "minLength": 1}, "role": {"type": "string", "minLength": 1}, "scope": {"type": "string"}, "text": {"type": "string"}, "artifact": {"$ref": "#/$defs/Artifact"}, "segments": {"type": "array", "items": {"$ref": "#/$defs/Segment"}}}, "required": ["slot", "role", "scope", "segments"]},
"Request": {"type": "object", "additionalProperties": false, "properties": {"id": {"type": "string", "minLength": 1}, "branch": {"type": "string", "minLength": 1}, "policy": {"type": "string", "minLength": 1}, "policy_version": {"type": "string", "minLength": 1}, "observed_cursor": {"type": "string", "minLength": 1}, "parts": {"type": "array", "items": {"$ref": "#/$defs/RequestPart"}}, "provider_coverage": {"type": "string", "const": "host_controlled_only"}}, "required": ["id", "branch", "policy", "policy_version", "observed_cursor", "parts", "provider_coverage"]},
"Hello": {"type": "object", "additionalProperties": false, "properties": {"versions": {"type": "array", "items": {"type": "integer", "minimum": 0, "maximum": 9007199254740991}}, "capabilities": {"type": "array", "items": {"$ref": "#/$defs/Operation"}}, "transport": {"type": "string", "const": "cursor_polling"}, "max_frame_bytes": {"type": "integer", "minimum": 0, "maximum": 9007199254740991}, "max_page_items": {"type": "integer", "minimum": 0, "maximum": 9007199254740991}}, "required": ["versions", "capabilities", "transport", "max_frame_bytes", "max_page_items"]},
"Negotiated": {"type": "object", "additionalProperties": false, "properties": {"version": {"type": "integer", "minimum": 0, "maximum": 9007199254740991}, "capabilities": {"type": "array", "items": {"$ref": "#/$defs/Operation"}}, "transport": {"type": "string", "const": "cursor_polling"}, "max_frame_bytes": {"type": "integer", "minimum": 0, "maximum": 9007199254740991}, "max_page_items": {"type": "integer", "minimum": 0, "maximum": 9007199254740991}}, "required": ["version", "capabilities", "transport", "max_frame_bytes", "max_page_items"]},
"CaptureReceipt": {"type": "object", "additionalProperties": false, "properties": {"id": {"type": "string", "minLength": 1}, "node": {"type": "string", "minLength": 1}, "captured_at": {"type": "string", "minLength": 1}, "state": {"type": "string", "const": "captured"}}, "required": ["id", "node", "captured_at", "state"]},
"DeliveryReceipt": {"type": "object", "additionalProperties": false, "properties": {"request": {"type": "string", "minLength": 1}, "attempt": {"type": "string", "minLength": 1}, "idempotency_key": {"type": "string", "minLength": 1}, "assembly_digest": {"type": "string", "pattern": "^[0-9a-f]{64}$"}, "state": {"$ref": "#/$defs/DeliveryState"}, "provider_receipt": {"type": "string", "minLength": 1}}, "required": ["request", "attempt", "idempotency_key", "assembly_digest", "state"]},
"Cursor": {"type": "object", "additionalProperties": false, "properties": {"epoch": {"type": "string", "minLength": 1}, "branch": {"type": "string", "minLength": 1}, "position": {"type": "integer", "minimum": 0, "maximum": 9007199254740991}}, "required": ["epoch", "branch", "position"]},
"Change": {"type": "object", "additionalProperties": false, "properties": {"sequence": {"type": "integer", "minimum": 0, "maximum": 9007199254740991}, "source": {"type": "string", "minLength": 1}, "old_revision": {"type": "string", "minLength": 1}, "new_revision": {"type": "string", "minLength": 1}, "state": {"$ref": "#/$defs/ComparisonState"}}, "required": ["sequence", "source", "state"]},
"ChangePage": {"type": "object", "additionalProperties": false, "properties": {"from_cursor": {"$ref": "#/$defs/Cursor"}, "next_cursor": {"$ref": "#/$defs/Cursor"}, "events": {"type": "array", "items": {"$ref": "#/$defs/Change"}}, "has_more": {"type": "boolean"}, "limit": {"type": "integer", "minimum": 0, "maximum": 9007199254740991}}, "required": ["from_cursor", "next_cursor", "events", "has_more", "limit"]},
"Handle": {"type": "object", "additionalProperties": false, "properties": {"id": {"type": "string", "minLength": 1}, "kind": {"$ref": "#/$defs/HandleKind"}, "source": {"$ref": "#/$defs/Source"}, "span": {"$ref": "#/$defs/Span"}, "run": {"type": "string", "minLength": 1}, "stop": {"type": "string", "minLength": 1}, "frame": {"type": "string", "minLength": 1}, "invocation": {"type": "string", "minLength": 1}}, "required": ["id", "kind", "source", "span"]},
"Metric": {"type": "object", "additionalProperties": false, "properties": {"name": {"type": "string", "minLength": 1}, "value": {"type": "number"}, "unit": {"type": "string", "minLength": 1}, "clock": {"type": "string", "minLength": 1}, "semantics": {"type": "string", "minLength": 1}, "aggregation": {"type": "string", "minLength": 1}, "interval_start": {"type": "string", "minLength": 1}, "interval_end": {"type": "string", "minLength": 1}}, "required": ["name", "value", "unit", "clock", "semantics", "aggregation", "interval_start", "interval_end"]},
"Annotation": {"type": "object", "additionalProperties": false, "properties": {"id": {"type": "string", "minLength": 1}, "kind": {"$ref": "#/$defs/AnnotationKind"}, "provider": {"type": "string", "minLength": 1}, "provider_version": {"type": "string", "minLength": 1}, "evidence": {"type": "string", "minLength": 1}, "source_precision": {"$ref": "#/$defs/Precision"}, "location": {"type": "string", "minLength": 1}, "run": {"type": "string", "minLength": 1}, "stop": {"type": "string", "minLength": 1}, "frame": {"type": "string", "minLength": 1}, "invocation": {"type": "string", "minLength": 1}, "metric": {"$ref": "#/$defs/Metric"}, "coverage": {"$ref": "#/$defs/Coverage"}, "parents": {"type": "array", "items": {"type": "string", "minLength": 1}}, "payload_schema": {"type": "string", "minLength": 1}, "payload": {"type": "object"}}, "required": ["id", "kind", "provider", "provider_version", "evidence", "source_precision", "coverage", "parents", "payload_schema", "payload"]},
"Bundle": {"type": "object", "additionalProperties": false, "properties": {"version": {"type": "integer", "const": 1}, "nodes": {"type": "array", "items": {"$ref": "#/$defs/Node"}}, "request": {"$ref": "#/$defs/Request"}, "captures": {"type": "array", "items": {"$ref": "#/$defs/CaptureReceipt"}}, "deliveries": {"type": "array", "items": {"$ref": "#/$defs/DeliveryReceipt"}}, "handles": {"type": "array", "items": {"$ref": "#/$defs/Handle"}}, "annotations": {"type": "array", "items": {"$ref": "#/$defs/Annotation"}}, "productions": {"type": "array", "items": {"$ref": "#/$defs/ProductionReceipt"}}}, "required": ["version", "nodes", "request", "captures", "deliveries", "handles", "annotations", "productions"]},
"CaptureRequest": {"type": "object", "additionalProperties": false, "properties": {"idempotency_key": {"type": "string", "minLength": 1}, "source": {"$ref": "#/$defs/Source"}, "span": {"$ref": "#/$defs/Span"}, "max_bytes": {"type": "integer", "minimum": 0, "maximum": 9007199254740991}}, "required": ["idempotency_key", "source", "max_bytes"]},
"DeriveRequest": {"type": "object", "additionalProperties": false, "properties": {"idempotency_key": {"type": "string", "minLength": 1}, "node": {"$ref": "#/$defs/Node"}}, "required": ["idempotency_key", "node"]},
"ChangesRequest": {"type": "object", "additionalProperties": false, "properties": {"cursor": {"$ref": "#/$defs/Cursor"}, "references": {"type": "array", "items": {"type": "string", "minLength": 1}}, "limit": {"type": "integer", "minimum": 0, "maximum": 9007199254740991}}, "required": ["cursor", "references", "limit"]},
"CompareRequest": {"type": "object", "additionalProperties": false, "properties": {"old": {"type": "string", "minLength": 1}, "current": {"type": "string", "minLength": 1}}, "required": ["old", "current"]},
"Comparison": {"type": "object", "additionalProperties": false, "properties": {"old": {"type": "string", "minLength": 1}, "current": {"type": "string", "minLength": 1}, "state": {"$ref": "#/$defs/ComparisonState"}, "mappings": {"type": "array", "items": {"$ref": "#/$defs/Mapping"}}}, "required": ["old", "state", "mappings"]},
"ResolveRequest": {"type": "object", "additionalProperties": false, "properties": {"handle": {"type": "string", "minLength": 1}, "expected_source": {"$ref": "#/$defs/Source"}, "run": {"type": "string", "minLength": 1}, "stop": {"type": "string", "minLength": 1}, "frame": {"type": "string", "minLength": 1}, "invocation": {"type": "string", "minLength": 1}}, "required": ["handle", "expected_source"]},
"ProtocolError": {"type": "object", "additionalProperties": false, "properties": {"code": {"$ref": "#/$defs/ErrorCode"}, "message": {"type": "string", "minLength": 1}, "request_id": {"type": "string", "minLength": 1}, "retryable": {"type": "boolean"}}, "required": ["code", "message", "retryable"]},
"ProductionReceipt": {"type": "object", "additionalProperties": false, "required": ["id", "kind", "request", "response", "inputs", "output"], "properties": {"id": {"type": "string", "minLength": 1}, "kind": {"type": "string", "enum": ["model", "tool"]}, "request": {"type": "string", "minLength": 1}, "response": {"type": "string", "minLength": 1}, "inputs": {"type": "array", "items": {"type": "string", "minLength": 1}}, "output": {"type": "string", "minLength": 1}}}
}}
