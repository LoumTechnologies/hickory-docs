<hick:file path="desktop/<hick:val name="project_name" />/Views/MainWindow.axaml">&lt;Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="using:<hick:val name="project_name" />.ViewModels"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        mc:Ignorable="d" d:DesignWidth="1024" d:DesignHeight="768"
        x:Class="<hick:val name="project_name" />.Views.MainWindow"
        x:DataType="vm:MainWindowViewModel"
        Title="<hick:val name="project_name" />"
        Width="1024"
        Height="768"&gt;

    &lt;Design.DataContext&gt;
        &lt;vm:MainWindowViewModel/&gt;
    &lt;/Design.DataContext&gt;

    &lt;Grid ColumnDefinitions="220,*"&gt;
        &lt;!-- Sidebar --&gt;
        &lt;Border Grid.Column="0" Background="#1a1a2e" Padding="16"&gt;
            &lt;StackPanel Spacing="4"&gt;
                &lt;TextBlock Text="<hick:val name="project_name" />"
                           FontSize="18" FontWeight="Bold"
                           Foreground="#646cff"
                           Margin="0,0,0,16"/&gt;
                &lt;ItemsControl ItemsSource="{Binding NavItems}"&gt;
                    &lt;ItemsControl.ItemTemplate&gt;
                        &lt;DataTemplate x:DataType="vm:NavItem"&gt;
                            &lt;Button Content="{Binding Label}"
                                    Command="{Binding $parent[Window].((vm:MainWindowViewModel)DataContext).NavigateCommand}"
                                    CommandParameter="{Binding Key}"
                                    HorizontalAlignment="Stretch"
                                    HorizontalContentAlignment="Left"
                                    Margin="0,2"/&gt;
                        &lt;/DataTemplate&gt;
                    &lt;/ItemsControl.ItemTemplate&gt;
                &lt;/ItemsControl&gt;
            &lt;/StackPanel&gt;
        &lt;/Border&gt;

        &lt;!-- Content --&gt;
        &lt;ContentControl Grid.Column="1"
                        Content="{Binding CurrentPage}"
                        Margin="24"&gt;
            &lt;ContentControl.ContentTemplate&gt;
                &lt;DataTemplate&gt;
                    &lt;TextBlock Text="Select a section from the sidebar"
                               VerticalAlignment="Center"
                               HorizontalAlignment="Center"
                               Foreground="Gray"/&gt;
                &lt;/DataTemplate&gt;
            &lt;/ContentControl.ContentTemplate&gt;
        &lt;/ContentControl&gt;
    &lt;/Grid&gt;

&lt;/Window&gt;
