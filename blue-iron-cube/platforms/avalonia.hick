public record Job(
    string Id, string CustomerId, string Status, string SiteAddress,
    string SoilType, string YardGrade, string SiteAccess, string? SiteNotes,
    string? LinearFeetPlanned, string? LinearFeetActual, string? TrenchDepthInches,
    bool IncludesSumpPump, bool IncludesDownspoutTieIn, int NumberOfCatchBasins,
    string? ScheduledDate, string? StartDate, string? EndDate,
    string? EstimatedCrewHours, string? ActualCrewHours,
