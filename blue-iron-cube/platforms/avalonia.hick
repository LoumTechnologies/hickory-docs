<hick:when test="fleet">
<hick:file path="desktop/<hick:val name="project_name" />/ViewModels/FleetListViewModel.cs">using System.Collections.ObjectModel;
using CommunityToolkit.Mvvm.ComponentModel;
using <hick:val name="project_name" />.Models;
using <hick:val name="project_name" />.Services;

namespace <hick:val name="project_name" />.ViewModels;

public partial class FleetListViewModel : ViewModelBase
{
    [ObservableProperty] private bool _isLoading = true;
    public ObservableCollection&lt;Vehicle&gt; Vehicles { get; } = new();
    public ObservableCollection&lt;Equipment&gt; Equipment { get; } = new();

    public FleetListViewModel() =&gt; _ = LoadAsync();

    private async Task LoadAsync()
    {
        var vehicles = await ApiClient.GetAsync&lt;List&lt;Vehicle&gt;&gt;("/api/fleet/vehicles");
        var equipment = await ApiClient.GetAsync&lt;List&lt;Equipment&gt;&gt;("/api/fleet/equipment");
        if (vehicles != null) foreach (var v in vehicles) Vehicles.Add(v);
        if (equipment != null) foreach (var e in equipment) Equipment.Add(e);
        IsLoading = false;
    }
}
</hick:file>
</hick:when>

