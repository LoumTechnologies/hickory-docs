<hick:when test="inventory">
<hick:file path="desktop/<hick:val name="project_name" />/Models/InventoryItem.cs">namespace <hick:val name="project_name" />.Models;

public record InventoryItem(
    string Id, string Name, string Category, string Unit,
    string QuantityOnHand, string ReorderPoint, string UnitCost,
    string? Supplier, string? SupplierSku, string? Notes,
    string CreatedAt, string UpdatedAt)
{
    public bool IsLowStock
    {
        get
        {
            if (!double.TryParse(QuantityOnHand, out var qty)) return false;
            if (!double.TryParse(ReorderPoint, out var reorder)) return false;
            return qty &lt;= reorder;
        }
    }
}
</hick:file>
</hick:when>

