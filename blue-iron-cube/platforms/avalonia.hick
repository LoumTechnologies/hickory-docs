    string JobId, string MaterialCost, string LaborCost, string EquipmentCost,
    string ProcessingFees, string OverheadAllocated, string DirectCost,
    string TrueCost, string Revenue, string GrossMargin,
    string TrueMargin, string TrueMarginPct, int CompletionPct);
