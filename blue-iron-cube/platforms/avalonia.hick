    [ObservableProperty] private bool _isLoading = true;
    public ObservableCollection&lt;Procedure&gt; Procedures { get; } = new();

    public SOPListViewModel() =&gt; _ = LoadAsync();

    private async Task LoadAsync()
    {
        var procs = await ApiClient.GetAsync&lt;List&lt;Procedure&gt;&gt;("/api/sops");
        if (procs != null) foreach (var p in procs) Procedures.Add(p);
        IsLoading = false;
    }
}
</hick:file>
</hick:when>

