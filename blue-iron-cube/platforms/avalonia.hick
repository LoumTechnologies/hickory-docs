<hick:when test="jobs">
<hick:file path="desktop/<hick:val name="project_name" />/ViewModels/JobListViewModel.cs">using System.Collections.ObjectModel;
using CommunityToolkit.Mvvm.ComponentModel;
using <hick:val name="project_name" />.Models;
using <hick:val name="project_name" />.Services;

namespace <hick:val name="project_name" />.ViewModels;

public partial class JobListViewModel : ViewModelBase
{
    [ObservableProperty] private bool _isLoading = true;
    public ObservableCollection&lt;Job&gt; Jobs { get; } = new();

    public JobListViewModel() =&gt; _ = LoadAsync();

    private async Task LoadAsync()
    {
        var jobs = await ApiClient.GetAsync&lt;List&lt;Job&gt;&gt;("/api/jobs");
        if (jobs != null)
            foreach (var j in jobs) Jobs.Add(j);
        IsLoading = false;
    }
}
</hick:file>
</hick:when>

