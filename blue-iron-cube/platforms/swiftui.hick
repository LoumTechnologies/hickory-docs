    var displayed: [InventoryItem] {
        showLowStockOnly ? items.filter { $0.isLowStock } : items
    }

    var body: some View {
        Group {
            if isLoading {
                ProgressView("Loading inventory...")
            } else {
                List(displayed) { item in
                    HStack {
                        VStack(alignment: .leading) {
                            Text(item.name).font(.headline)
                            Text("\(item.category) — \(item.unit)").font(.caption).foregroundStyle(.secondary)
                        }
                        Spacer()
                        VStack(alignment: .trailing) {
                            Text(item.quantityOnHand)
                                .font(.title3)
                                .foregroundStyle(item.isLowStock ? .red : .primary)
                            Text("$\(item.unitCost)/\(item.unit)")
                                .font(.caption).foregroundStyle(.secondary)
                        }
                    }
                }
            }
        }
        .navigationTitle("Inventory")
        .toolbar {
            Toggle("Low Stock", isOn: $showLowStockOnly)
                .toggleStyle(.button)
        }
        .task { await load() }
    }

    private func load() async {
        isLoading = true
        items = (try? await InventoryService().list()) ?? []
        isLoading = false
    }
}
