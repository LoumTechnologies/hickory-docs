@Observable
final class JobService: Sendable {
    private let api = APIClient.shared

    func list() async throws -&gt; [Job] {
        try await api.get("/api/jobs")
    }

    func getCosts(jobId: String) async throws -&gt; JobCostBreakdown {
        try await api.get("/api/jobs/\(jobId)/costs")
