<hick:when test="jobs">
<hick:file path="apple/<hick:val name="project_name" />/Views/Jobs/JobListView.swift">import SwiftUI

struct JobListView: View {
    @State private var jobs: [Job] = []
    @State private var isLoading = true
    @State private var error: String?
    @State private var filterStatus: String?

    let statuses = ["lead", "scheduled", "in_progress", "completed", "invoiced"]

    var filtered: [Job] {
        guard let status = filterStatus else { return jobs }
        return jobs.filter { $0.status == status }
    }

    var body: some View {
        NavigationStack {
            Group {
                if isLoading {
                    ProgressView("Loading jobs...")
                } else if let error {
                    ContentUnavailableView("Error", systemImage: "exclamationmark.triangle", description: Text(error))
                } else if filtered.isEmpty {
                    ContentUnavailableView("No Jobs", systemImage: "hammer", description: Text("No jobs match this filter."))
                } else {
                    List(filtered) { job in
                        NavigationLink {
                            JobDetailView(job: job)
                        } label: {
                            HStack {
                                VStack(alignment: .leading) {
                                    Text(job.siteAddress).font(.headline)
                                    Text(job.statusDisplay).font(.subheadline).foregroundStyle(.secondary)
                                }
                                Spacer()
                                Text("\(job.completionPct)%")
                                    .font(.caption)
                                    .foregroundStyle(job.completionPct == 100 ? .green : .orange)
                            }
                        }
                    }
                }
            }
            .navigationTitle("Jobs")
            .toolbar {
                Menu {
                    Button("All") { filterStatus = nil }
                    ForEach(statuses, id: \.self) { s in
                        Button(s.replacingOccurrences(of: "_", with: " ").capitalized) {
                            filterStatus = s
                        }
                    }
                } label: {
                    Image(systemName: "line.3.horizontal.decrease.circle")
                }
            }
            .task { await load() }
        }
    }

    private func load() async {
        isLoading = true
        do {
            jobs = try await JobService().list()
        } catch {
            self.error = error.localizedDescription
        }
        isLoading = false
    }
}
</hick:file>

<hick:file path="apple/<hick:val name="project_name" />/Views/Jobs/JobDetailView.swift">import SwiftUI

struct JobDetailView: View {
    let job: Job
    @State private var costs: JobCostBreakdown?

    var body: some View {
        List {
            Section("Status") {
                LabeledContent("Status", value: job.statusDisplay)
                LabeledContent("Completion", value: "\(job.completionPct)%")
                ProgressView(value: Double(job.completionPct), total: 100)
            }
            Section("Site") {
                LabeledContent("Address", value: job.siteAddress)
                LabeledContent("Soil", value: job.soilType)
                LabeledContent("Grade", value: job.yardGrade)
                LabeledContent("Access", value: job.siteAccess)
            }
            Section("Scope") {
                if let lf = job.linearFeetPlanned {
                    LabeledContent("Linear feet (planned)", value: lf)
                }
                if let depth = job.trenchDepthInches {
                    LabeledContent("Trench depth (in)", value: depth)
                }
                LabeledContent("Sump pump", value: job.includesSumpPump ? "Yes" : "No")
                LabeledContent("Downspout tie-in", value: job.includesDownspoutTieIn ? "Yes" : "No")
                LabeledContent("Catch basins", value: "\(job.numberOfCatchBasins)")
            }
            Section("Phases") {
                PhaseRow(name: "Assessment", done: job.phaseAssessment)
                PhaseRow(name: "Excavation", done: job.phaseExcavation)
                PhaseRow(name: "Pipe Install", done: job.phasePipeInstall)
                PhaseRow(name: "Backfill", done: job.phaseBackfill)
                PhaseRow(name: "Restoration", done: job.phaseRestoration)
                PhaseRow(name: "Walkthrough", done: job.phaseWalkthrough)
            }
            if let costs {
                Section("Costs") {
                    LabeledContent("Material", value: "$\(costs.materialCost)")
                    LabeledContent("Labor", value: "$\(costs.laborCost)")
                    LabeledContent("Equipment", value: "$\(costs.equipmentCost)")
                    LabeledContent("Processing fees", value: "$\(costs.processingFees)")
                    LabeledContent("Overhead", value: "$\(costs.overheadAllocated)")
                    LabeledContent("True cost", value: "$\(costs.trueCost)")
                        .font(.headline)
                    LabeledContent("Revenue", value: "$\(costs.revenue)")
                    LabeledContent("True margin", value: "\(costs.trueMarginPct)%")
                }
            }
        }
        .navigationTitle("Job Details")
        .task { await loadCosts() }
    }

    private func loadCosts() async {
        costs = try? await JobService().getCosts(jobId: job.id)
    }
}

struct PhaseRow: View {
    let name: String
    let done: Bool

    var body: some View {
        HStack {
            Image(systemName: done ? "checkmark.circle.fill" : "circle")
                .foregroundStyle(done ? .green : .secondary)
            Text(name)
        }
    }
}
</hick:file>

<hick:file path="apple/<hick:val name="project_name" />/Views/Jobs/JobCostView.swift">import SwiftUI

struct JobCostView: View {
    let jobId: String
    @State private var costs: JobCostBreakdown?
    @State private var isLoading = true

    var body: some View {
        Group {
            if isLoading {
                ProgressView()
            } else if let costs {
                List {
                    Section("Direct Costs") {
                        LabeledContent("Material", value: "$\(costs.materialCost)")
                        LabeledContent("Labor", value: "$\(costs.laborCost)")
                        LabeledContent("Equipment", value: "$\(costs.equipmentCost)")
                    }
                    Section("Additional") {
                        LabeledContent("Processing fees", value: "$\(costs.processingFees)")
                        LabeledContent("Overhead allocated", value: "$\(costs.overheadAllocated)")
                    }
                    Section("Summary") {
                        LabeledContent("Direct cost", value: "$\(costs.directCost)")
                        LabeledContent("True cost", value: "$\(costs.trueCost)")
                            .font(.headline)
                        LabeledContent("Revenue", value: "$\(costs.revenue)")
                        LabeledContent("Gross margin", value: "$\(costs.grossMargin)")
                        LabeledContent("True margin", value: "$\(costs.trueMargin)")
                        LabeledContent("True margin %", value: "\(costs.trueMarginPct)%")
                    }
                }
            } else {
                ContentUnavailableView("No cost data", systemImage: "dollarsign.circle")
            }
        }
        .navigationTitle("Cost Breakdown")
        .task {
            costs = try? await JobService().getCosts(jobId: jobId)
            isLoading = false
        }
    }
}
