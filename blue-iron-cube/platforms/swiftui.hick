### Services

<hick:when test="customers">
<hick:file path="apple/<hick:val name="project_name" />/Services/CustomerService.swift">import Foundation

@Observable
final class CustomerService: Sendable {
    private let api = APIClient.shared

    func list() async throws -&gt; [Customer] {
        try await api.get("/api/customers")
    }

    func get(id: String) async throws -&gt; Customer {
        try await api.get("/api/customers/\(id)")
    }

    func create(_ customer: CreateCustomer) async throws -&gt; Customer {
        try await api.post("/api/customers", body: customer)
    }
}
</hick:file>
</hick:when>

