<hick:when test="estimating">
<hick:file path="apple/<hick:val name="project_name" />/Views/Estimating/EstimateFormView.swift">import SwiftUI

struct EstimateFormView: View {
    @State private var linearFeet = ""
    @State private var trenchDepth = ""
    @State private var soilType = "mixed"
    @State private var yardGrade = "flat"
    @State private var siteAccess = "easy"
    @State private var sumpPump = false
    @State private var downspout = false
    @State private var catchBasins = 0
    @State private var marginPct = "25"
    @State private var result: Estimate?
    @State private var isCalculating = false

    let soilTypes = ["clay", "sand", "loam", "rocky", "mixed"]
    let grades = ["flat", "slight", "moderate", "steep"]
    let accessLevels = ["easy", "moderate", "difficult", "hand_carry_only"]

    var body: some View {
        NavigationStack {
            Form {
                Section("Job Parameters") {
                    TextField("Linear feet", text: $linearFeet)
                        .keyboardType(.decimalPad)
                    TextField("Trench depth (inches)", text: $trenchDepth)
                        .keyboardType(.decimalPad)
                    Picker("Soil type", selection: $soilType) {
                        ForEach(soilTypes, id: \.self) { Text($0.capitalized).tag($0) }
                    }
                    Picker("Yard grade", selection: $yardGrade) {
                        ForEach(grades, id: \.self) { Text($0.capitalized).tag($0) }
                    }
                    Picker("Site access", selection: $siteAccess) {
                        ForEach(accessLevels, id: \.self) {
                            Text($0.replacingOccurrences(of: "_", with: " ").capitalized).tag($0)
                        }
                    }
                }
                Section("Options") {
                    Toggle("Sump pump", isOn: $sumpPump)
                    Toggle("Downspout tie-in", isOn: $downspout)
                    Stepper("Catch basins: \(catchBasins)", value: $catchBasins, in: 0...20)
                }
                Section("Pricing") {
                    TextField("Target margin %", text: $marginPct)
                        .keyboardType(.decimalPad)
                }
                Section {
                    Button("Generate Estimate") {
                        Task { await generate() }
                    }
                    .disabled(linearFeet.isEmpty || trenchDepth.isEmpty || isCalculating)
                }
                if let result {
                    NavigationLink("View Result") {
                        EstimateResultView(estimate: result)
                    }
                }
            }
            .navigationTitle("New Estimate")
        }
    }

    private func generate() async {
        isCalculating = true
        let request = EstimateRequest(
            linearFeet: linearFeet,
            trenchDepthInches: trenchDepth,
            soilType: soilType,
            yardGrade: yardGrade,
            siteAccess: siteAccess,
            includesSumpPump: sumpPump,
            includesDownspoutTieIn: downspout,
            numberOfCatchBasins: catchBasins,
            desiredMarginPct: marginPct
        )
        result = try? await EstimateService().create(request)
        isCalculating = false
    }
}
</hick:file>

<hick:file path="apple/<hick:val name="project_name" />/Views/Estimating/EstimateResultView.swift">import SwiftUI

struct EstimateResultView: View {
    let estimate: Estimate

    var body: some View {
        List {
            Section("Quote") {
                LabeledContent("Quoted Price", value: "$\(estimate.quotedPrice)")
                    .font(.title2)
                LabeledContent("Target margin", value: "\(estimate.desiredMarginPct)%")
            }
            Section("Predicted Costs") {
                LabeledContent("Materials", value: "$\(estimate.predictedMaterialCost)")
                LabeledContent("Labor", value: "$\(estimate.predictedLaborCost)")
                LabeledContent("Equipment", value: "$\(estimate.predictedEquipmentCost)")
                LabeledContent("Direct cost", value: "$\(estimate.predictedDirectCost)")
                LabeledContent("Overhead", value: "$\(estimate.predictedOverhead)")
                LabeledContent("Total cost", value: "$\(estimate.predictedTotalCost)")
            }
            Section("Scheduling") {
                LabeledContent("Estimated crew hours", value: estimate.predictedCrewHours)
            }
            Section("Model") {
                LabeledContent("Version", value: "\(estimate.modelVersion)")
                LabeledContent("Sample size", value: "\(estimate.sampleSize)")
                Text(estimate.confidenceNote)
                    .font(.caption)
                    .foregroundStyle(.secondary)
            }
            Section("Job Details") {
                LabeledContent("Linear feet", value: estimate.linearFeet)
                LabeledContent("Trench depth", value: "\(estimate.trenchDepthInches) in")
                LabeledContent("Soil", value: estimate.soilType)
                LabeledContent("Grade", value: estimate.yardGrade)
                LabeledContent("Access", value: estimate.siteAccess)
                LabeledContent("Sump pump", value: estimate.includesSumpPump ? "Yes" : "No")
                LabeledContent("Downspout tie-in", value: estimate.includesDownspoutTieIn ? "Yes" : "No")
                LabeledContent("Catch basins", value: "\(estimate.numberOfCatchBasins)")
            }
        }
        .navigationTitle("Estimate")
    }
}
</hick:file>
</hick:when>

