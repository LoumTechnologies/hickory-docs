<hick:when test="crm">
<hick:file path="apple/<hick:val name="project_name" />/Services/CRMService.swift">import Foundation

@Observable
final class CRMService: Sendable {
    private let api = APIClient.shared

    func listLeads(status: String? = nil) async throws -&gt; [Lead] {
        let path = status != nil ? "/api/crm/leads?status=\(status!)" : "/api/crm/leads"
        return try await api.get(path)
    }

    func updateLead(id: String, status: String) async throws {
        struct Update: Codable { let status: String }
        let _: [String: String] = try await api.put("/api/crm/leads/\(id)", body: Update(status: status))
    }
}
</hick:file>
</hick:when>

