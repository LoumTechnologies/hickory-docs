<hick:when test="payments">
<hick:file path="apple/<hick:val name="project_name" />/Views/Payments/PaymentFormView.swift">import SwiftUI

struct PaymentFormView: View {
    @State private var jobId = ""
    @State private var amount = ""
    @State private var method = "cash"
    @State private var reference = ""
    @State private var isSaving = false
    @State private var lastPayment: Payment?

    let methods = ["cash", "check", "credit_card", "debit_card", "ach", "financing"]

    var body: some View {
        NavigationStack {
            Form {
                Section("Payment Details") {
                    TextField("Job ID", text: $jobId)
                    TextField("Amount", text: $amount)
                        .keyboardType(.decimalPad)
                    Picker("Method", selection: $method) {
                        ForEach(methods, id: \.self) { m in
                            Text(m.replacingOccurrences(of: "_", with: " ").capitalized).tag(m)
                        }
                    }
                    TextField("Reference (optional)", text: $reference)
                }
                Section {
                    Button("Record Payment") {
                        Task { await save() }
                    }
                    .disabled(jobId.isEmpty || amount.isEmpty || isSaving)
                }
                if let payment = lastPayment {
                    Section("Last Recorded") {
                        LabeledContent("ID", value: payment.id)
                        LabeledContent("Amount", value: "$\(payment.amount)")
                        LabeledContent("Fee", value: "$\(payment.processingFeeAmount)")
                    }
                }
            }
            .navigationTitle("Record Payment")
        }
    }

    private func save() async {
        isSaving = true
        let today = ISO8601DateFormatter().string(from: Date()).prefix(10)
        let input = CreatePayment(
            jobId: jobId, date: String(today), amount: amount, method: method,
            reference: reference.isEmpty ? nil : reference
        )
        lastPayment = try? await PaymentService().record(input)
        isSaving = false
    }
}
</hick:file>
</hick:when>

