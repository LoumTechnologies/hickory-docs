#### Customer Views

<hick:when test="customers">
<hick:file path="apple/<hick:val name="project_name" />/Views/Customers/CustomerListView.swift">import SwiftUI

struct CustomerListView: View {
    @State private var customers: [Customer] = []
    @State private var isLoading = true
    @State private var error: String?
    @State private var searchText = ""
    @State private var showingAddForm = false

    var filtered: [Customer] {
        if searchText.isEmpty { return customers }
        return customers.filter {
            $0.name.localizedCaseInsensitiveContains(searchText) ||
            $0.phone.contains(searchText) ||
            $0.city.localizedCaseInsensitiveContains(searchText)
        }
    }

    var body: some View {
        NavigationStack {
            Group {
                if isLoading {
                    ProgressView("Loading customers...")
                } else if let error {
                    ContentUnavailableView("Error", systemImage: "exclamationmark.triangle", description: Text(error))
                } else if filtered.isEmpty {
                    ContentUnavailableView.search
                } else {
                    List(filtered) { customer in
                        NavigationLink {
                            CustomerDetailView(customer: customer)
                        } label: {
                            VStack(alignment: .leading) {
                                Text(customer.name).font(.headline)
                                Text(customer.phone).font(.subheadline).foregroundStyle(.secondary)
                                Text("\(customer.city), \(customer.state) \(customer.zip)")
                                    .font(.caption).foregroundStyle(.tertiary)
                            }
                        }
                    }
                }
            }
            .navigationTitle("Customers")
            .searchable(text: $searchText, prompt: "Search by name, phone, city")
            .toolbar {
                Button {
                    showingAddForm = true
                } label: {
                    Image(systemName: "plus")
                }
            }
            .sheet(isPresented: $showingAddForm) {
                CustomerFormView { await load() }
            }
            .task { await load() }
        }
    }

    private func load() async {
        isLoading = true
        error = nil
        do {
            customers = try await CustomerService().list()
        } catch {
            self.error = error.localizedDescription
        }
        isLoading = false
    }
}
</hick:file>

