#### CRM Views

<hick:when test="crm">
<hick:file path="apple/<hick:val name="project_name" />/Views/CRM/LeadPipelineView.swift">import SwiftUI

struct LeadPipelineView: View {
    @State private var leads: [Lead] = []
    @State private var isLoading = true
    @State private var error: String?

    let stages = ["new_lead", "contacted", "site_visit_scheduled", "site_visit_completed",
                  "estimate_sent", "negotiating", "won", "lost"]

    var body: some View {
        NavigationStack {
            Group {
                if isLoading {
                    ProgressView("Loading pipeline...")
                } else if let error {
                    ContentUnavailableView("Error", systemImage: "exclamationmark.triangle", description: Text(error))
                } else {
                    List {
                        ForEach(stages, id: \.self) { stage in
                            let stageLeads = leads.filter { $0.status == stage }
                            if !stageLeads.isEmpty {
                                Section(stage.replacingOccurrences(of: "_", with: " ").capitalized) {
                                    ForEach(stageLeads) { lead in
                                        NavigationLink {
                                            LeadDetailView(lead: lead)
                                        } label: {
                                            VStack(alignment: .leading) {
                                                Text("Customer: \(lead.customerId)")
                                                    .font(.headline)
                                                HStack {
                                                    Text(lead.source).font(.caption)
                                                    if let value = lead.estimatedValue {
                                                        Spacer()
                                                        Text("$\(value)").font(.caption).foregroundStyle(.green)
                                                    }
                                                }
                                            }
                                        }
                                    }
                                }
                            }
                        }
                    }
                }
            }
            .navigationTitle("Lead Pipeline")
            .task { await load() }
            .refreshable { await load() }
        }
    }

    private func load() async {
        isLoading = true
        do {
            leads = try await CRMService().listLeads()
        } catch {
            self.error = error.localizedDescription
        }
        isLoading = false
    }
}
</hick:file>

<hick:file path="apple/<hick:val name="project_name" />/Views/CRM/LeadDetailView.swift">import SwiftUI

struct LeadDetailView: View {
    let lead: Lead
    @State private var isUpdating = false

    let nextStage: [String: String] = [
        "new_lead": "contacted",
        "contacted": "site_visit_scheduled",
        "site_visit_scheduled": "site_visit_completed",
        "site_visit_completed": "estimate_sent",
        "estimate_sent": "negotiating",
        "negotiating": "won",
    ]

    var body: some View {
        List {
            Section("Lead Info") {
                LabeledContent("Status", value: lead.statusDisplay)
                LabeledContent("Source", value: lead.source)
                LabeledContent("Customer", value: lead.customerId)
                if let value = lead.estimatedValue {
                    LabeledContent("Estimated value", value: "$\(value)")
                }
                if let assignee = lead.assignedTo {
                    LabeledContent("Assigned to", value: assignee)
                }
            }
            if let next = nextStage[lead.status] {
                Section {
                    Button("Advance to \(next.replacingOccurrences(of: "_", with: " ").capitalized)") {
                        Task { await advance(to: next) }
                    }
                    .disabled(isUpdating)
                }
            }
            if lead.status == "lost" {
                Section("Lost Details") {
                    if let reason = lead.lostReason {
                        LabeledContent("Reason", value: reason)
                    }
                    if let competitor = lead.lostToCompetitor {
                        LabeledContent("Lost to", value: competitor)
                    }
                }
            }
        }
        .navigationTitle("Lead Details")
    }

    private func advance(to status: String) async {
        isUpdating = true
        try? await CRMService().updateLead(id: lead.id, status: status)
        isUpdating = false
    }
}
</hick:file>
</hick:when>

