<hick:when test="inventory">
<hick:file path="apple/<hick:val name="project_name" />/Models/InventoryItem.swift">import Foundation

struct InventoryItem: Codable, Identifiable, Sendable {
    let id: String
    var name: String
    var category: String
    var unit: String
    var quantityOnHand: String
    var reorderPoint: String
    var unitCost: String
    var supplier: String?
    var supplierSku: String?
    var notes: String?
    let createdAt: String
    let updatedAt: String

    var isLowStock: Bool {
        guard let qty = Decimal(string: quantityOnHand),
              let reorder = Decimal(string: reorderPoint) else { return false }
        return qty &lt;= reorder
    }
}
</hick:file>
</hick:when>

