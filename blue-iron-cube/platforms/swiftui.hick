#### SOP Views

<hick:when test="sops">
<hick:file path="apple/<hick:val name="project_name" />/Views/SOPs/SOPListView.swift">import SwiftUI

struct SOPListView: View {
    @State private var procedures: [Procedure] = []
    @State private var isLoading = true

    var grouped: [String: [Procedure]] {
        Dictionary(grouping: procedures, by: { $0.category })
    }

    var body: some View {
        Group {
            if isLoading {
                ProgressView("Loading procedures...")
            } else if procedures.isEmpty {
                ContentUnavailableView("No SOPs", systemImage: "list.clipboard", description: Text("No procedures have been created yet."))
            } else {
                List {
                    ForEach(grouped.keys.sorted(), id: \.self) { category in
                        Section(category.replacingOccurrences(of: "_", with: " ").capitalized) {
                            ForEach(grouped[category]!) { proc in
                                NavigationLink {
                                    SOPDetailView(procedureId: proc.id)
                                } label: {
                                    VStack(alignment: .leading) {
                                        Text(proc.title).font(.headline)
                                        HStack {
                                            Text("v\(proc.version)").font(.caption)
                                            if let mins = proc.estimatedDurationMinutes {
                                                Text("~\(mins) min").font(.caption).foregroundStyle(.secondary)
                                            }
                                        }
                                    }
                                }
                            }
                        }
                    }
                }
            }
        }
        .navigationTitle("SOPs")
        .task { await load() }
    }

    private func load() async {
        isLoading = true
        procedures = (try? await SOPService().list()) ?? []
        isLoading = false
    }
}
</hick:file>

<hick:file path="apple/<hick:val name="project_name" />/Views/SOPs/SOPDetailView.swift">import SwiftUI

struct SOPDetailView: View {
    let procedureId: String
    @State private var procedure: ProcedureWithSteps?
    @State private var isLoading = true

    var body: some View {
        Group {
            if isLoading {
                ProgressView()
            } else if let procedure {
                List {
                    if let desc = procedure.description {
                        Section("Description") {
                            Text(desc)
                        }
                    }
                    if let safety = procedure.safetyNotes {
                        Section("Safety") {
                            Label(safety, systemImage: "exclamationmark.triangle.fill")
                                .foregroundStyle(.orange)
                        }
                    }
                    Section("Requirements") {
                        if let roles = procedure.requiredRoles {
                            LabeledContent("Roles", value: roles)
                        }
                        if let equipment = procedure.requiredEquipment {
                            LabeledContent("Equipment", value: equipment)
                        }
                        if let materials = procedure.requiredMaterials {
                            LabeledContent("Materials", value: materials)
                        }
                    }
                    Section("Steps") {
                        ForEach(procedure.steps) { step in
                            HStack(alignment: .top) {
                                Text("\(step.stepNumber).")
                                    .font(.headline)
                                    .frame(width: 30, alignment: .trailing)
                                VStack(alignment: .leading) {
                                    Text(step.instruction)
                                    if step.isCheckpoint {
                                        Label("Checkpoint — requires sign-off", systemImage: "checkmark.seal.fill")
                                            .font(.caption)
                                            .foregroundStyle(.blue)
                                    }
                                    if let notes = step.notes {
                                        Text(notes).font(.caption).foregroundStyle(.secondary)
                                    }
                                }
                            }
                        }
                    }
                }
            } else {
                ContentUnavailableView("Not Found", systemImage: "doc.questionmark")
            }
        }
        .navigationTitle(procedure?.title ?? "Procedure")
        .task {
            procedure = try? await SOPService().get(id: procedureId)
            isLoading = false
        }
    }
}
</hick:file>
</hick:when>

