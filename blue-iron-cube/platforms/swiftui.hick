<?xml version="1.0" encoding="UTF-8"?>
<hick:doc xmlns:hick="http://www.hickorydocs.com/1.0">

<hick:when test="swiftui">

## SwiftUI iOS App

A field-operations iOS app for <hick:val name="business_name" />. Provides mobile
access to jobs, customers, crew time tracking, inventory, and CRM — everything a
field crew or sales rep needs on-site.

---

### Devenv Launcher

<hick:file path=".devenv/launchers.yml">launchers:
  ios:
    type: ios-simulator
    bundleId: <hick:val name="bundle_id" />
    urlScheme: <hick:val name="url_scheme" />
    projectPath: ./apple
    scheme: <hick:val name="project_name" />

  web:
    type: http
    url: http://localhost:${BACKEND_PORT:-3000}/health
    label: Backend Health
</hick:file>

---

### XcodeGen Project

<hick:file path="apple/project.yml">name: <hick:val name="project_name" />
options:
  bundleIdPrefix: <hick:val name="bundle_id" />
  deploymentTarget:
    iOS: "<hick:val name="min_ios_version" />"
  xcodeVersion: "16.0"
settings:
  SWIFT_VERSION: "6.0"
  MARKETING_VERSION: "0.1.0"
  CURRENT_PROJECT_VERSION: "1"
targets:
  <hick:val name="project_name" />:
    type: application
    platform: iOS
    sources:
      - path: <hick:val name="project_name" />
    settings:
      INFOPLIST_VALUES: |
        CFBundleURLTypes = (
          {
            CFBundleURLSchemes = ("<hick:val name="url_scheme" />");
            CFBundleURLName = "<hick:val name="bundle_id" />";
          }
        );
        UILaunchScreen = {};
</hick:file>

