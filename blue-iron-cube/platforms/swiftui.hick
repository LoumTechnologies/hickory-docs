<hick:file path="apple/<hick:val name="project_name" />/Views/Customers/CustomerFormView.swift">import SwiftUI

struct CustomerFormView: View {
    @Environment(\.dismiss) private var dismiss
    var onSave: () async -&gt; Void

    @State private var name = ""
    @State private var phone = ""
    @State private var email = ""
    @State private var address = ""
    @State private var city = ""
    @State private var state = ""
    @State private var zip = ""
    @State private var referralSource = ""
    @State private var notes = ""
    @State private var isSaving = false

    var body: some View {
        NavigationStack {
            Form {
                Section("Contact") {
                    TextField("Name", text: $name)
                    TextField("Phone", text: $phone)
                        .keyboardType(.phonePad)
                    TextField("Email", text: $email)
                        .keyboardType(.emailAddress)
                        .textInputAutocapitalization(.never)
                }
                Section("Address") {
                    TextField("Street", text: $address)
                    TextField("City", text: $city)
                    TextField("State", text: $state)
                    TextField("Zip", text: $zip)
                        .keyboardType(.numberPad)
                }
                Section("Other") {
                    TextField("Referral source", text: $referralSource)
                    TextField("Notes", text: $notes, axis: .vertical)
                        .lineLimit(3...6)
                }
            }
            .navigationTitle("New Customer")
            .toolbar {
                ToolbarItem(placement: .cancellationAction) {
                    Button("Cancel") { dismiss() }
                }
                ToolbarItem(placement: .confirmationAction) {
                    Button("Save") {
                        Task { await save() }
                    }
                    .disabled(name.isEmpty || phone.isEmpty || address.isEmpty || isSaving)
                }
            }
        }
    }

    private func save() async {
        isSaving = true
        let input = CreateCustomer(
            name: name, phone: phone,
            email: email.isEmpty ? nil : email,
            address: address, city: city, state: state, zip: zip,
            referralSource: referralSource.isEmpty ? nil : referralSource,
            notes: notes.isEmpty ? nil : notes
        )
        do {
            _ = try await CustomerService().create(input)
            await onSave()
            dismiss()
        } catch {
            isSaving = false
        }
    }
}
</hick:file>
</hick:when>

