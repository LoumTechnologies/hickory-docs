### Setup Script

<hick:file path="apple/setup.sh">#!/bin/bash
set -euo pipefail

echo "Setting up <hick:val name="project_name" /> iOS project..."

# Check for xcodegen
if ! command -v xcodegen &amp;&gt; /dev/null; then
    echo "xcodegen not found. Installing via Homebrew..."
    brew install xcodegen
fi

# Generate Xcode project
echo "Generating Xcode project..."
xcodegen generate

echo "Done! Open <hick:val name="project_name" />.xcodeproj in Xcode."
</hick:file>

</hick:when>
</hick:doc>
