<hick:when test="jobs">
<hick:file path="apple/<hick:val name="project_name" />/Models/Job.swift">import Foundation

struct Job: Codable, Identifiable, Sendable {
    let id: String
    let customerId: String
    var status: String
    var siteAddress: String
    var soilType: String
    var yardGrade: String
    var siteAccess: String
    var siteNotes: String?
    var linearFeetPlanned: String?
    var linearFeetActual: String?
    var trenchDepthInches: String?
    var includesSumpPump: Bool
    var includesDownspoutTieIn: Bool
    var numberOfCatchBasins: Int
    var scheduledDate: String?
    var startDate: String?
    var endDate: String?
    var estimatedCrewHours: String?
    var actualCrewHours: String?
    var weatherConditions: String?
    var groundWasWet: Bool?
    var completionPct: Int
    var phaseAssessment: Bool
    var phaseExcavation: Bool
    var phasePipeInstall: Bool
    var phaseBackfill: Bool
    var phaseRestoration: Bool
    var phaseWalkthrough: Bool
    var cancellationReason: String?
    var quotedPrice: String?
    var actualRevenue: String?
    let createdAt: String
    let updatedAt: String

    var statusDisplay: String {
        status.replacingOccurrences(of: "_", with: " ").capitalized
    }
}

struct JobCostBreakdown: Codable, Sendable {
    let jobId: String
    let materialCost: String
    let laborCost: String
    let equipmentCost: String
    let processingFees: String
    let overheadAllocated: String
    let directCost: String
    let trueCost: String
    let revenue: String
    let grossMargin: String
    let trueMargin: String
    let trueMarginPct: String
    let completionPct: Int
}
