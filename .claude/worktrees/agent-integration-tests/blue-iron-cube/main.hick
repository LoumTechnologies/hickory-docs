use anyhow::Result;
use axum::Router;
use std::net::SocketAddr;
use std::sync::Arc;
use tower_http::cors::{Any, CorsLayer};
use tower_http::trace::TraceLayer;
use tracing_subscriber::{layer::SubscriberExt, util::SubscriberInitExt};

pub struct AppState {
    pub db: db::Database,
}

pub async fn run() -> Result&lt;()&gt; {
    tracing_subscriber::registry()
        .with(
            tracing_subscriber::EnvFilter::try_from_default_env()
                .unwrap_or_else(|_| "blue_iron_cube=debug,tower_http=debug".into()),
        )
        .with(tracing_subscriber::fmt::layer())
        .init();

    let db = db::Database::open("data/<hick:val name="app_name" />.db")?;
    db.run_migrations()?;

    let state = Arc::new(AppState { db });
    let app = create_router(state);

    let addr = SocketAddr::from(([0, 0, 0, 0], 3000));
    tracing::info!("listening on {}", addr);

    let listener = tokio::net::TcpListener::bind(addr).await?;
    axum::serve(listener, app).await?;
    Ok(())
}

async fn health() -> &amp;'static str {
    "OK"
}

pub fn create_router(state: Arc&lt;AppState&gt;) -> Router {
    let cors = CorsLayer::new()
        .allow_origin(Any)
        .allow_methods(Any)
        .allow_headers(Any);

    let mut router = Router::new()
        .route("/health", axum::routing::get(health));
<hick:when test="customers">    router = router.merge(customers::routes());</hick:when>
<hick:when test="jobs">    router = router.merge(jobs::routes());</hick:when>
<hick:when test="payments">    router = router.merge(payments::routes());</hick:when>
<hick:when test="crew">    router = router.merge(crew::routes());</hick:when>
<hick:when test="inventory">    router = router.merge(inventory::routes());</hick:when>
<hick:when test="fleet">    router = router.merge(fleet::routes());</hick:when>
<hick:when test="overhead">    router = router.merge(overhead::routes());</hick:when>
<hick:when test="estimating">    router = router.merge(estimating::routes());</hick:when>
<hick:when test="crm">    router = router.merge(crm::routes());</hick:when>
<hick:when test="sops">    router = router.merge(sops::routes());</hick:when>

    router
        .with_state(state)
        .layer(TraceLayer::new_for_http())
        .layer(cors)
}
</hick:file>

### Shared Types

<hick:file path="backend/src/types.rs">use rust_decimal::Decimal;
use rust_decimal::prelude::*;
use serde::{Deserialize, Serialize};

/// All monetary values are stored as Decimal to avoid floating-point errors.
pub type Money = Decimal;

/// Standard ID prefix format: "entity-uuid7"
pub fn new_id(prefix: &amp;str) -> String {
    format!("{}-{}", prefix, uuid::Uuid::now_v7())
}

/// Read a Decimal from a rusqlite row column (stored as REAL in SQLite).
pub fn get_decimal(row: &amp;rusqlite::Row, idx: usize) -> rusqlite::Result&lt;Decimal&gt; {
    let val: f64 = row.get(idx)?;
    Ok(Decimal::from_f64(val).unwrap_or_default())
}

/// Read an optional Decimal from a rusqlite row column.
pub fn get_decimal_opt(row: &amp;rusqlite::Row, idx: usize) -> rusqlite::Result&lt;Option&lt;Decimal&gt;&gt; {
    let val: Option&lt;f64&gt; = row.get(idx)?;
    Ok(val.map(|v| Decimal::from_f64(v).unwrap_or_default()))
}

/// Soil types encountered during excavation. Affects labor time and equipment needs.
#[derive(Debug, Clone, Serialize, Deserialize, PartialEq)]
#[serde(rename_all = "snake_case")]
pub enum SoilType {
    Clay,
    Sand,
    Loam,
    Rocky,
    Mixed,
}

/// Yard grade affects difficulty and drainage design.
#[derive(Debug, Clone, Serialize, Deserialize, PartialEq)]
#[serde(rename_all = "snake_case")]
pub enum YardGrade {
    Flat,
    Slight,
    Moderate,
    Steep,
}

/// How accessible is the job site for equipment?
#[derive(Debug, Clone, Serialize, Deserialize, PartialEq)]
#[serde(rename_all = "snake_case")]
pub enum SiteAccess {
    Easy,
    Moderate,
    Difficult,
    HandCarryOnly,
}
</hick:file>

### Database Module

<hick:file path="backend/src/db.rs">use anyhow::Result;
use rusqlite::Connection;
use std::path::Path;
use std::sync::Mutex;

pub struct Database {
    conn: Mutex&lt;Connection&gt;,
}

impl Database {
    pub fn open(path: &amp;str) -> Result&lt;Self&gt; {
        if let Some(parent) = Path::new(path).parent() {
            std::fs::create_dir_all(parent)?;
        }
        let conn = Connection::open(path)?;
        conn.execute_batch("PRAGMA journal_mode=WAL; PRAGMA foreign_keys=ON;")?;
        Ok(Self { conn: Mutex::new(conn) })
    }

    pub fn conn(&amp;self) -> std::sync::MutexGuard&lt;'_, Connection&gt; {
        self.conn.lock().expect("database lock poisoned")
    }

    pub fn run_migrations(&amp;self) -> Result&lt;()&gt; {
        let conn = self.conn();
        let migration_dir = Path::new("migrations");
        if !migration_dir.exists() {
            return Ok(());
        }
        conn.execute_batch(
            "CREATE TABLE IF NOT EXISTS _migrations (
                name TEXT PRIMARY KEY,
                applied_at TEXT NOT NULL DEFAULT (datetime('now'))
            )"
        )?;
        let mut entries: Vec&lt;_&gt; = std::fs::read_dir(migration_dir)?
            .filter_map(|e| e.ok())
            .filter(|e| e.path().extension().map_or(false, |ext| ext == "sql"))
            .collect();
        entries.sort_by_key(|e| e.file_name());
        for entry in entries {
            let name = entry.file_name().to_string_lossy().to_string();
            let already_applied: bool = conn.query_row(
                "SELECT COUNT(*) > 0 FROM _migrations WHERE name = ?1",
                [&amp;name],
                |row| row.get(0),
            )?;
            if !already_applied {
                let sql = std::fs::read_to_string(entry.path())?;
                conn.execute_batch(&amp;sql)?;
                conn.execute("INSERT INTO _migrations (name) VALUES (?1)", [&amp;name])?;
                tracing::info!("applied migration: {}", name);
            }
        }
        Ok(())
    }
}
</hick:file>

### Error Handling

<hick:file path="backend/src/error.rs">use axum::{
    http::StatusCode,
    response::{IntoResponse, Response},
    Json,
};
use serde_json::json;
use thiserror::Error;

#[derive(Error, Debug)]
pub enum AppError {
    #[error("Not found: {0}")]
    NotFound(String),

    #[error("Bad request: {0}")]
    BadRequest(String),

    #[error("Internal error: {0}")]
    Internal(String),
}

impl IntoResponse for AppError {
    fn into_response(self) -> Response {
        let (status, message) = match &amp;self {
            AppError::NotFound(msg) => (StatusCode::NOT_FOUND, msg.clone()),
            AppError::BadRequest(msg) => (StatusCode::BAD_REQUEST, msg.clone()),
            AppError::Internal(msg) => (StatusCode::INTERNAL_SERVER_ERROR, msg.clone()),
        };
        (status, Json(json!({ "error": message }))).into_response()
    }
}

impl From&lt;anyhow::Error&gt; for AppError {
    fn from(err: anyhow::Error) -> Self {
        AppError::Internal(err.to_string())
    }
}

impl From&lt;rusqlite::Error&gt; for AppError {
    fn from(err: rusqlite::Error) -> Self {
        AppError::Internal(err.to_string())
    }
}
</hick:file>

