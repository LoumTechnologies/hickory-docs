<hick:when test="customers">
<hick:file path="android/app/src/main/kotlin/com/acmedrainage/blueironcube/screens/customers/CustomerListScreen.kt">package <hick:val name="bundle_id" />.screens.customers

import androidx.compose.foundation.clickable
import androidx.compose.foundation.layout.*
import androidx.compose.foundation.lazy.LazyColumn
import androidx.compose.foundation.lazy.items
import androidx.compose.material3.*
import androidx.compose.runtime.*
import androidx.compose.ui.Modifier
import androidx.compose.ui.unit.dp
import androidx.navigation.NavController
import <hick:val name="bundle_id" />.api.ApiClient
import <hick:val name="bundle_id" />.models.Customer

@OptIn(ExperimentalMaterial3Api::class)
@Composable
fun CustomerListScreen(navController: NavController) {
    var customers by remember { mutableStateOf&lt;List&lt;Customer&gt;&gt;(emptyList()) }
    var isLoading by remember { mutableStateOf(true) }
    var error by remember { mutableStateOf&lt;String?&gt;(null) }
    var searchText by remember { mutableStateOf("") }

    LaunchedEffect(Unit) {
        try {
            customers = ApiClient.get("/api/customers")
        } catch (e: Exception) {
            error = e.message
        }
        isLoading = false
    }

    val filtered = if (searchText.isEmpty()) customers else customers.filter {
        it.name.contains(searchText, ignoreCase = true) ||
        it.phone.contains(searchText) ||
        it.city.contains(searchText, ignoreCase = true)
    }

    Column(modifier = Modifier.fillMaxSize()) {
        SearchBar(
            query = searchText,
            onQueryChange = { searchText = it },
            onSearch = {},
            active = false,
            onActiveChange = {},
            placeholder = { Text("Search by name, phone, city") },
            modifier = Modifier.fillMaxWidth().padding(horizontal = 16.dp, vertical = 8.dp)
        ) {}

        when {
            isLoading -&gt; CircularProgressIndicator(modifier = Modifier.padding(32.dp))
            error != null -&gt; Text("Error: $error", modifier = Modifier.padding(16.dp))
            filtered.isEmpty() -&gt; Text("No customers found", modifier = Modifier.padding(16.dp))
            else -&gt; LazyColumn {
                items(filtered) { customer -&gt;
                    ListItem(
                        headlineContent = { Text(customer.name) },
                        supportingContent = { Text(customer.phone) },
                        overlineContent = { Text("${customer.city}, ${customer.state} ${customer.zip}") },
                        modifier = Modifier.clickable {
                            navController.navigate("customers/${customer.id}")
                        }
                    )
                    HorizontalDivider()
                }
            }
        }
    }
}
</hick:file>

<hick:file path="android/app/src/main/kotlin/com/acmedrainage/blueironcube/screens/customers/CustomerDetailScreen.kt">package <hick:val name="bundle_id" />.screens.customers

import androidx.compose.foundation.layout.*
import androidx.compose.foundation.rememberScrollState
import androidx.compose.foundation.verticalScroll
import androidx.compose.material3.*
import androidx.compose.runtime.*
import androidx.compose.ui.Modifier
import androidx.compose.ui.unit.dp
import <hick:val name="bundle_id" />.api.ApiClient
import <hick:val name="bundle_id" />.models.Customer

@Composable
fun CustomerDetailScreen(customerId: String) {
    var customer by remember { mutableStateOf&lt;Customer?&gt;(null) }

    LaunchedEffect(customerId) {
        customer = try { ApiClient.get("/api/customers/$customerId") } catch (_: Exception) { null }
    }

    val c = customer
    if (c == null) {
        CircularProgressIndicator(modifier = Modifier.padding(32.dp))
        return
    }

    Column(modifier = Modifier.fillMaxSize().verticalScroll(rememberScrollState()).padding(16.dp)) {
        Text(c.name, style = MaterialTheme.typography.headlineMedium)
        Spacer(Modifier.height(16.dp))
        Text("Contact", style = MaterialTheme.typography.titleSmall)
        Text("Phone: ${c.phone}")
        c.email?.let { Text("Email: $it") }
        Spacer(Modifier.height(12.dp))
        Text("Address", style = MaterialTheme.typography.titleSmall)
        Text(c.address)
        Text("${c.city}, ${c.state} ${c.zip}")
        c.referralSource?.let {
            Spacer(Modifier.height(12.dp))
            Text("Referral", style = MaterialTheme.typography.titleSmall)
            Text("Source: $it")
            c.referredBy?.let { by -&gt; Text("Referred by: $by") }
        }
        c.notes?.let {
            Spacer(Modifier.height(12.dp))
            Text("Notes", style = MaterialTheme.typography.titleSmall)
            Text(it)
        }
    }
}
</hick:file>
</hick:when>

