### API Layer

<hick:file path="android/app/src/main/kotlin/com/acmedrainage/blueironcube/api/ApiClient.kt">package <hick:val name="bundle_id" />.api

import io.ktor.client.*
import io.ktor.client.call.*
import io.ktor.client.engine.okhttp.*
import io.ktor.client.plugins.contentnegotiation.*
import io.ktor.client.request.*
import io.ktor.http.*
import io.ktor.serialization.kotlinx.json.*
import kotlinx.serialization.json.Json

object ApiClient {
    private const val BASE_URL = "http://10.0.2.2:3000"

    private val json = Json {
        ignoreUnknownKeys = true
        isLenient = true
    }

    private val client = HttpClient(OkHttp) {
        install(ContentNegotiation) {
            json(json)
        }
    }

    suspend inline fun &lt;reified T&gt; get(path: String): T {
        return client.get("$BASE_URL$path").body()
    }

    suspend inline fun &lt;reified T&gt; post(path: String, body: Any): T {
        return client.post("$BASE_URL$path") {
            contentType(ContentType.Application.Json)
            setBody(body)
        }.body()
    }

    suspend inline fun &lt;reified T&gt; put(path: String, body: Any): T {
        return client.put("$BASE_URL$path") {
            contentType(ContentType.Application.Json)
            setBody(body)
        }.body()
    }
}
</hick:file>

<hick:file path="android/app/src/main/kotlin/com/acmedrainage/blueironcube/api/ApiError.kt">package <hick:val name="bundle_id" />.api

sealed class ApiError(message: String) : Exception(message) {
    class Network(message: String) : ApiError(message)
    class Server(val statusCode: Int) : ApiError("Server error (HTTP $statusCode)")
    class Decoding(cause: Throwable) : ApiError("Data error: ${cause.message}")
}
</hick:file>

