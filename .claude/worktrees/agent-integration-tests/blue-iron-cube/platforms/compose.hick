                    supportingContent = { Text(job.statusDisplay) },
                    trailingContent = {
                        Text(
                            "${job.completionPct}%",
                            color = if (job.completionPct == 100)
                                MaterialTheme.colorScheme.primary
                            else MaterialTheme.colorScheme.tertiary
                        )
