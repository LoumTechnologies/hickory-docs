<hick:file path="android/app/src/main/kotlin/com/acmedrainage/blueironcube/models/Customer.kt">package <hick:val name="bundle_id" />.models

import kotlinx.serialization.SerialName
import kotlinx.serialization.Serializable

@Serializable
data class Customer(
    val id: String,
    val name: String,
    val phone: String,
    val email: String? = null,
    val address: String,
    val city: String,
    val state: String,
    val zip: String,
    @SerialName("referral_source") val referralSource: String? = null,
    @SerialName("referred_by") val referredBy: String? = null,
    val notes: String? = null,
    @SerialName("created_at") val createdAt: String,
    @SerialName("updated_at") val updatedAt: String,
)

@Serializable
data class CreateCustomer(
    val name: String,
    val phone: String,
    val email: String? = null,
    val address: String,
    val city: String,
    val state: String,
    val zip: String,
    @SerialName("referral_source") val referralSource: String? = null,
    @SerialName("referred_by") val referredBy: String? = null,
    val notes: String? = null,
)
</hick:file>
</hick:when>

<hick:when test="jobs">
<hick:file path="android/app/src/main/kotlin/com/acmedrainage/blueironcube/models/Job.kt">package <hick:val name="bundle_id" />.models

import kotlinx.serialization.SerialName
import kotlinx.serialization.Serializable

@Serializable
data class Job(
    val id: String,
    @SerialName("customer_id") val customerId: String,
    val status: String,
    @SerialName("site_address") val siteAddress: String,
    @SerialName("soil_type") val soilType: String,
    @SerialName("yard_grade") val yardGrade: String,
    @SerialName("site_access") val siteAccess: String,
    @SerialName("site_notes") val siteNotes: String? = null,
    @SerialName("linear_feet_planned") val linearFeetPlanned: String? = null,
    @SerialName("linear_feet_actual") val linearFeetActual: String? = null,
    @SerialName("trench_depth_inches") val trenchDepthInches: String? = null,
    @SerialName("includes_sump_pump") val includesSumpPump: Boolean,
    @SerialName("includes_downspout_tie_in") val includesDownspoutTieIn: Boolean,
    @SerialName("number_of_catch_basins") val numberOfCatchBasins: Int,
    @SerialName("scheduled_date") val scheduledDate: String? = null,
    @SerialName("start_date") val startDate: String? = null,
    @SerialName("end_date") val endDate: String? = null,
    @SerialName("estimated_crew_hours") val estimatedCrewHours: String? = null,
    @SerialName("actual_crew_hours") val actualCrewHours: String? = null,
    @SerialName("weather_conditions") val weatherConditions: String? = null,
    @SerialName("ground_was_wet") val groundWasWet: Boolean? = null,
    @SerialName("completion_pct") val completionPct: Int,
    @SerialName("phase_assessment") val phaseAssessment: Boolean,
    @SerialName("phase_excavation") val phaseExcavation: Boolean,
    @SerialName("phase_pipe_install") val phasePipeInstall: Boolean,
    @SerialName("phase_backfill") val phaseBackfill: Boolean,
    @SerialName("phase_restoration") val phaseRestoration: Boolean,
    @SerialName("phase_walkthrough") val phaseWalkthrough: Boolean,
    @SerialName("cancellation_reason") val cancellationReason: String? = null,
    @SerialName("quoted_price") val quotedPrice: String? = null,
    @SerialName("actual_revenue") val actualRevenue: String? = null,
    @SerialName("created_at") val createdAt: String,
    @SerialName("updated_at") val updatedAt: String,
) {
    val statusDisplay: String get() = status.replace("_", " ")
        .replaceFirstChar { it.uppercase() }
}

@Serializable
data class JobCostBreakdown(
    @SerialName("job_id") val jobId: String,
    @SerialName("material_cost") val materialCost: String,
    @SerialName("labor_cost") val laborCost: String,
    @SerialName("equipment_cost") val equipmentCost: String,
    @SerialName("processing_fees") val processingFees: String,
    @SerialName("overhead_allocated") val overheadAllocated: String,
    @SerialName("direct_cost") val directCost: String,
    @SerialName("true_cost") val trueCost: String,
    val revenue: String,
    @SerialName("gross_margin") val grossMargin: String,
    @SerialName("true_margin") val trueMargin: String,
    @SerialName("true_margin_pct") val trueMarginPct: String,
    @SerialName("completion_pct") val completionPct: Int,
)
