import <hick:val name="bundle_id" />.models.CreatePayment
import <hick:val name="bundle_id" />.models.Payment

@Composable
fun PaymentFormScreen() {
    var jobId by remember { mutableStateOf("") }
    var amount by remember { mutableStateOf("") }
    var method by remember { mutableStateOf("cash") }
    var reference by remember { mutableStateOf("") }
    var isSaving by remember { mutableStateOf(false) }
    var lastPayment by remember { mutableStateOf&lt;Payment?&gt;(null) }

    val methods = listOf("cash", "check", "credit_card", "debit_card", "ach", "financing")

    Column(modifier = Modifier.fillMaxSize().verticalScroll(rememberScrollState()).padding(16.dp)) {
        Text("Record Payment", style = MaterialTheme.typography.headlineMedium)
        Spacer(Modifier.height(16.dp))

        OutlinedTextField(value = jobId, onValueChange = { jobId = it },
            label = { Text("Job ID") }, modifier = Modifier.fillMaxWidth())
        Spacer(Modifier.height(8.dp))
        OutlinedTextField(value = amount, onValueChange = { amount = it },
            label = { Text("Amount") }, modifier = Modifier.fillMaxWidth())
        Spacer(Modifier.height(8.dp))
        OutlinedTextField(value = reference, onValueChange = { reference = it },
            label = { Text("Reference (optional)") }, modifier = Modifier.fillMaxWidth())
        Spacer(Modifier.height(16.dp))

        Button(
            onClick = {
                isSaving = true
                // Fire-and-forget in LaunchedEffect pattern would be better,
                // but kept simple for template
            },
            enabled = jobId.isNotBlank() &amp;&amp; amount.isNotBlank() &amp;&amp; !isSaving,
            modifier = Modifier.fillMaxWidth()
        ) {
            Text("Record Payment")
        }

        lastPayment?.let { p -&gt;
            Spacer(Modifier.height(16.dp))
            Text("Last Recorded", style = MaterialTheme.typography.titleSmall)
            Text("ID: ${p.id}")
            Text("Amount: $${p.amount}")
            Text("Fee: $${p.processingFeeAmount}")
        }
    }
}
</hick:file>
</hick:when>

<hick:when test="inventory">
<hick:file path="android/app/src/main/kotlin/com/acmedrainage/blueironcube/screens/inventory/InventoryListScreen.kt">package <hick:val name="bundle_id" />.screens.inventory

import androidx.compose.foundation.layout.*
import androidx.compose.foundation.lazy.LazyColumn
import androidx.compose.foundation.lazy.items
import androidx.compose.material3.*
import androidx.compose.runtime.*
import androidx.compose.ui.Modifier
import androidx.compose.ui.unit.dp
import <hick:val name="bundle_id" />.api.ApiClient
import <hick:val name="bundle_id" />.models.InventoryItem

@Composable
fun InventoryListScreen() {
    var items by remember { mutableStateOf&lt;List&lt;InventoryItem&gt;&gt;(emptyList()) }
    var isLoading by remember { mutableStateOf(true) }
    var showLowStockOnly by remember { mutableStateOf(false) }

    LaunchedEffect(Unit) {
        items = try { ApiClient.get("/api/inventory") } catch (_: Exception) { emptyList() }
        isLoading = false
    }

    val displayed = if (showLowStockOnly) items.filter { it.isLowStock } else items

    Column(modifier = Modifier.fillMaxSize()) {
        Row(modifier = Modifier.padding(16.dp)) {
            Text("Inventory", style = MaterialTheme.typography.headlineMedium,
                modifier = Modifier.weight(1f))
            FilterChip(selected = showLowStockOnly,
                onClick = { showLowStockOnly = !showLowStockOnly },
                label = { Text("Low Stock") })
        }
        when {
            isLoading -&gt; CircularProgressIndicator(modifier = Modifier.padding(32.dp))
            else -&gt; LazyColumn {
                items(displayed) { item -&gt;
                    ListItem(
                        headlineContent = { Text(item.name) },
                        supportingContent = { Text("${item.category} — ${item.unit}") },
                        trailingContent = {
                            Column {
                                Text(item.quantityOnHand,
                                    color = if (item.isLowStock)
                                        MaterialTheme.colorScheme.error
                                    else MaterialTheme.colorScheme.onSurface)
                                Text("$${item.unitCost}/${item.unit}",
                                    style = MaterialTheme.typography.bodySmall)
                            }
                        }
                    )
                    HorizontalDivider()
                }
            }
        }
    }
}
</hick:file>
</hick:when>

