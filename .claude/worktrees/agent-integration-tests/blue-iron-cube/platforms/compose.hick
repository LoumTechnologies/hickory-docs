<hick:file path="android/app/src/main/kotlin/com/acmedrainage/blueironcube/screens/jobs/JobDetailScreen.kt">package <hick:val name="bundle_id" />.screens.jobs

import androidx.compose.foundation.layout.*
import androidx.compose.foundation.rememberScrollState
import androidx.compose.foundation.verticalScroll
import androidx.compose.material3.*
import androidx.compose.runtime.*
import androidx.compose.ui.Modifier
import androidx.compose.ui.unit.dp
import androidx.navigation.NavController
import <hick:val name="bundle_id" />.api.ApiClient
import <hick:val name="bundle_id" />.models.Job
import <hick:val name="bundle_id" />.models.JobCostBreakdown

@Composable
fun JobDetailScreen(jobId: String, navController: NavController) {
    var job by remember { mutableStateOf&lt;Job?&gt;(null) }
    var costs by remember { mutableStateOf&lt;JobCostBreakdown?&gt;(null) }

    LaunchedEffect(jobId) {
        job = try { ApiClient.get("/api/jobs/$jobId") } catch (_: Exception) { null }
        costs = try { ApiClient.get("/api/jobs/$jobId/costs") } catch (_: Exception) { null }
    }

    val j = job
    if (j == null) {
        CircularProgressIndicator(modifier = Modifier.padding(32.dp))
        return
    }

    Column(modifier = Modifier.fillMaxSize().verticalScroll(rememberScrollState()).padding(16.dp)) {
        Text("Job Details", style = MaterialTheme.typography.headlineMedium)
        Spacer(Modifier.height(16.dp))

        Text("Status", style = MaterialTheme.typography.titleSmall)
        Text("${j.statusDisplay} — ${j.completionPct}%")
        LinearProgressIndicator(
            progress = { j.completionPct / 100f },
            modifier = Modifier.fillMaxWidth().padding(vertical = 8.dp)
        )

        Spacer(Modifier.height(12.dp))
        Text("Site", style = MaterialTheme.typography.titleSmall)
        Text("Address: ${j.siteAddress}")
        Text("Soil: ${j.soilType} | Grade: ${j.yardGrade} | Access: ${j.siteAccess}")

        Spacer(Modifier.height(12.dp))
        Text("Scope", style = MaterialTheme.typography.titleSmall)
        j.linearFeetPlanned?.let { Text("Linear feet (planned): $it") }
        j.trenchDepthInches?.let { Text("Trench depth: $it in") }
        Text("Sump pump: ${if (j.includesSumpPump) "Yes" else "No"}")
        Text("Downspout tie-in: ${if (j.includesDownspoutTieIn) "Yes" else "No"}")
        Text("Catch basins: ${j.numberOfCatchBasins}")

        Spacer(Modifier.height(12.dp))
        Text("Phases", style = MaterialTheme.typography.titleSmall)
        PhaseRow("Assessment", j.phaseAssessment)
        PhaseRow("Excavation", j.phaseExcavation)
        PhaseRow("Pipe Install", j.phasePipeInstall)
        PhaseRow("Backfill", j.phaseBackfill)
        PhaseRow("Restoration", j.phaseRestoration)
        PhaseRow("Walkthrough", j.phaseWalkthrough)

        costs?.let { c -&gt;
            Spacer(Modifier.height(12.dp))
            Text("Costs", style = MaterialTheme.typography.titleSmall)
            Text("Material: $${ c.materialCost}")
            Text("Labor: $${c.laborCost}")
            Text("Equipment: $${c.equipmentCost}")
            Text("Processing fees: $${c.processingFees}")
            Text("Overhead: $${c.overheadAllocated}")
            Text("True cost: $${c.trueCost}", style = MaterialTheme.typography.titleMedium)
            Text("Revenue: $${c.revenue}")
            Text("True margin: ${c.trueMarginPct}%")
        }
    }
}

@Composable
private fun PhaseRow(name: String, done: Boolean) {
    Row(modifier = Modifier.padding(vertical = 2.dp)) {
        Text(if (done) "✓" else "○", modifier = Modifier.width(24.dp))
        Text(name)
    }
}
</hick:file>
</hick:when>

