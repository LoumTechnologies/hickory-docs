<hick:when test="estimating">
<hick:file path="android/app/src/main/kotlin/com/acmedrainage/blueironcube/screens/estimating/EstimateFormScreen.kt">package <hick:val name="bundle_id" />.screens.estimating

import androidx.compose.foundation.layout.*
import androidx.compose.foundation.rememberScrollState
import androidx.compose.foundation.verticalScroll
import androidx.compose.material3.*
import androidx.compose.runtime.*
import androidx.compose.ui.Modifier
import androidx.compose.ui.unit.dp
import <hick:val name="bundle_id" />.api.ApiClient
import <hick:val name="bundle_id" />.models.Estimate
import <hick:val name="bundle_id" />.models.EstimateRequest

@Composable
fun EstimateFormScreen() {
    var linearFeet by remember { mutableStateOf("") }
    var trenchDepth by remember { mutableStateOf("") }
    var soilType by remember { mutableStateOf("mixed") }
    var yardGrade by remember { mutableStateOf("flat") }
    var siteAccess by remember { mutableStateOf("easy") }
    var sumpPump by remember { mutableStateOf(false) }
    var downspout by remember { mutableStateOf(false) }
    var catchBasins by remember { mutableIntStateOf(0) }
    var marginPct by remember { mutableStateOf("25") }
    var result by remember { mutableStateOf&lt;Estimate?&gt;(null) }
    var isCalculating by remember { mutableStateOf(false) }

    Column(modifier = Modifier.fillMaxSize().verticalScroll(rememberScrollState()).padding(16.dp)) {
        Text("New Estimate", style = MaterialTheme.typography.headlineMedium)
        Spacer(Modifier.height(16.dp))

        OutlinedTextField(value = linearFeet, onValueChange = { linearFeet = it },
            label = { Text("Linear feet") }, modifier = Modifier.fillMaxWidth())
        Spacer(Modifier.height(8.dp))
        OutlinedTextField(value = trenchDepth, onValueChange = { trenchDepth = it },
            label = { Text("Trench depth (inches)") }, modifier = Modifier.fillMaxWidth())
        Spacer(Modifier.height(8.dp))

        Row {
            Switch(checked = sumpPump, onCheckedChange = { sumpPump = it })
            Spacer(Modifier.width(8.dp))
            Text("Sump pump")
        }
        Row {
            Switch(checked = downspout, onCheckedChange = { downspout = it })
            Spacer(Modifier.width(8.dp))
            Text("Downspout tie-in")
        }

        Spacer(Modifier.height(8.dp))
        OutlinedTextField(value = marginPct, onValueChange = { marginPct = it },
            label = { Text("Target margin %") }, modifier = Modifier.fillMaxWidth())
        Spacer(Modifier.height(16.dp))

        Button(
            onClick = { isCalculating = true },
            enabled = linearFeet.isNotBlank() &amp;&amp; trenchDepth.isNotBlank() &amp;&amp; !isCalculating,
            modifier = Modifier.fillMaxWidth()
        ) {
            Text("Generate Estimate")
        }

        result?.let { est -&gt;
            Spacer(Modifier.height(16.dp))
            Card(modifier = Modifier.fillMaxWidth()) {
                Column(modifier = Modifier.padding(16.dp)) {
                    Text("Quoted Price: $${est.quotedPrice}",
                        style = MaterialTheme.typography.headlineSmall)
                    Spacer(Modifier.height(8.dp))
                    Text("Material: $${est.predictedMaterialCost}")
                    Text("Labor: $${est.predictedLaborCost}")
                    Text("Equipment: $${est.predictedEquipmentCost}")
                    Text("Total cost: $${est.predictedTotalCost}")
                    Text("Crew hours: ${est.predictedCrewHours}")
                    Spacer(Modifier.height(8.dp))
                    Text(est.confidenceNote, style = MaterialTheme.typography.bodySmall)
                }
            }
        }
    }
}
</hick:file>
</hick:when>

