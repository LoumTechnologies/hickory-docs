    var equipment by remember { mutableStateOf&lt;List&lt;Equipment&gt;&gt;(emptyList()) }
    var isLoading by remember { mutableStateOf(true) }

    LaunchedEffect(Unit) {
        vehicles = try { ApiClient.get("/api/fleet/vehicles") } catch (_: Exception) { emptyList() }
        equipment = try { ApiClient.get("/api/fleet/equipment") } catch (_: Exception) { emptyList() }
        isLoading = false
    }

    when {
        isLoading -&gt; CircularProgressIndicator(modifier = Modifier.padding(32.dp))
