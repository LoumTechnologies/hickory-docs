<hick:file path="android/app/src/main/kotlin/com/acmedrainage/blueironcube/screens/sops/SOPListScreen.kt">package <hick:val name="bundle_id" />.screens.sops

import androidx.compose.foundation.clickable
import androidx.compose.foundation.layout.*
import androidx.compose.foundation.lazy.LazyColumn
import androidx.compose.foundation.lazy.items
import androidx.compose.material3.*
import androidx.compose.runtime.*
import androidx.compose.ui.Modifier
import androidx.compose.ui.unit.dp
import androidx.navigation.NavController
import <hick:val name="bundle_id" />.api.ApiClient
import <hick:val name="bundle_id" />.models.Procedure

@Composable
fun SOPListScreen(navController: NavController) {
    var procedures by remember { mutableStateOf&lt;List&lt;Procedure&gt;&gt;(emptyList()) }
    var isLoading by remember { mutableStateOf(true) }

    LaunchedEffect(Unit) {
        procedures = try { ApiClient.get("/api/sops") } catch (_: Exception) { emptyList() }
        isLoading = false
    }

    val grouped = procedures.groupBy { it.category }

    when {
        isLoading -&gt; CircularProgressIndicator(modifier = Modifier.padding(32.dp))
        procedures.isEmpty() -&gt; Text("No procedures", modifier = Modifier.padding(16.dp))
        else -&gt; LazyColumn(modifier = Modifier.fillMaxSize()) {
            grouped.keys.sorted().forEach { category -&gt;
                item {
                    Text(
                        category.replace("_", " ").replaceFirstChar { it.uppercase() },
                        style = MaterialTheme.typography.titleMedium,
                        modifier = Modifier.padding(16.dp, 12.dp, 16.dp, 4.dp)
                    )
                }
                items(grouped[category]!!) { proc -&gt;
                    ListItem(
                        headlineContent = { Text(proc.title) },
                        supportingContent = {
                            Text("v${proc.version}" +
                                (proc.estimatedDurationMinutes?.let { " — ~${it} min" } ?: ""))
                        },
                        modifier = Modifier.clickable {
                            navController.navigate("sops/${proc.id}")
                        }
                    )
                    HorizontalDivider()
                }
            }
        }
    }
}
</hick:file>

<hick:file path="android/app/src/main/kotlin/com/acmedrainage/blueironcube/screens/sops/SOPDetailScreen.kt">package <hick:val name="bundle_id" />.screens.sops

import androidx.compose.foundation.layout.*
import androidx.compose.foundation.lazy.LazyColumn
import androidx.compose.foundation.lazy.items
import androidx.compose.material3.*
import androidx.compose.runtime.*
import androidx.compose.ui.Modifier
import androidx.compose.ui.unit.dp
import <hick:val name="bundle_id" />.api.ApiClient
import <hick:val name="bundle_id" />.models.ProcedureWithSteps

@Composable
fun SOPDetailScreen(procedureId: String) {
    var procedure by remember { mutableStateOf&lt;ProcedureWithSteps?&gt;(null) }
    var isLoading by remember { mutableStateOf(true) }

    LaunchedEffect(procedureId) {
        procedure = try { ApiClient.get("/api/sops/$procedureId") } catch (_: Exception) { null }
        isLoading = false
    }

    val p = procedure
    when {
        isLoading -&gt; CircularProgressIndicator(modifier = Modifier.padding(32.dp))
        p == null -&gt; Text("Not found", modifier = Modifier.padding(16.dp))
        else -&gt; LazyColumn(modifier = Modifier.fillMaxSize().padding(16.dp)) {
            item {
                Text(p.title, style = MaterialTheme.typography.headlineMedium)
                Spacer(Modifier.height(8.dp))
            }
            p.description?.let { desc -&gt;
                item { Text(desc); Spacer(Modifier.height(12.dp)) }
            }
            p.safetyNotes?.let { safety -&gt;
                item {
                    Card(colors = CardDefaults.cardColors(
                        containerColor = MaterialTheme.colorScheme.errorContainer
                    )) {
                        Text("Safety: $safety", modifier = Modifier.padding(12.dp))
                    }
                    Spacer(Modifier.height(12.dp))
                }
            }
            item { Text("Steps", style = MaterialTheme.typography.titleMedium); Spacer(Modifier.height(8.dp)) }
            items(p.steps) { step -&gt;
                Row(modifier = Modifier.padding(vertical = 4.dp)) {
                    Text("${step.stepNumber}.", modifier = Modifier.width(32.dp),
                        style = MaterialTheme.typography.titleMedium)
                    Column {
                        Text(step.instruction)
                        if (step.isCheckpoint) {
                            Text("Checkpoint — requires sign-off",
                                style = MaterialTheme.typography.bodySmall,
                                color = MaterialTheme.colorScheme.primary)
                        }
                        step.notes?.let {
                            Text(it, style = MaterialTheme.typography.bodySmall,
                                color = MaterialTheme.colorScheme.onSurfaceVariant)
                        }
                    }
                }
            }
        }
    }
}
</hick:file>
</hick:when>

