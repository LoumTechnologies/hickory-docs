<hick:file path="android/app/src/main/kotlin/com/acmedrainage/blueironcube/screens/crm/LeadPipelineScreen.kt">package <hick:val name="bundle_id" />.screens.crm

import androidx.compose.foundation.clickable
import androidx.compose.foundation.layout.*
import androidx.compose.foundation.lazy.LazyColumn
import androidx.compose.foundation.lazy.items
import androidx.compose.material3.*
import androidx.compose.runtime.*
import androidx.compose.ui.Modifier
import androidx.compose.ui.unit.dp
import androidx.navigation.NavController
import <hick:val name="bundle_id" />.api.ApiClient
import <hick:val name="bundle_id" />.models.Lead

@Composable
fun LeadPipelineScreen(navController: NavController) {
    var leads by remember { mutableStateOf&lt;List&lt;Lead&gt;&gt;(emptyList()) }
    var isLoading by remember { mutableStateOf(true) }

    val stages = listOf("new_lead", "contacted", "site_visit_scheduled",
        "site_visit_completed", "estimate_sent", "negotiating", "won", "lost")

    LaunchedEffect(Unit) {
        leads = try { ApiClient.get("/api/crm/leads") } catch (_: Exception) { emptyList() }
        isLoading = false
    }

    when {
        isLoading -&gt; CircularProgressIndicator(modifier = Modifier.padding(32.dp))
        leads.isEmpty() -&gt; Text("No leads", modifier = Modifier.padding(16.dp))
        else -&gt; LazyColumn(modifier = Modifier.fillMaxSize()) {
            stages.forEach { stage -&gt;
                val stageLeads = leads.filter { it.status == stage }
                if (stageLeads.isNotEmpty()) {
                    item {
                        Text(
                            stage.replace("_", " ").replaceFirstChar { it.uppercase() },
                            style = MaterialTheme.typography.titleMedium,
                            modifier = Modifier.padding(16.dp, 12.dp, 16.dp, 4.dp)
                        )
                    }
                    items(stageLeads) { lead -&gt;
                        ListItem(
                            headlineContent = { Text("Customer: ${lead.customerId}") },
                            supportingContent = { Text(lead.source) },
                            trailingContent = {
                                lead.estimatedValue?.let { Text("$$it") }
                            },
                            modifier = Modifier.clickable {
                                navController.navigate("crm/${lead.id}")
                            }
                        )
                        HorizontalDivider()
                    }
                }
            }
        }
    }
}
</hick:file>

