import androidx.navigation.NavController
import <hick:val name="bundle_id" />.api.ApiClient
import <hick:val name="bundle_id" />.models.Job

@Composable
fun JobListScreen(navController: NavController) {
    var jobs by remember { mutableStateOf&lt;List&lt;Job&gt;&gt;(emptyList()) }
    var isLoading by remember { mutableStateOf(true) }
    var error by remember { mutableStateOf&lt;String?&gt;(null) }

    LaunchedEffect(Unit) {
        try {
            jobs = ApiClient.get("/api/jobs")
        } catch (e: Exception) {
            error = e.message
        }
        isLoading = false
    }

    when {
        isLoading -&gt; Box(Modifier.fillMaxSize(), contentAlignment = Alignment.Center) {
            CircularProgressIndicator()
        }
        error != null -&gt; Text("Error: $error", modifier = Modifier.padding(16.dp))
        jobs.isEmpty() -&gt; Text("No jobs found", modifier = Modifier.padding(16.dp))
        else -&gt; LazyColumn {
