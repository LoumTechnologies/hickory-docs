### MainActivity

<hick:file path="android/app/src/main/kotlin/com/acmedrainage/blueironcube/MainActivity.kt">package <hick:val name="bundle_id" />

import android.os.Bundle
import androidx.activity.ComponentActivity
import androidx.activity.compose.setContent
import androidx.activity.enableEdgeToEdge
import androidx.compose.foundation.layout.*
import androidx.compose.material.icons.Icons
import androidx.compose.material.icons.filled.*
import androidx.compose.material3.*
import androidx.compose.runtime.*
import androidx.compose.ui.Modifier
import androidx.compose.ui.graphics.vector.ImageVector
import androidx.navigation.NavHostController
import androidx.navigation.compose.*
import <hick:val name="bundle_id" />.ui.theme.<hick:val name="project_name" />Theme

class MainActivity : ComponentActivity() {
    override fun onCreate(savedInstanceState: Bundle?) {
        super.onCreate(savedInstanceState)
        enableEdgeToEdge()
        setContent {
            <hick:val name="project_name" />Theme {
                MainApp()
            }
        }
    }
}

sealed class Screen(val route: String, val title: String, val icon: ImageVector) {
<hick:when test="jobs">    data object Jobs : Screen("jobs", "Jobs", Icons.Filled.Construction)
</hick:when>
<hick:when test="customers">    data object Customers : Screen("customers", "Customers", Icons.Filled.People)
</hick:when>
<hick:when test="crew">    data object Crew : Screen("crew", "Crew", Icons.Filled.Groups)
</hick:when>
<hick:when test="crm">    data object CRM : Screen("crm", "CRM", Icons.Filled.TrendingUp)
</hick:when>
    data object More : Screen("more", "More", Icons.Filled.MoreHoriz)
}

@OptIn(ExperimentalMaterial3Api::class)
@Composable
fun MainApp() {
    val navController = rememberNavController()
    val screens = listOf(
<hick:when test="jobs">        Screen.Jobs,
</hick:when>
<hick:when test="customers">        Screen.Customers,
</hick:when>
<hick:when test="crew">        Screen.Crew,
</hick:when>
<hick:when test="crm">        Screen.CRM,
</hick:when>
        Screen.More,
    )
    val navBackStackEntry by navController.currentBackStackEntryAsState()
    val currentRoute = navBackStackEntry?.destination?.route

    Scaffold(
        modifier = Modifier.fillMaxSize(),
        bottomBar = {
            NavigationBar {
                screens.forEach { screen -&gt;
                    NavigationBarItem(
                        icon = { Icon(screen.icon, contentDescription = screen.title) },
                        label = { Text(screen.title) },
                        selected = currentRoute == screen.route,
                        onClick = {
                            navController.navigate(screen.route) {
                                popUpTo(navController.graph.startDestinationId) { saveState = true }
                                launchSingleTop = true
                                restoreState = true
                            }
                        }
                    )
                }
            }
        }
    ) { innerPadding -&gt;
        NavHost(
            navController = navController,
            startDestination = screens.first().route,
            modifier = Modifier.padding(innerPadding)
        ) {
<hick:when test="jobs">            composable("jobs") { <hick:val name="bundle_id" />.screens.jobs.JobListScreen(navController) }
            composable("jobs/{jobId}") { backStackEntry -&gt;
                <hick:val name="bundle_id" />.screens.jobs.JobDetailScreen(
                    jobId = backStackEntry.arguments?.getString("jobId") ?: "",
                    navController = navController
                )
            }
</hick:when>
<hick:when test="customers">            composable("customers") { <hick:val name="bundle_id" />.screens.customers.CustomerListScreen(navController) }
            composable("customers/{customerId}") { backStackEntry -&gt;
                <hick:val name="bundle_id" />.screens.customers.CustomerDetailScreen(
                    customerId = backStackEntry.arguments?.getString("customerId") ?: ""
                )
            }
</hick:when>
<hick:when test="crew">            composable("crew") { <hick:val name="bundle_id" />.screens.crew.CrewListScreen(navController) }
            composable("crew/{crewId}/time") { backStackEntry -&gt;
                <hick:val name="bundle_id" />.screens.crew.TimeEntryScreen(
                    crewId = backStackEntry.arguments?.getString("crewId") ?: ""
                )
            }
</hick:when>
<hick:when test="crm">            composable("crm") { <hick:val name="bundle_id" />.screens.crm.LeadPipelineScreen(navController) }
            composable("crm/{leadId}") { backStackEntry -&gt;
                <hick:val name="bundle_id" />.screens.crm.LeadDetailScreen(
                    leadId = backStackEntry.arguments?.getString("leadId") ?: ""
                )
            }
</hick:when>
            composable("more") { MoreScreen(navController) }
<hick:when test="inventory">            composable("inventory") { <hick:val name="bundle_id" />.screens.inventory.InventoryListScreen() }
</hick:when>
<hick:when test="fleet">            composable("fleet") { <hick:val name="bundle_id" />.screens.fleet.FleetListScreen() }
</hick:when>
<hick:when test="payments">            composable("payments") { <hick:val name="bundle_id" />.screens.payments.PaymentFormScreen() }
</hick:when>
<hick:when test="overhead">            composable("overhead") { <hick:val name="bundle_id" />.screens.overhead.OverheadScreen() }
</hick:when>
<hick:when test="estimating">            composable("estimating") { <hick:val name="bundle_id" />.screens.estimating.EstimateFormScreen() }
</hick:when>
<hick:when test="sops">            composable("sops") { <hick:val name="bundle_id" />.screens.sops.SOPListScreen(navController) }
            composable("sops/{sopId}") { backStackEntry -&gt;
                <hick:val name="bundle_id" />.screens.sops.SOPDetailScreen(
                    procedureId = backStackEntry.arguments?.getString("sopId") ?: ""
                )
            }
</hick:when>
        }
    }
}

@Composable
fun MoreScreen(navController: NavHostController) {
    Column(modifier = Modifier.fillMaxSize().padding(androidx.compose.ui.unit.dp.let { _ -&gt; androidx.compose.ui.unit.Dp(16f) }.let { p -&gt; PaddingValues(p) })) {
        Text("More", style = MaterialTheme.typography.headlineMedium,
            modifier = Modifier.padding(bottom = androidx.compose.ui.unit.Dp(16f)))
<hick:when test="inventory">
        TextButton(onClick = { navController.navigate("inventory") }) {
            Icon(Icons.Filled.Inventory, contentDescription = null)
            Spacer(Modifier.width(androidx.compose.ui.unit.Dp(8f)))
            Text("Inventory")
        }
</hick:when>
<hick:when test="fleet">
        TextButton(onClick = { navController.navigate("fleet") }) {
            Icon(Icons.Filled.LocalShipping, contentDescription = null)
            Spacer(Modifier.width(androidx.compose.ui.unit.Dp(8f)))
            Text("Fleet")
        }
</hick:when>
<hick:when test="payments">
        TextButton(onClick = { navController.navigate("payments") }) {
            Icon(Icons.Filled.Payment, contentDescription = null)
            Spacer(Modifier.width(androidx.compose.ui.unit.Dp(8f)))
            Text("Payments")
        }
</hick:when>
<hick:when test="overhead">
        TextButton(onClick = { navController.navigate("overhead") }) {
            Icon(Icons.Filled.PieChart, contentDescription = null)
            Spacer(Modifier.width(androidx.compose.ui.unit.Dp(8f)))
            Text("Overhead")
        }
</hick:when>
<hick:when test="estimating">
        TextButton(onClick = { navController.navigate("estimating") }) {
            Icon(Icons.Filled.Calculate, contentDescription = null)
            Spacer(Modifier.width(androidx.compose.ui.unit.Dp(8f)))
            Text("Estimating")
        }
</hick:when>
<hick:when test="sops">
        TextButton(onClick = { navController.navigate("sops") }) {
            Icon(Icons.Filled.ListAlt, contentDescription = null)
            Spacer(Modifier.width(androidx.compose.ui.unit.Dp(8f)))
            Text("SOPs")
        }
</hick:when>
    }
}
</hick:file>

