### Pages

<hick:when test="jobs">
<hick:file path="web/src/pages/jobs/JobListPage.tsx">import { Link } from 'react-router-dom'
import { useJobs } from '../../hooks/useJobs'

export function JobListPage() {
  const { jobs, loading, error } = useJobs()

  if (loading) return &lt;p&gt;Loading jobs...&lt;/p&gt;
  if (error) return &lt;p&gt;Error: {error}&lt;/p&gt;

  return (
    &lt;div&gt;
      &lt;h1&gt;Jobs&lt;/h1&gt;
      &lt;table&gt;
        &lt;thead&gt;
          &lt;tr&gt;
            &lt;th&gt;Address&lt;/th&gt;
            &lt;th&gt;Status&lt;/th&gt;
            &lt;th&gt;Completion&lt;/th&gt;
          &lt;/tr&gt;
        &lt;/thead&gt;
        &lt;tbody&gt;
          {jobs.map((job) =&gt; (
            &lt;tr key={job.id}&gt;
              &lt;td&gt;&lt;Link to={`/jobs/${job.id}`}&gt;{job.siteAddress}&lt;/Link&gt;&lt;/td&gt;
              &lt;td&gt;{job.status.replace(/_/g, ' ')}&lt;/td&gt;
              &lt;td&gt;
                &lt;span className={`badge ${job.completionPct === 100 ? 'badge-green' : 'badge-orange'}`}&gt;
                  {job.completionPct}%
                &lt;/span&gt;
              &lt;/td&gt;
            &lt;/tr&gt;
          ))}
        &lt;/tbody&gt;
      &lt;/table&gt;
    &lt;/div&gt;
  )
}
</hick:file>

<hick:file path="web/src/pages/jobs/JobDetailPage.tsx">import { useState, useEffect } from 'react'
import { useParams } from 'react-router-dom'
import { apiGet } from '../../api/client'
import type { Job, JobCostBreakdown } from '../../types/job'

export function JobDetailPage() {
  const { jobId } = useParams()
  const [job, setJob] = useState&lt;Job | null&gt;(null)
  const [costs, setCosts] = useState&lt;JobCostBreakdown | null&gt;(null)

  useEffect(() =&gt; {
    if (!jobId) return
    apiGet&lt;Job&gt;(`/jobs/${jobId}`).then(setJob).catch(() =&gt; {})
    apiGet&lt;JobCostBreakdown&gt;(`/jobs/${jobId}/costs`).then(setCosts).catch(() =&gt; {})
  }, [jobId])

  if (!job) return &lt;p&gt;Loading...&lt;/p&gt;

  const phases = [
    ['Assessment', job.phaseAssessment],
    ['Excavation', job.phaseExcavation],
    ['Pipe Install', job.phasePipeInstall],
    ['Backfill', job.phaseBackfill],
    ['Restoration', job.phaseRestoration],
    ['Walkthrough', job.phaseWalkthrough],
  ] as const

  return (
    &lt;div&gt;
      &lt;h1&gt;Job Details&lt;/h1&gt;
      &lt;p&gt;{job.siteAddress} — {job.status.replace(/_/g, ' ')} ({job.completionPct}%)&lt;/p&gt;

      &lt;h2&gt;Site&lt;/h2&gt;
      &lt;p&gt;Soil: {job.soilType} | Grade: {job.yardGrade} | Access: {job.siteAccess}&lt;/p&gt;

      &lt;h2&gt;Phases&lt;/h2&gt;
      &lt;ul&gt;
        {phases.map(([name, done]) =&gt; (
          &lt;li key={name}&gt;{done ? '✓' : '○'} {name}&lt;/li&gt;
        ))}
      &lt;/ul&gt;

      {costs &amp;&amp; (
        &lt;&gt;
          &lt;h2&gt;Costs&lt;/h2&gt;
          &lt;table&gt;
            &lt;tbody&gt;
              &lt;tr&gt;&lt;td&gt;Material&lt;/td&gt;&lt;td&gt;${costs.materialCost}&lt;/td&gt;&lt;/tr&gt;
              &lt;tr&gt;&lt;td&gt;Labor&lt;/td&gt;&lt;td&gt;${costs.laborCost}&lt;/td&gt;&lt;/tr&gt;
              &lt;tr&gt;&lt;td&gt;Equipment&lt;/td&gt;&lt;td&gt;${costs.equipmentCost}&lt;/td&gt;&lt;/tr&gt;
              &lt;tr&gt;&lt;td&gt;Processing fees&lt;/td&gt;&lt;td&gt;${costs.processingFees}&lt;/td&gt;&lt;/tr&gt;
              &lt;tr&gt;&lt;td&gt;Overhead&lt;/td&gt;&lt;td&gt;${costs.overheadAllocated}&lt;/td&gt;&lt;/tr&gt;
              &lt;tr&gt;&lt;td&gt;&lt;strong&gt;True cost&lt;/strong&gt;&lt;/td&gt;&lt;td&gt;&lt;strong&gt;${costs.trueCost}&lt;/strong&gt;&lt;/td&gt;&lt;/tr&gt;
              &lt;tr&gt;&lt;td&gt;Revenue&lt;/td&gt;&lt;td&gt;${costs.revenue}&lt;/td&gt;&lt;/tr&gt;
              &lt;tr&gt;&lt;td&gt;True margin&lt;/td&gt;&lt;td&gt;{costs.trueMarginPct}%&lt;/td&gt;&lt;/tr&gt;
            &lt;/tbody&gt;
          &lt;/table&gt;
        &lt;/&gt;
      )}
    &lt;/div&gt;
  )
}
</hick:file>
</hick:when>

