<hick:when test="payments">
<hick:file path="web/src/pages/payments/PaymentFormPage.tsx">import { useState } from 'react'
import { apiPost } from '../../api/client'
import type { Payment, CreatePayment } from '../../types/payment'

export function PaymentFormPage() {
  const [jobId, setJobId] = useState('')
  const [amount, setAmount] = useState('')
  const [method, setMethod] = useState('cash')
  const [reference, setReference] = useState('')
  const [saving, setSaving] = useState(false)
  const [last, setLast] = useState&lt;Payment | null&gt;(null)

  const methods = ['cash', 'check', 'credit_card', 'debit_card', 'ach', 'financing']

  const handleSubmit = async (e: React.FormEvent) =&gt; {
    e.preventDefault()
    setSaving(true)
    try {
      const today = new Date().toISOString().slice(0, 10)
      const payment: CreatePayment = {
        jobId, date: today, amount, method,
        reference: reference || undefined,
      }
      const result = await apiPost&lt;Payment&gt;('/payments', payment)
      setLast(result)
    } catch { /* ignore */ }
    setSaving(false)
  }

  return (
    &lt;div&gt;
      &lt;h1&gt;Record Payment&lt;/h1&gt;
      &lt;form onSubmit={handleSubmit} style={{ maxWidth: 400 }}&gt;
        &lt;div className="form-group"&gt;
          &lt;label&gt;Job ID&lt;/label&gt;
          &lt;input value={jobId} onChange={(e) =&gt; setJobId(e.target.value)} /&gt;
        &lt;/div&gt;
        &lt;div className="form-group"&gt;
          &lt;label&gt;Amount&lt;/label&gt;
          &lt;input value={amount} onChange={(e) =&gt; setAmount(e.target.value)} /&gt;
        &lt;/div&gt;
        &lt;div className="form-group"&gt;
          &lt;label&gt;Method&lt;/label&gt;
          &lt;select value={method} onChange={(e) =&gt; setMethod(e.target.value)}&gt;
            {methods.map((m) =&gt; (
              &lt;option key={m} value={m}&gt;{m.replace(/_/g, ' ')}&lt;/option&gt;
            ))}
          &lt;/select&gt;
        &lt;/div&gt;
        &lt;div className="form-group"&gt;
          &lt;label&gt;Reference (optional)&lt;/label&gt;
          &lt;input value={reference} onChange={(e) =&gt; setReference(e.target.value)} /&gt;
        &lt;/div&gt;
        &lt;button type="submit" disabled={!jobId || !amount || saving}&gt;Record Payment&lt;/button&gt;
      &lt;/form&gt;
      {last &amp;&amp; (
        &lt;div style={{ marginTop: '1rem' }}&gt;
          &lt;p&gt;Recorded: {last.id} — ${last.amount} (fee: ${last.processingFeeAmount})&lt;/p&gt;
        &lt;/div&gt;
      )}
    &lt;/div&gt;
  )
}
</hick:file>
</hick:when>

<hick:when test="inventory">
<hick:file path="web/src/pages/inventory/InventoryListPage.tsx">import { useState, useEffect } from 'react'
import { apiGet } from '../../api/client'
import type { InventoryItem } from '../../types/inventory'

export function InventoryListPage() {
  const [items, setItems] = useState&lt;InventoryItem[]&gt;([])
  const [loading, setLoading] = useState(true)
  const [lowOnly, setLowOnly] = useState(false)

  useEffect(() =&gt; {
    apiGet&lt;InventoryItem[]&gt;('/inventory')
      .then(setItems)
      .finally(() =&gt; setLoading(false))
  }, [])

  const isLow = (item: InventoryItem) =&gt; {
    const qty = parseFloat(item.quantityOnHand)
    const reorder = parseFloat(item.reorderPoint)
    return !isNaN(qty) &amp;&amp; !isNaN(reorder) &amp;&amp; qty &lt;= reorder
  }

  const displayed = lowOnly ? items.filter(isLow) : items

  if (loading) return &lt;p&gt;Loading inventory...&lt;/p&gt;

  return (
    &lt;div&gt;
      &lt;h1&gt;Inventory&lt;/h1&gt;
      &lt;label&gt;
        &lt;input type="checkbox" checked={lowOnly} onChange={(e) =&gt; setLowOnly(e.target.checked)} /&gt;
        {' '}Low stock only
      &lt;/label&gt;
      &lt;table&gt;
        &lt;thead&gt;
          &lt;tr&gt;&lt;th&gt;Name&lt;/th&gt;&lt;th&gt;Category&lt;/th&gt;&lt;th&gt;Qty&lt;/th&gt;&lt;th&gt;Unit Cost&lt;/th&gt;&lt;/tr&gt;
        &lt;/thead&gt;
        &lt;tbody&gt;
          {displayed.map((item) =&gt; (
            &lt;tr key={item.id}&gt;
              &lt;td&gt;{item.name}&lt;/td&gt;
              &lt;td&gt;{item.category}&lt;/td&gt;
              &lt;td style={{ color: isLow(item) ? '#ef4444' : undefined }}&gt;{item.quantityOnHand}&lt;/td&gt;
              &lt;td&gt;${item.unitCost}/{item.unit}&lt;/td&gt;
            &lt;/tr&gt;
          ))}
        &lt;/tbody&gt;
      &lt;/table&gt;
    &lt;/div&gt;
  )
}
</hick:file>
</hick:when>

<hick:when test="fleet">
<hick:file path="web/src/pages/fleet/FleetListPage.tsx">import { useState, useEffect } from 'react'
import { apiGet } from '../../api/client'
import type { Vehicle, Equipment } from '../../types/fleet'

export function FleetListPage() {
  const [vehicles, setVehicles] = useState&lt;Vehicle[]&gt;([])
  const [equipment, setEquipment] = useState&lt;Equipment[]&gt;([])
  const [loading, setLoading] = useState(true)

  useEffect(() =&gt; {
    Promise.all([
      apiGet&lt;Vehicle[]&gt;('/fleet/vehicles').then(setVehicles),
      apiGet&lt;Equipment[]&gt;('/fleet/equipment').then(setEquipment),
    ]).finally(() =&gt; setLoading(false))
  }, [])

  if (loading) return &lt;p&gt;Loading fleet...&lt;/p&gt;

  return (
    &lt;div&gt;
      &lt;h1&gt;Fleet&lt;/h1&gt;
      {vehicles.length &gt; 0 &amp;&amp; (
        &lt;&gt;
          &lt;h2&gt;Vehicles&lt;/h2&gt;
          &lt;table&gt;
            &lt;thead&gt;&lt;tr&gt;&lt;th&gt;Vehicle&lt;/th&gt;&lt;th&gt;Type&lt;/th&gt;&lt;th&gt;Status&lt;/th&gt;&lt;/tr&gt;&lt;/thead&gt;
            &lt;tbody&gt;
              {vehicles.map((v) =&gt; (
                &lt;tr key={v.id}&gt;
                  &lt;td&gt;{v.year} {v.make} {v.model}&lt;/td&gt;
                  &lt;td&gt;{v.vehicleType}&lt;/td&gt;
                  &lt;td&gt;{v.status}&lt;/td&gt;
                &lt;/tr&gt;
              ))}
            &lt;/tbody&gt;
          &lt;/table&gt;
        &lt;/&gt;
      )}
      {equipment.length &gt; 0 &amp;&amp; (
        &lt;&gt;
          &lt;h2&gt;Equipment&lt;/h2&gt;
          &lt;table&gt;
            &lt;thead&gt;&lt;tr&gt;&lt;th&gt;Equipment&lt;/th&gt;&lt;th&gt;Type&lt;/th&gt;&lt;th&gt;Owned/Rented&lt;/th&gt;&lt;/tr&gt;&lt;/thead&gt;
            &lt;tbody&gt;
              {equipment.map((e) =&gt; (
                &lt;tr key={e.id}&gt;
                  &lt;td&gt;{e.make} {e.model}&lt;/td&gt;
                  &lt;td&gt;{e.equipmentType.replace(/_/g, ' ')}&lt;/td&gt;
                  &lt;td&gt;{e.ownedOrRented}&lt;/td&gt;
                &lt;/tr&gt;
              ))}
            &lt;/tbody&gt;
          &lt;/table&gt;
        &lt;/&gt;
      )}
    &lt;/div&gt;
  )
}
</hick:file>
</hick:when>

<hick:when test="overhead">
<hick:file path="web/src/pages/overhead/OverheadPage.tsx">import { useState, useEffect } from 'react'
import { apiGet } from '../../api/client'
import type { OverheadCategory, RecoveryRateReport } from '../../types/overhead'

export function OverheadPage() {
  const [categories, setCategories] = useState&lt;OverheadCategory[]&gt;([])
  const [report, setReport] = useState&lt;RecoveryRateReport | null&gt;(null)
  const [loading, setLoading] = useState(true)

  useEffect(() =&gt; {
    Promise.all([
      apiGet&lt;OverheadCategory[]&gt;('/overhead/categories').then(setCategories),
      apiGet&lt;RecoveryRateReport&gt;('/overhead/recovery-rate').then(setReport).catch(() =&gt; {}),
    ]).finally(() =&gt; setLoading(false))
  }, [])

  if (loading) return &lt;p&gt;Loading...&lt;/p&gt;

  return (
    &lt;div&gt;
      &lt;h1&gt;Overhead&lt;/h1&gt;
      {report &amp;&amp; (
        &lt;div style={{ marginBottom: '2rem' }}&gt;
          &lt;h2&gt;Recovery Rate&lt;/h2&gt;
          &lt;p&gt;Rate: {report.recoveryRatePct}%&lt;/p&gt;
          &lt;p&gt;Incurred: ${report.totalOverheadIncurred} | Allocated: ${report.totalOverheadAllocated}&lt;/p&gt;
          &lt;p&gt;Monthly budget: ${report.monthlyBudget} | Avg per job: ${report.avgOverheadPerJob}&lt;/p&gt;
        &lt;/div&gt;
      )}
      &lt;h2&gt;Categories&lt;/h2&gt;
      &lt;table&gt;
        &lt;thead&gt;&lt;tr&gt;&lt;th&gt;Name&lt;/th&gt;&lt;th&gt;Frequency&lt;/th&gt;&lt;th&gt;Monthly Budget&lt;/th&gt;&lt;/tr&gt;&lt;/thead&gt;
        &lt;tbody&gt;
          {categories.map((cat) =&gt; (
            &lt;tr key={cat.id}&gt;
              &lt;td&gt;{cat.name}&lt;/td&gt;
              &lt;td&gt;{cat.frequency}&lt;/td&gt;
              &lt;td&gt;${cat.monthlyBudget}&lt;/td&gt;
            &lt;/tr&gt;
          ))}
        &lt;/tbody&gt;
      &lt;/table&gt;
    &lt;/div&gt;
  )
}
</hick:file>
</hick:when>

<hick:when test="estimating">
<hick:file path="web/src/pages/estimating/EstimateFormPage.tsx">import { useState } from 'react'
import { apiPost } from '../../api/client'
import type { Estimate, EstimateRequest } from '../../types/estimate'

export function EstimateFormPage() {
  const [linearFeet, setLinearFeet] = useState('')
  const [trenchDepth, setTrenchDepth] = useState('')
  const [soilType, setSoilType] = useState('mixed')
  const [yardGrade, setYardGrade] = useState('flat')
  const [siteAccess, setSiteAccess] = useState('easy')
  const [sumpPump, setSumpPump] = useState(false)
  const [downspout, setDownspout] = useState(false)
  const [catchBasins, setCatchBasins] = useState(0)
  const [marginPct, setMarginPct] = useState('25')
  const [result, setResult] = useState&lt;Estimate | null&gt;(null)
  const [calculating, setCalculating] = useState(false)

  const handleSubmit = async (e: React.FormEvent) =&gt; {
    e.preventDefault()
    setCalculating(true)
    try {
      const req: EstimateRequest = {
        linearFeet, trenchDepthInches: trenchDepth, soilType, yardGrade, siteAccess,
        includesSumpPump: sumpPump, includesDownspoutTieIn: downspout,
        numberOfCatchBasins: catchBasins, desiredMarginPct: marginPct,
      }
      setResult(await apiPost&lt;Estimate&gt;('/estimates', req))
    } catch { /* ignore */ }
    setCalculating(false)
  }

  return (
    &lt;div&gt;
      &lt;h1&gt;New Estimate&lt;/h1&gt;
      &lt;form onSubmit={handleSubmit} style={{ maxWidth: 400 }}&gt;
        &lt;div className="form-group"&gt;
          &lt;label&gt;Linear feet&lt;/label&gt;
          &lt;input value={linearFeet} onChange={(e) =&gt; setLinearFeet(e.target.value)} /&gt;
        &lt;/div&gt;
        &lt;div className="form-group"&gt;
          &lt;label&gt;Trench depth (inches)&lt;/label&gt;
          &lt;input value={trenchDepth} onChange={(e) =&gt; setTrenchDepth(e.target.value)} /&gt;
        &lt;/div&gt;
        &lt;div className="form-group"&gt;
          &lt;label&gt;Soil type&lt;/label&gt;
          &lt;select value={soilType} onChange={(e) =&gt; setSoilType(e.target.value)}&gt;
            {['clay','sand','loam','rocky','mixed'].map((s) =&gt; &lt;option key={s} value={s}&gt;{s}&lt;/option&gt;)}
          &lt;/select&gt;
        &lt;/div&gt;
        &lt;div className="form-group"&gt;
          &lt;label&gt;Yard grade&lt;/label&gt;
          &lt;select value={yardGrade} onChange={(e) =&gt; setYardGrade(e.target.value)}&gt;
            {['flat','slight','moderate','steep'].map((g) =&gt; &lt;option key={g} value={g}&gt;{g}&lt;/option&gt;)}
          &lt;/select&gt;
        &lt;/div&gt;
        &lt;div className="form-group"&gt;
          &lt;label&gt;Site access&lt;/label&gt;
          &lt;select value={siteAccess} onChange={(e) =&gt; setSiteAccess(e.target.value)}&gt;
            {['easy','moderate','difficult','hand_carry_only'].map((a) =&gt;
              &lt;option key={a} value={a}&gt;{a.replace(/_/g, ' ')}&lt;/option&gt;)}
          &lt;/select&gt;
        &lt;/div&gt;
        &lt;div className="form-group"&gt;
          &lt;label&gt;&lt;input type="checkbox" checked={sumpPump} onChange={(e) =&gt; setSumpPump(e.target.checked)} /&gt; Sump pump&lt;/label&gt;
        &lt;/div&gt;
        &lt;div className="form-group"&gt;
          &lt;label&gt;&lt;input type="checkbox" checked={downspout} onChange={(e) =&gt; setDownspout(e.target.checked)} /&gt; Downspout tie-in&lt;/label&gt;
        &lt;/div&gt;
        &lt;div className="form-group"&gt;
          &lt;label&gt;Catch basins&lt;/label&gt;
          &lt;input type="number" value={catchBasins} onChange={(e) =&gt; setCatchBasins(parseInt(e.target.value) || 0)} /&gt;
        &lt;/div&gt;
        &lt;div className="form-group"&gt;
          &lt;label&gt;Target margin %&lt;/label&gt;
          &lt;input value={marginPct} onChange={(e) =&gt; setMarginPct(e.target.value)} /&gt;
        &lt;/div&gt;
        &lt;button type="submit" disabled={!linearFeet || !trenchDepth || calculating}&gt;Generate Estimate&lt;/button&gt;
      &lt;/form&gt;
      {result &amp;&amp; (
        &lt;div style={{ marginTop: '2rem' }}&gt;
          &lt;h2&gt;Quoted Price: ${result.quotedPrice}&lt;/h2&gt;
          &lt;p&gt;Material: ${result.predictedMaterialCost} | Labor: ${result.predictedLaborCost}&lt;/p&gt;
          &lt;p&gt;Equipment: ${result.predictedEquipmentCost} | Total: ${result.predictedTotalCost}&lt;/p&gt;
          &lt;p&gt;Crew hours: {result.predictedCrewHours}&lt;/p&gt;
          &lt;p&gt;&lt;em&gt;{result.confidenceNote}&lt;/em&gt;&lt;/p&gt;
        &lt;/div&gt;
      )}
    &lt;/div&gt;
  )
}
</hick:file>
</hick:when>

<hick:when test="crm">
<hick:file path="web/src/pages/crm/LeadPipelinePage.tsx">import { useState, useEffect } from 'react'
import { apiGet } from '../../api/client'
import type { Lead } from '../../types/crm'

const stages = ['new_lead', 'contacted', 'site_visit_scheduled',
  'site_visit_completed', 'estimate_sent', 'negotiating', 'won', 'lost']

export function LeadPipelinePage() {
  const [leads, setLeads] = useState&lt;Lead[]&gt;([])
  const [loading, setLoading] = useState(true)

  useEffect(() =&gt; {
    apiGet&lt;Lead[]&gt;('/crm/leads')
      .then(setLeads)
      .finally(() =&gt; setLoading(false))
  }, [])

  if (loading) return &lt;p&gt;Loading pipeline...&lt;/p&gt;

  return (
    &lt;div&gt;
      &lt;h1&gt;Lead Pipeline&lt;/h1&gt;
      {stages.map((stage) =&gt; {
        const stageLeads = leads.filter((l) =&gt; l.status === stage)
        if (stageLeads.length === 0) return null
        return (
          &lt;div key={stage} style={{ marginBottom: '1.5rem' }}&gt;
            &lt;h2&gt;{stage.replace(/_/g, ' ')}&lt;/h2&gt;
            &lt;table&gt;
              &lt;thead&gt;&lt;tr&gt;&lt;th&gt;Customer&lt;/th&gt;&lt;th&gt;Source&lt;/th&gt;&lt;th&gt;Value&lt;/th&gt;&lt;/tr&gt;&lt;/thead&gt;
              &lt;tbody&gt;
                {stageLeads.map((lead) =&gt; (
                  &lt;tr key={lead.id}&gt;
                    &lt;td&gt;{lead.customerId}&lt;/td&gt;
                    &lt;td&gt;{lead.source}&lt;/td&gt;
                    &lt;td&gt;{lead.estimatedValue ? `$${lead.estimatedValue}` : '—'}&lt;/td&gt;
                  &lt;/tr&gt;
                ))}
              &lt;/tbody&gt;
            &lt;/table&gt;
          &lt;/div&gt;
        )
      })}
    &lt;/div&gt;
  )
}
</hick:file>
</hick:when>

<hick:when test="sops">
<hick:file path="web/src/pages/sops/SOPListPage.tsx">import { useState, useEffect } from 'react'
import { Link } from 'react-router-dom'
import { apiGet } from '../../api/client'
import type { Procedure } from '../../types/procedure'

export function SOPListPage() {
  const [procedures, setProcedures] = useState&lt;Procedure[]&gt;([])
  const [loading, setLoading] = useState(true)

  useEffect(() =&gt; {
    apiGet&lt;Procedure[]&gt;('/sops')
      .then(setProcedures)
      .finally(() =&gt; setLoading(false))
  }, [])

  if (loading) return &lt;p&gt;Loading procedures...&lt;/p&gt;

  const grouped = procedures.reduce&lt;Record&lt;string, Procedure[]&gt;&gt;((acc, p) =&gt; {
    ;(acc[p.category] ??= []).push(p)
    return acc
  }, {})

  return (
    &lt;div&gt;
      &lt;h1&gt;Standard Operating Procedures&lt;/h1&gt;
      {Object.keys(grouped).sort().map((cat) =&gt; (
        &lt;div key={cat} style={{ marginBottom: '1.5rem' }}&gt;
          &lt;h2&gt;{cat.replace(/_/g, ' ')}&lt;/h2&gt;
          &lt;table&gt;
            &lt;thead&gt;&lt;tr&gt;&lt;th&gt;Title&lt;/th&gt;&lt;th&gt;Version&lt;/th&gt;&lt;th&gt;Duration&lt;/th&gt;&lt;/tr&gt;&lt;/thead&gt;
            &lt;tbody&gt;
              {grouped[cat].map((proc) =&gt; (
                &lt;tr key={proc.id}&gt;
                  &lt;td&gt;&lt;Link to={`/sops/${proc.id}`}&gt;{proc.title}&lt;/Link&gt;&lt;/td&gt;
                  &lt;td&gt;v{proc.version}&lt;/td&gt;
                  &lt;td&gt;{proc.estimatedDurationMinutes ? `~${proc.estimatedDurationMinutes} min` : '—'}&lt;/td&gt;
                &lt;/tr&gt;
              ))}
            &lt;/tbody&gt;
          &lt;/table&gt;
        &lt;/div&gt;
      ))}
    &lt;/div&gt;
  )
}
</hick:file>

<hick:file path="web/src/pages/sops/SOPDetailPage.tsx">import { useState, useEffect } from 'react'
import { useParams } from 'react-router-dom'
import { apiGet } from '../../api/client'
import type { ProcedureWithSteps } from '../../types/procedure'

export function SOPDetailPage() {
  const { sopId } = useParams()
  const [procedure, setProcedure] = useState&lt;ProcedureWithSteps | null&gt;(null)

  useEffect(() =&gt; {
    if (!sopId) return
    apiGet&lt;ProcedureWithSteps&gt;(`/sops/${sopId}`).then(setProcedure).catch(() =&gt; {})
  }, [sopId])

  if (!procedure) return &lt;p&gt;Loading...&lt;/p&gt;

  return (
    &lt;div&gt;
      &lt;h1&gt;{procedure.title}&lt;/h1&gt;
      {procedure.description &amp;&amp; &lt;p&gt;{procedure.description}&lt;/p&gt;}
      {procedure.safetyNotes &amp;&amp; (
        &lt;div style={{ padding: '0.75rem', background: 'rgba(249, 115, 22, 0.1)', borderRadius: 6 }}&gt;
          Safety: {procedure.safetyNotes}
        &lt;/div&gt;
      )}
      &lt;h2&gt;Steps&lt;/h2&gt;
      &lt;ol&gt;
        {procedure.steps.map((step) =&gt; (
          &lt;li key={step.id} style={{ marginBottom: '0.5rem' }}&gt;
            {step.instruction}
            {step.isCheckpoint &amp;&amp; &lt;span className="badge badge-orange"&gt; Checkpoint&lt;/span&gt;}
            {step.notes &amp;&amp; &lt;div style={{ fontSize: '0.85rem', color: '#888' }}&gt;{step.notes}&lt;/div&gt;}
          &lt;/li&gt;
        ))}
      &lt;/ol&gt;
    &lt;/div&gt;
  )
}
</hick:file>
</hick:when>

</hick:when>
</hick:doc>
