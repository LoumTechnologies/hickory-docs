### Application Entry

<hick:file path="web/src/main.tsx">import { StrictMode } from 'react'
import { createRoot } from 'react-dom/client'
import { BrowserRouter } from 'react-router-dom'
import './index.css'
import App from './App.tsx'

createRoot(document.getElementById('root')!).render(
  &lt;StrictMode&gt;
    &lt;BrowserRouter&gt;
      &lt;App /&gt;
    &lt;/BrowserRouter&gt;
  &lt;/StrictMode&gt;,
)
</hick:file>

<hick:file path="web/src/App.tsx">import { Routes, Route, NavLink } from 'react-router-dom'
import './App.css'
<hick:when test="jobs">import { JobListPage } from './pages/jobs/JobListPage'
import { JobDetailPage } from './pages/jobs/JobDetailPage'
</hick:when>
<hick:when test="customers">import { CustomerListPage } from './pages/customers/CustomerListPage'
import { CustomerDetailPage } from './pages/customers/CustomerDetailPage'
</hick:when>
<hick:when test="crew">import { CrewListPage } from './pages/crew/CrewListPage'
</hick:when>
<hick:when test="payments">import { PaymentFormPage } from './pages/payments/PaymentFormPage'
</hick:when>
<hick:when test="inventory">import { InventoryListPage } from './pages/inventory/InventoryListPage'
</hick:when>
<hick:when test="fleet">import { FleetListPage } from './pages/fleet/FleetListPage'
</hick:when>
<hick:when test="overhead">import { OverheadPage } from './pages/overhead/OverheadPage'
</hick:when>
<hick:when test="estimating">import { EstimateFormPage } from './pages/estimating/EstimateFormPage'
</hick:when>
<hick:when test="crm">import { LeadPipelinePage } from './pages/crm/LeadPipelinePage'
</hick:when>
<hick:when test="sops">import { SOPListPage } from './pages/sops/SOPListPage'
import { SOPDetailPage } from './pages/sops/SOPDetailPage'
</hick:when>

function App() {
  return (
    &lt;div className="app-layout"&gt;
      &lt;nav className="sidebar"&gt;
        &lt;h2&gt;<hick:val name="project_name" />&lt;/h2&gt;
        &lt;ul&gt;
<hick:when test="jobs">          &lt;li&gt;&lt;NavLink to="/jobs"&gt;Jobs&lt;/NavLink&gt;&lt;/li&gt;
</hick:when>
<hick:when test="customers">          &lt;li&gt;&lt;NavLink to="/customers"&gt;Customers&lt;/NavLink&gt;&lt;/li&gt;
</hick:when>
<hick:when test="crew">          &lt;li&gt;&lt;NavLink to="/crew"&gt;Crew&lt;/NavLink&gt;&lt;/li&gt;
</hick:when>
<hick:when test="payments">          &lt;li&gt;&lt;NavLink to="/payments"&gt;Payments&lt;/NavLink&gt;&lt;/li&gt;
</hick:when>
<hick:when test="inventory">          &lt;li&gt;&lt;NavLink to="/inventory"&gt;Inventory&lt;/NavLink&gt;&lt;/li&gt;
</hick:when>
<hick:when test="fleet">          &lt;li&gt;&lt;NavLink to="/fleet"&gt;Fleet&lt;/NavLink&gt;&lt;/li&gt;
</hick:when>
<hick:when test="overhead">          &lt;li&gt;&lt;NavLink to="/overhead"&gt;Overhead&lt;/NavLink&gt;&lt;/li&gt;
</hick:when>
<hick:when test="estimating">          &lt;li&gt;&lt;NavLink to="/estimating"&gt;Estimating&lt;/NavLink&gt;&lt;/li&gt;
</hick:when>
<hick:when test="crm">          &lt;li&gt;&lt;NavLink to="/crm"&gt;CRM&lt;/NavLink&gt;&lt;/li&gt;
</hick:when>
<hick:when test="sops">          &lt;li&gt;&lt;NavLink to="/sops"&gt;SOPs&lt;/NavLink&gt;&lt;/li&gt;
</hick:when>
        &lt;/ul&gt;
      &lt;/nav&gt;
      &lt;main className="main-content"&gt;
        &lt;Routes&gt;
          &lt;Route path="/" element={&lt;h1&gt;Welcome to <hick:val name="project_name" />&lt;/h1&gt;} /&gt;
<hick:when test="jobs">          &lt;Route path="/jobs" element={&lt;JobListPage /&gt;} /&gt;
          &lt;Route path="/jobs/:jobId" element={&lt;JobDetailPage /&gt;} /&gt;
</hick:when>
<hick:when test="customers">          &lt;Route path="/customers" element={&lt;CustomerListPage /&gt;} /&gt;
          &lt;Route path="/customers/:customerId" element={&lt;CustomerDetailPage /&gt;} /&gt;
</hick:when>
<hick:when test="crew">          &lt;Route path="/crew" element={&lt;CrewListPage /&gt;} /&gt;
</hick:when>
<hick:when test="payments">          &lt;Route path="/payments" element={&lt;PaymentFormPage /&gt;} /&gt;
</hick:when>
<hick:when test="inventory">          &lt;Route path="/inventory" element={&lt;InventoryListPage /&gt;} /&gt;
</hick:when>
<hick:when test="fleet">          &lt;Route path="/fleet" element={&lt;FleetListPage /&gt;} /&gt;
</hick:when>
<hick:when test="overhead">          &lt;Route path="/overhead" element={&lt;OverheadPage /&gt;} /&gt;
</hick:when>
<hick:when test="estimating">          &lt;Route path="/estimating" element={&lt;EstimateFormPage /&gt;} /&gt;
</hick:when>
<hick:when test="crm">          &lt;Route path="/crm" element={&lt;LeadPipelinePage /&gt;} /&gt;
</hick:when>
<hick:when test="sops">          &lt;Route path="/sops" element={&lt;SOPListPage /&gt;} /&gt;
          &lt;Route path="/sops/:sopId" element={&lt;SOPDetailPage /&gt;} /&gt;
</hick:when>
        &lt;/Routes&gt;
      &lt;/main&gt;
    &lt;/div&gt;
  )
}

export default App
</hick:file>

