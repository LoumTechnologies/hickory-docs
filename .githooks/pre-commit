#!/usr/bin/env bash
# Runs exactly the checks scripts/affected-checks.sh selects for this diff —
# never more, never less than what CI runs for the same diff (see
# .instructions/pre-commit-ci-parity.md). Installed by `just dev` via
# `git config core.hooksPath .githooks`.
set -euo pipefail
cd "$(git rev-parse --show-toplevel)"

base=$(git merge-base HEAD master 2>/dev/null || echo HEAD)
checks=()
selected=$(scripts/affected-checks.sh "$base")
while IFS= read -r check; do
  [ -n "$check" ] && checks+=("$check")
done <<<"$selected"

if [ "${#checks[@]}" -eq 0 ]; then
  echo "pre-commit: no path in this diff requires a check."
  exit 0
fi

echo "pre-commit: running ${checks[*]} (see scripts/affected-checks.sh)"

status=0
for check in "${checks[@]}"; do
  case "$check" in
    rust)
      cargo fmt --all -- --check || status=1
      cargo clippy --workspace --all-targets -- -D warnings || status=1
      # The same script CI runs. A generated file that drifts from its source
      # is the bug class this repository has shipped most often.
      scripts/check-codegen.sh || status=1
      scripts/check-file-length.sh || status=1
      ;;
    web)
      (cd apps/web && npm test && npm run build) || status=1
      just install-test-browsers || status=1
      just test-browser-embedding || status=1
      scripts/check-file-length.sh || status=1
      ;;
    desktop)
      # Build the UI it embeds, just as the desktop CI job does.
      npm --prefix apps/web run build || status=1
      # The desktop crate lives outside the workspace, so it gets its own
      # fmt/clippy/check; bash -n catches the class of shell bug that broke
      # two releases (macOS ships bash 3.2 — syntax-check what runs there).
      (cd apps/desktop/src-tauri \
        && cargo fmt --all -- --check \
        && cargo clippy --all-targets -- -D warnings) || status=1
      for script in scripts/dist.sh scripts/dist-desktop.sh scripts/install.sh; do
        bash -n "$script" || status=1
      done
      ;;
    dev)
      # Runs the seed against a throwaway directory — never your own .dev/.
      scripts/check-dev-seed.sh || status=1
      ;;
    *)
      echo "pre-commit: unknown check '$check' from affected-checks.sh" >&2
      status=1
      ;;
  esac
done

# CI's FSKit job runs for both Rust and desktop changes, once per diff.
if [[ " ${checks[*]} " == *" rust "* || " ${checks[*]} " == *" desktop "* ]]; then
  if [ "$(uname -s)" = Darwin ] && [ "$(sw_vers -productVersion | cut -d. -f1)" -ge 26 ]; then
    just build-fskit || status=1
    just test-workspace-fs || status=1
  fi
fi

if [ "$status" -ne 0 ]; then
  echo
  echo "pre-commit failed. Fix the issues above, or run the individual checks yourself to reproduce."
fi
exit "$status"
