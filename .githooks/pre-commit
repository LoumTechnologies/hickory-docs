#!/usr/bin/env bash
# Runs exactly the checks scripts/affected-checks.sh selects for this diff —
# never more, never less than what CI runs for the same diff (see
# .instructions/pre-commit-ci-parity.md). Installed by `just dev` via
# `git config core.hooksPath .githooks`.
set -euo pipefail
cd "$(git rev-parse --show-toplevel)"

base=$(git merge-base HEAD master 2>/dev/null || echo HEAD)
checks=()
while IFS= read -r check; do
  [ -n "$check" ] && checks+=("$check")
done < <(scripts/affected-checks.sh "$base")

if [ "${#checks[@]}" -eq 0 ]; then
  echo "pre-commit: no path in this diff requires a check."
  exit 0
fi

echo "pre-commit: running ${checks[*]} (see scripts/affected-checks.sh)"

status=0
for check in "${checks[@]}"; do
  case "$check" in
    rust)
      cargo fmt --all -- --check || status=1
      cargo clippy --workspace --all-targets -- -D warnings || status=1
      # The same script CI runs. A generated file that drifts from its source
      # is the bug class this repository has shipped most often.
      scripts/check-codegen.sh || status=1
      scripts/check-file-length.sh || status=1
      ;;
    web)
      (cd apps/web && npm test && npm run build) || status=1
      scripts/check-file-length.sh || status=1
      ;;
    desktop)
      # The desktop crate lives outside the workspace, so it gets its own
      # fmt/clippy/check; bash -n catches the class of shell bug that broke
      # two releases (macOS ships bash 3.2 — syntax-check what runs there).
      (cd apps/desktop/src-tauri \
        && cargo fmt --all -- --check \
        && cargo clippy --all-targets -- -D warnings) || status=1
      for script in scripts/dist.sh scripts/dist-desktop.sh scripts/install.sh; do
        bash -n "$script" || status=1
      done
      ;;
    dev)
      # Runs the seed against a throwaway directory — never your own .dev/.
      scripts/check-dev-seed.sh || status=1
      ;;
    *)
      echo "pre-commit: unknown check '$check' from affected-checks.sh" >&2
      status=1
      ;;
  esac
done

if [ "$status" -ne 0 ]; then
  echo
  echo "pre-commit failed. Fix the issues above, or run the individual checks yourself to reproduce."
fi
exit "$status"

### HICKORY ###
# Managed by `hick init` — do not edit inside this block.
# Re-run `hick init` to refresh it.
hick_docs=$(git ls-files -- '*.hick')
if [ -n "$hick_docs" ]; then
    if command -v hick >/dev/null 2>&1; then
        # Continuity's repair: an unwatched edit leaves its correspondence
        # behind before it is committed. Does nothing unless continuity is on
        # for this project, and NEVER blocks a commit — the check is the
        # repair, and a rule with no escape hatch gets this hook disabled
        # entirely, taking the drift gate below down with it.
        hick repair || true
        if ! hick lint $hick_docs; then
            echo "pre-commit: \`hick lint\` found invalid hick element attributes. Fix the marked spelling before committing. Commit blocked." >&2
            exit 1
        fi
        hick_worst=0
        for hick_doc in $hick_docs; do
            hick_code=0
            hick test "$hick_doc" || hick_code=$?
            if [ "$hick_code" -gt "$hick_worst" ]; then
                hick_worst=$hick_code
            fi
        done
        case "$hick_worst" in
            0) ;;
            1) echo "pre-commit: \`hick test\` found DRIFT (exit 1) — a committed output is out of date with what the document produces. Re-run \`hick run <doc>\` (or \`hick refresh <doc>\` for a stale hick:transform) and commit the result. Commit blocked." >&2
               exit 1 ;;
            2) echo "pre-commit: \`hick test\` could NOT VERIFY (exit 2) — a cell has no baseline, so nothing was actually checked. Record one by running \`hick run <doc>\` — a cell declaring freeze=true runs once and records itself — or stop freezing that cell. Commit blocked." >&2
               exit 1 ;;
            3) echo "pre-commit: \`hick test\` found a FAILED EXPECTATION (exit 3) — a hick:expect did not hold, so the document claims something untrue of its own output. Do not regenerate this away: decide whether the claim or the code is wrong. Commit blocked." >&2
               exit 1 ;;
            *) echo "pre-commit: \`hick test\` exited $hick_worst — see the output above. Commit blocked." >&2
               exit 1 ;;
        esac
    else
        echo "pre-commit: hick not found on PATH; skipping .hick verification" >&2
    fi
fi
### END HICKORY ###
