# Wrist Flick — copy to .env and fill in API key
WRIST_FLICK_API_PORT=3000
WRIST_FLICK_WEB_PORT=5173

# LLM provider: "anthropic" or "openai"
WRIST_FLICK_LLM=anthropic
WRIST_FLICK_MODEL=claude-sonnet-4-5-20250929

# API keys (set the one matching your LLM provider)
ANTHROPIC_API_KEY=
OPENAI_API_KEY=
