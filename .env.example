# Copy to .env (gitignored) and adjust. Canonical names are documented in
# docs/operators/ENVIRONMENTS.md — the same names apply in every environment.

APP_ENV=dev

# --- Port Zero -------------------------------------------------------------
# `just dev` lets each service take whatever free port it can get, and the
# portzero daemon publishes it at a stable name. Nothing below needs to agree
# on a port number, and two checkouts can run at once.
#
#   http://hickory.portzero.local        web (Vite)
#   http://api.hickory.portzero.local    hickory-server
#   db.hickory.portzero.local:5432       Postgres
#
# One knob renames all three. A git worktree that wants its own parallel
# stack sets this to something else — and must point DATABASE_URL at the
# matching db.<namespace>.portzero.local host.
PZ_NAMESPACE=hickory

# 0 = kernel picks. Set a real number only to pin the server to a known port.
PORT=0
# Postgres is the exception: it keeps a fixed published port because CI has no
# Postgres service and the integration tests bootstrap one via docker compose
# and reach it at localhost:5433. It gets a tunnel name as well.
POSTGRES_PORT=5433
DATABASE_URL=postgres://hickory:hickory@db.hickory.portzero.local:5432/hickory
JWT_SECRET=dev-only-secret-change-me
GIT_DATA_DIR=./data/git
# local  — cells run against the host toolchain; image= is IGNORED
# docker — the declared image IS the environment (needs a reachable daemon)
HICKORY_EXECUTOR=docker
#DOCKER_HOST=tcp://dockerd:2375   # when the daemon is not on the local socket
#HICKORY_DOCKER_NETWORK=none      # none | bridge — containers are offline by default
#HICKORY_DOCKER_MEMORY=512m
#HICKORY_DOCKER_CPUS=1.0
#HICKORY_DOCKER_PIDS=256
# 0 = let Vite choose (it increments past anything already bound). Vite has no
# port-0 support, so unlike PORT this is not a kernel-assigned port — but the
# effect is the same: nothing to coordinate, and Port Zero publishes whatever
# it lands on at http://<PZ_NAMESPACE>.portzero.local
WEB_PORT=0
APP_BASE_URL=http://hickory.portzero.local

# Who may create an account. Unset = anyone. Comma-separated exact addresses
# and/or whole domains (@example.com). There is no email verification yet, so
# on any public deployment this is the only thing standing between open signup
# and strangers running containers on your bill.
#SIGNUP_ALLOWLIST=you@example.com,@yourcompany.com

# Transactional email (SendGrid). Unset = verification and password reset are
# disabled, and the execution gate is a no-op — one unset variable must not
# make the product unusable. MAIL_FROM must be an address verified as a sender
# identity in your SendGrid account, or every send is rejected; setting the key
# without it is a startup error rather than a silent no-deliver.
#SENDGRID_API_KEY=SG....
#MAIL_FROM=noreply@yourdomain.com
#MAIL_FROM_NAME=Hickory Docs
# Point the client at a gateway or a local capture server. Without this the
# only way to exercise the real client is to send real mail.
#SENDGRID_BASE_URL=http://127.0.0.1:8799/v3/mail/send

# Optional integrations (feature no-ops when unset in dev):
#STRIPE_SECRET_KEY=sk_test_...
#STRIPE_WEBHOOK_SECRET=whsec_...
#POSTHOG_API_KEY=phc_...
#POSTHOG_HOST=https://us.i.posthog.com
#PLAN_SET=default

# Agent (feature no-op when unset). Set the key for whichever provider you
# select; HICKORY_LLM_PROVIDER decides WHICH key variable is read, so the
# server answers 503 naming the exact variable that is missing.
#HICKORY_LLM_PROVIDER=anthropic     # anthropic (default) | openai | deepseek | grok
#HICKORY_LLM_MODEL=                 # optional; defaults to the provider's model
#ANTHROPIC_API_KEY=sk-ant-...
#OPENAI_API_KEY=sk-...
#DEEPSEEK_API_KEY=sk-...
#XAI_API_KEY=xai-...
# Point the agent at a different Messages endpoint — an enterprise gateway, a
# proxy, or a local harness. Defaults to https://api.anthropic.com/v1/messages;
# count_tokens follows the same host.
#ANTHROPIC_BASE_URL=http://localhost:8791/v1/messages

# Canopy executor (once hickory-executor-canopy lands):
#CANOPY_URL=https://...
#CANOPY_TOKEN=...
#CANOPY_NODE=colo-1
#CANOPY_IMAGE_MAP={"python:3.12":"/nix/store/..."}
