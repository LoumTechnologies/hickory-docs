# Copy to .env (gitignored) and adjust. Canonical names are documented in
# docs/operators/ENVIRONMENTS.md — the same names apply in every environment.

APP_ENV=dev
PORT=8080
POSTGRES_PORT=5433
DATABASE_URL=postgres://hickory:hickory@localhost:5433/hickory
JWT_SECRET=dev-only-secret-change-me
GIT_DATA_DIR=./data/git
# local  — cells run against the host toolchain; image= is IGNORED
# docker — the declared image IS the environment (needs a reachable daemon)
HICKORY_EXECUTOR=docker
#DOCKER_HOST=tcp://dockerd:2375   # when the daemon is not on the local socket
#HICKORY_DOCKER_NETWORK=none      # none | bridge — containers are offline by default
#HICKORY_DOCKER_MEMORY=512m
#HICKORY_DOCKER_CPUS=1.0
#HICKORY_DOCKER_PIDS=256
WEB_PORT=5173
APP_BASE_URL=http://localhost:5173

# Optional integrations (feature no-ops when unset in dev):
#STRIPE_SECRET_KEY=sk_test_...
#STRIPE_WEBHOOK_SECRET=whsec_...
#POSTHOG_API_KEY=phc_...
#POSTHOG_HOST=https://us.i.posthog.com
#PLAN_SET=default

# Agent (feature no-op when unset). Set the key for whichever provider you
# select; HICKORY_LLM_PROVIDER decides WHICH key variable is read, so the
# server answers 503 naming the exact variable that is missing.
#HICKORY_LLM_PROVIDER=anthropic     # anthropic (default) | openai | deepseek | grok
#HICKORY_LLM_MODEL=                 # optional; defaults to the provider's model
#ANTHROPIC_API_KEY=sk-ant-...
#OPENAI_API_KEY=sk-...
#DEEPSEEK_API_KEY=sk-...
#XAI_API_KEY=xai-...
# Point the agent at a different Messages endpoint — an enterprise gateway, a
# proxy, or a local harness. Defaults to https://api.anthropic.com/v1/messages;
# count_tokens follows the same host.
#ANTHROPIC_BASE_URL=http://localhost:8791/v1/messages

# Canopy executor (once hickory-executor-canopy lands):
#CANOPY_URL=https://...
#CANOPY_TOKEN=...
#CANOPY_NODE=colo-1
#CANOPY_IMAGE_MAP={"python:3.12":"/nix/store/..."}
