83e1|<?xml version="1.0" encoding="UTF-8"?>
9117|<hick:doc xmlns:hick="http://www.hickorydocs.com/1.0" weave="implementation.md">
e32e|# Todo app — implementation
f011|
d031|<hick:upstream file="requirements.hick" />
f011|
6e53|The code lives here, in prose order, and is tangled into `todo.py`. The cells
9443|at the bottom run the real CLI and pin its output, so this document is both
bab5|the source and the acceptance test: `hickory check` fails if the code stops
a15c|satisfying the requirements it was written from.
f011|
5a3e|## Requirements being implemented
f011|
4d16|<hick:paste select="#r-add,#r-list,#r-done,#r-storage,#r-rename" />
f011|
5d42|<hick:container name="app" image="host" />
f011|
4db9|## Storage
f011|
6ec5|<hick:copy id="c-storage" class="todo-py">
7e1c|"""A todo list. Tangled from docs/todo-app/implementation.hick — edit the
0536|document, not this file."""
b5f4|import json
d6f0|import os
be1b|import secrets
3beb|import sys
f011|
a7c5|PATH = os.environ.get("TODO_FILE", "tasks.json")
2328|STATES = ("open", "done", "dropped")
f011|
f011|
f92a|def load():
4ec1|    """A missing file reads as an empty list — first run behaves like any."""
fc73|    if not os.path.exists(PATH):
4ebf|        return []
849b|    with open(PATH) as fh:
cd9d|        return json.load(fh)
f011|
f011|
9579|def save(tasks):
d752|    with open(PATH, "w") as fh:
7ad7|        json.dump(tasks, fh, indent=2)
ae0e|</hick:copy>
f011|
09d2|## Commands
f011|
a66d|<hick:copy id="c-commands" class="todo-py">
f011|
f011|
32a1|def add(title):
2998|    """Ids are opaque and assigned at creation, never derived from the title."""
fd12|    tasks = load()
7cfc|    task = {"id": secrets.token_hex(3), "title": title, "state": "open"}
b8a3|    tasks.append(task)
f682|    save(tasks)
46cf|    return task["id"]
f011|
f011|
3c64|def transition(task_id, state):
43c2|    """Idempotent: re-running on a task already in that state changes nothing,
a110|    so a retried command is never an error."""
fd12|    tasks = load()
36af|    for task in tasks:
4c43|        if task["id"] == task_id:
e853|            task["state"] = state
282e|            save(tasks)
b9d5|            return True
4314|    return False
f011|
f011|
0531|def render(tasks):
4d69|    return "".join(f"{t['id']} {t['state']} {t['title']}\n" for t in tasks)
f011|
f011|
c68f|def rename(task_id, new_title):
d2c1|    """Renaming leaves id and state untouched, so anything referencing this
80d7|    task survives a retitle."""
fd12|    tasks = load()
36af|    for task in tasks:
4c43|        if task["id"] == task_id:
f617|            task["title"] = new_title
282e|            save(tasks)
b9d5|            return True
4314|    return False
ae0e|</hick:copy>
f011|
4322|## Entry point
f011|
d1eb|<hick:copy id="c-main" class="todo-py">
f011|
f011|
3cf3|def main(argv):
0223|    if not argv:
94f4|        print("usage: todo add|list|done|drop", file=sys.stderr)
a46a|        return 2
8356|    cmd, rest = argv[0], argv[1:]
5268|    if cmd == "add":
92e6|        print(add(rest[0]))
a100|        return 0
d9b0|    if cmd == "list":
7177|        tasks = load()
70b7|        if len(rest) == 2 and rest[0] == "--state":
93ab|            tasks = [t for t in tasks if t["state"] == rest[1]]
997a|        sys.stdout.write(render(tasks))
a100|        return 0
07bb|    if cmd in ("done", "drop"):
5112|        state = "done" if cmd == "done" else "dropped"
af61|        if not transition(rest[0], state):
e58e|            print(f"no such task: {rest[0]}", file=sys.stderr)
37be|            return 1
a100|        return 0
af7d|    if cmd == "rename":
e1e4|        if not rename(rest[0], rest[1]):
e58e|            print(f"no such task: {rest[0]}", file=sys.stderr)
37be|            return 1
a100|        return 0
fb51|    print(f"unknown command: {cmd}", file=sys.stderr)
3d1f|    return 2
f011|
f011|
6397|if __name__ == "__main__":
5341|    sys.exit(main(sys.argv[1:]))
ae0e|</hick:copy>
f011|
ecfd|<hick:file path="todo.py">
6ae6|<hick:paste select=".todo-py" />
d718|</hick:file>
f011|
a3b6|## Acceptance
f011|
5094|These cells run the real CLI. Ids are opaque and random, so the tests set
00c0|titles and filter on state rather than pinning ids — pinning a random id
0a21|would make the document fail on every run for no reason.
f011|
1de7|<hick:volume name="src" input="." />
f011|
dbe4|<hick:exec container="app" mount="src:/project">
76b1|cd project && rm -f /tmp/todo-acceptance.json && export TODO_FILE=/tmp/todo-acceptance.json
c04a|python3 todo.py list
c788|echo "--- empty file reads as empty list, no error: $?"
b168|<hick:expect match="exact">--- empty file reads as empty list, no error: 0
1cc3|</hick:expect>
32f2|</hick:exec>
f011|
dbe4|<hick:exec container="app" mount="src:/project">
96df|cd project && export TODO_FILE=/tmp/todo-acceptance.json
ba84|python3 todo.py add "write the spec" > /dev/null
70db|python3 todo.py add "ship it" > /dev/null
198c|python3 todo.py add "abandon this one" > /dev/null
3862|python3 todo.py list | awk '{$1=""; print substr($0,2)}'
823e|<hick:expect match="exact">open write the spec
5378|open ship it
92f8|open abandon this one
1cc3|</hick:expect>
32f2|</hick:exec>
f011|
dbe4|<hick:exec container="app" mount="src:/project">
96df|cd project && export TODO_FILE=/tmp/todo-acceptance.json
a849|first=$(python3 todo.py list | head -1 | cut -d' ' -f1)
6872|last=$(python3 todo.py list | tail -1 | cut -d' ' -f1)
a7d5|python3 todo.py done "$first"
1c94|python3 todo.py done "$first"   # idempotent: a retry is never an error
f0d8|python3 todo.py drop "$last"
3862|python3 todo.py list | awk '{$1=""; print substr($0,2)}'
ed0f|<hick:expect match="exact">done write the spec
5378|open ship it
9c38|dropped abandon this one
1cc3|</hick:expect>
32f2|</hick:exec>
f011|
dbe4|<hick:exec container="app" mount="src:/project">
96df|cd project && export TODO_FILE=/tmp/todo-acceptance.json
db70|python3 todo.py list --state open | awk '{$1=""; print substr($0,2)}'
8626|echo "--- unknown id exits nonzero:"
4196|python3 todo.py done nosuchid 2>/dev/null || echo "yes"
573a|<hick:expect match="exact">open ship it
706e|--- unknown id exits nonzero:
0137|yes
1cc3|</hick:expect>
32f2|</hick:exec>
f011|
dbe4|<hick:exec container="app" mount="src:/project">
96df|cd project && export TODO_FILE=/tmp/todo-acceptance.json
774e|id=$(python3 todo.py list --state open | head -1 | cut -d' ' -f1)
7c36|python3 todo.py rename "$id" "ship it today"
db70|python3 todo.py list --state open | awk '{$1=""; print substr($0,2)}'
73aa|echo "--- id survived the retitle:"
255a|python3 todo.py list --state open | head -1 | cut -d' ' -f1 | grep -qx "$id" && echo "yes"
8626|echo "--- unknown id exits nonzero:"
4511|python3 todo.py rename nosuchid "x" 2>/dev/null || echo "yes"
9650|<hick:expect match="exact">open ship it today
f131|--- id survived the retitle:
0137|yes
706e|--- unknown id exits nonzero:
0137|yes
1cc3|</hick:expect>
32f2|</hick:exec>
