def rename(task_id, new_title):
    """Renaming leaves id and state untouched, so anything referencing this
    task survives a retitle."""
    tasks = load()
    for task in tasks:
        if task["id"] == task_id:
            task["title"] = new_title
            save(tasks)
            return True
    return False
